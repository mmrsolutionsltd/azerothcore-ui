+namespace
+{
+bool IsControlledDungeonCompanion(PlayerbotAI* botAI)
+{
+    Player* bot = botAI ? botAI->GetBot() : nullptr;
+    return bot && botAI->HasActivePlayerMaster() && bot->GetMap()
+        && bot->GetMap()->IsDungeon();
+}
+
+void NotifyPartyOfUsefulSkippedLoot(
+    PlayerbotAI* botAI, ObjectGuid sourceGuid, ItemTemplate const* proto)
+{
+    Player* bot = botAI ? botAI->GetBot() : nullptr;
+    Group* group = bot ? bot->GetGroup() : nullptr;
+    if (!bot || !group || !proto
+        || (proto->Class != ITEM_CLASS_WEAPON
+            && proto->Class != ITEM_CLASS_ARMOR))
+        return;
+
+    Player* usefulFor = nullptr;
+    for (GroupReference* reference = group->GetFirstMember(); reference;
+         reference = reference->next())
+    {
+        Player* member = reference->GetSource();
+        if (member && member != bot
+            && member->BotCanUseItem(proto) == EQUIP_ERR_OK)
+        {
+            usefulFor = member;
+            break;
+        }
+    }
+    if (!usefulFor)
+        return;
+
+    static std::map<std::string, time_t> notifications;
+    time_t now = time(nullptr);
+    std::string key = bot->GetGUID().ToString() + ":"
+        + sourceGuid.ToString() + ":" + std::to_string(proto->ItemId);
+    auto existing = notifications.find(key);
+    if (existing != notifications.end() && now - existing->second < 300)
+        return;
+    notifications[key] = now;
+
+    botAI->SayToParty("I left " + ChatHelper::FormatItem(proto) + "; "
+        + usefulFor->GetName() + " can use it.");
+}
+}
