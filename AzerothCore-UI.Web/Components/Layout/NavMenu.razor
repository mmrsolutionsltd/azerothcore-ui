@inject NavigationManager Navigation
@implements IDisposable

<div class="game-menu-host">
    <input id="game-menu-toggle" type="checkbox" class="game-menu-toggle" @bind="menuOpen" />
    <label for="game-menu-toggle" class="game-menu-button" title="Open the game menu">
        <span aria-hidden="true">☰</span><strong>Menu</strong>
    </label>
    <label for="game-menu-toggle" class="game-menu-backdrop" aria-label="Close game menu"></label>

    <aside class="nav-scrollable" aria-label="Game menu">
        <header class="drawer-heading">
            <div class="brand-block">
                <a class="navbar-brand" href="">AzerothCore Admin</a>
                <AuthorizeView Policy="PasswordChange">
                    <Authorized Context="signedIn">
                        <div class="signed-in-user">@signedIn.User.Identity?.Name</div>
                    </Authorized>
                </AuthorizeView>
            </div>
            <label for="game-menu-toggle" class="drawer-close" title="Close game menu">×</label>
        </header>
    <nav class="nav flex-column" aria-label="Main navigation">
        <div class="quick-links" aria-label="Quick links">
            <NavItem Href="characters" Policy="players.characters" Icon="bi-person-fill-nav-menu">Characters</NavItem>
            <NavItem Href="server" Policy="server.control" Icon="bi-house-door-fill-nav-menu">Server</NavItem>
        </div>

        <NavGroup Title="World" GroupKey="world"
                  OpenByDefault="@IsGroupActive("auction-house")">
            <NavItem Href="auction-house" Policy="world.auction-house" Icon="bi-list-nested-nav-menu">Auction House</NavItem>
        </NavGroup>

        <NavGroup Title="Administration" GroupKey="administration"
                          OpenByDefault="@IsGroupActive("diagnostics", "database-backups", "modules", "activity-audit", "security-dashboard")">
            <NavItem Href="security-dashboard" Policy="security.audit" Icon="bi-list-nested-nav-menu">Security dashboard</NavItem>
            <NavItem Href="activity-audit" Policy="security.audit" Icon="bi-list-nested-nav-menu">Activity audit</NavItem>
            <NavItem Href="diagnostics" Policy="server.diagnostics" Icon="bi-list-nested-nav-menu">Server health</NavItem>
            <NavItem Href="database-backups" Policy="server.backups" Icon="bi-list-nested-nav-menu">Database backups</NavItem>
            <NavItem Href="modules" Policy="server.settings" Icon="bi-list-nested-nav-menu">Modules</NavItem>
        </NavGroup>

        <AuthorizeView Policy="PasswordChange">
            <Authorized>
                <NavItem Href="my-security" Icon="bi-person-fill-nav-menu">My security</NavItem>
                <NavItem Href="administration-users" Policy="security.users" Icon="bi-person-fill-nav-menu">Access management</NavItem>
                <div class="nav-item sign-out">
                    <form method="post" action="/admin/logout">
                        <AntiforgeryToken />
                        <button class="nav-link border-0 bg-transparent w-100 text-start" type="submit">
                            <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span>
                            <span class="nav-label">Sign out</span>
                        </button>
                    </form>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>
    </aside>
</div>

@code {
    private bool menuOpen;

    protected override void OnInitialized() => Navigation.LocationChanged += LocationChanged;

    private void LocationChanged(object? sender, LocationChangedEventArgs args) =>
        _ = InvokeAsync(() => { menuOpen = false; StateHasChanged(); });

    private bool IsGroupActive(params string[] paths)
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri)
            .Split('?', '#')[0]
            .Trim('/');

        return paths.Any(path =>
            relativePath.Equals(path, StringComparison.OrdinalIgnoreCase) ||
            relativePath.StartsWith($"{path}/", StringComparison.OrdinalIgnoreCase));
    }

    public void Dispose() => Navigation.LocationChanged -= LocationChanged;
}
