@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <div class="brand-block">
            <a class="navbar-brand" href="">AzerothCore Admin</a>
            <AuthorizeView Policy="PasswordChange">
                <Authorized Context="signedIn">
                    <div class="signed-in-user">@signedIn.User.Identity?.Name</div>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable">
    <nav class="nav flex-column" aria-label="Main navigation">
        <div class="quick-links" aria-label="Quick links">
            <NavItem Href="characters" Policy="players.characters" Icon="bi-person-fill-nav-menu">Characters</NavItem>
            <NavItem Href="player-actions" Policy="players.actions" Icon="bi-person-fill-nav-menu">Player actions</NavItem>
            <NavItem Href="server" Policy="server.control" Icon="bi-house-door-fill-nav-menu">Server</NavItem>
        </div>

        <NavGroup Title="Players" GroupKey="players"
                  OpenByDefault="@IsGroupActive("accounts", "character-services", "starter-presets", "collectibles")">
            <NavItem Href="accounts" Policy="players.accounts" Icon="bi-list-nested-nav-menu">Accounts</NavItem>
            <NavItem Href="character-services" Policy="players.services" Icon="bi-person-fill-nav-menu">Character services</NavItem>
            <NavItem Href="starter-presets" Policy="players.services" Icon="bi-plus-square-fill-nav-menu">Starter presets</NavItem>
            <NavItem Href="collectibles" Policy="players.collectibles" Icon="bi-plus-square-fill-nav-menu">Collectibles</NavItem>
        </NavGroup>

        <NavGroup Title="Adventures" GroupKey="adventures"
                  OpenByDefault="@IsGroupActive("quest-helper", "questing-companions", "client-addons", "dungeon-library", "dungeon-assistant", "trainers", "weapon-training", "training")">
            <NavItem Href="quest-helper" Policy="adventures.quests" Icon="bi-list-nested-nav-menu">Quest helper</NavItem>
            <NavItem Href="questing-companions" Policy="adventures.quests" Icon="bi-person-fill-nav-menu">Questing companions</NavItem>
            <NavItem Href="client-addons" Policy="adventures.quests" Icon="bi-plus-square-fill-nav-menu">Client addons</NavItem>
            <NavItem Href="dungeon-library" Policy="adventures.dungeons" Icon="bi-list-nested-nav-menu">Dungeon library</NavItem>
            <NavItem Href="dungeon-assistant" Policy="adventures.dungeons" Icon="bi-list-nested-nav-menu">Dungeon assistant</NavItem>
            <NavItem Href="trainers" Policy="adventures.training" Icon="bi-person-fill-nav-menu">Trainer finder</NavItem>
            <NavItem Href="weapon-training" Policy="adventures.training" Icon="bi-plus-square-fill-nav-menu">Weapon training</NavItem>
            <NavItem Href="training" Policy="adventures.training" Icon="bi-plus-square-fill-nav-menu">Training</NavItem>
        </NavGroup>

        <NavGroup Title="World" GroupKey="world"
                  OpenByDefault="@IsGroupActive("auction-house")">
            <NavItem Href="auction-house" Policy="world.auction-house" Icon="bi-list-nested-nav-menu">Auction House</NavItem>
        </NavGroup>

        <NavGroup Title="Administration" GroupKey="administration"
                          OpenByDefault="@IsGroupActive("diagnostics", "database-backups", "modules", "activity-audit", "security-dashboard")">
            <NavItem Href="security-dashboard" Policy="security.audit" Icon="bi-list-nested-nav-menu">Security dashboard</NavItem>
            <NavItem Href="activity-audit" Policy="security.audit" Icon="bi-list-nested-nav-menu">Activity audit</NavItem>
            <NavItem Href="diagnostics" Policy="server.diagnostics" Icon="bi-list-nested-nav-menu">Server health</NavItem>
            <NavItem Href="database-backups" Policy="server.backups" Icon="bi-list-nested-nav-menu">Database backups</NavItem>
            <NavItem Href="modules" Policy="server.settings" Icon="bi-list-nested-nav-menu">Modules</NavItem>
        </NavGroup>

        <AuthorizeView Policy="PasswordChange">
            <Authorized>
                <NavItem Href="my-security" Icon="bi-person-fill-nav-menu">My security</NavItem>
                <NavItem Href="administration-users" Policy="security.users" Icon="bi-person-fill-nav-menu">Access management</NavItem>
                <div class="nav-item sign-out">
                    <form method="post" action="/admin/logout">
                        <AntiforgeryToken />
                        <button class="nav-link border-0 bg-transparent w-100 text-start" type="submit">
                            <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span>
                            <span class="nav-label">Sign out</span>
                        </button>
                    </form>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private bool IsGroupActive(params string[] paths)
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri)
            .Split('?', '#')[0]
            .Trim('/');

        return paths.Any(path =>
            relativePath.Equals(path, StringComparison.OrdinalIgnoreCase) ||
            relativePath.StartsWith($"{path}/", StringComparison.OrdinalIgnoreCase));
    }
}
