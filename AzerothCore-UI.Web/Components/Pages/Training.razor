@page "/training"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "adventures.training")]
@rendermode InteractiveServer
@using AzerothCore_UI.Web.Models
@inject AzerothCore_UI.Web.Clients.AccountsApiClient AccountsClient

<PageTitle>Training</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
    <h1 class="mb-0">Available training</h1>
    <button class="btn btn-outline-secondary" disabled="@(isLoading || activeTraining is not null)"
            @onclick="RefreshTrainingAsync">
        @(activeTraining == "refresh" ? "Refreshing…" : "Refresh characters")
    </button>
</div>
<p class="text-muted">
    Class abilities and profession training currently available to characters on player accounts.
    Profession training can be granted free while the character is online.
</p>

@if (actionMessage is not null)
{
    <div class="alert @(actionSucceeded ? "alert-success" : "alert-danger")"
         role="@(actionSucceeded ? "status" : "alert")">@actionMessage</div>
}

@if (isLoading)
{
    <p><em>Checking characters...</em></p>
}
else if (errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}
else
{
    <section class="card mb-4">
        <div class="card-header">
            <h2 class="h5 mb-1">Learn a new profession</h2>
            <p class="small text-muted mb-0">
                Primary professions are limited to two. Cooking, First Aid, and Fishing do not use a primary slot.
            </p>
        </div>
        <div class="card-body">
            @if (professionStarters.Count == 0)
            {
                <p class="text-muted mb-0">No characters currently have an available profession.</p>
            }
            else
            {
                <div class="row g-3 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label">Character</label>
                        <CharacterPicker Items="@ProfessionStarterPickerItems" AllowBots="false"
                                         SelectedValue="@SelectedProfessionGuidValue"
                                         SelectedValueChanged="SelectProfessionCharacter" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="new-profession">Profession</label>
                        <select id="new-profession" class="form-select" @bind="selectedProfessionSkillId">
                            @foreach (var category in (SelectedProfessionCharacter?.AvailableProfessions ?? [])
                                .GroupBy(profession => profession.Category)
                                .OrderBy(group => group.Key == "Primary" ? 0 : 1))
                            {
                                <optgroup label="@($"{category.Key} professions")">
                                @foreach (var profession in category)
                                {
                                    <option value="@profession.SkillId">@profession.Name</option>
                                }
                                </optgroup>
                            }
                        </select>
                        @if (SelectedProfessionCharacter is { } selectedCharacter)
                        {
                            <div class="form-text">
                                Primary slots: @selectedCharacter.PrimaryProfessionCount/2.
                                @if (selectedCharacter.PrimaryProfessionCount >= 2)
                                {
                                    <span>Unlearn a primary profession below before choosing another.</span>
                                }
                                else
                                {
                                    <span>@(2 - selectedCharacter.PrimaryProfessionCount) primary slot(s) available.</span>
                                }
                            </div>
                        }
                        @if (SelectedNewProfession?.SuggestedPairings.Count > 0)
                        {
                            <div class="form-text">
                                Common pairing: @string.Join(", ", SelectedNewProfession.SuggestedPairings)
                            </div>
                        }
                    </div>
                    <div class="col-md-3">
                        <button class="btn btn-primary w-100"
                                type="button"
                                disabled="@(activeTraining is not null || SelectedProfessionCharacter?.Online != true ||
                                    SelectedNewProfession is null)"
                                @onclick="LearnProfessionAsync">
                            @(activeTraining == NewProfessionActionKey ? "Teaching..." : "Teach profession")
                        </button>
                    </div>
                </div>
                @if (SelectedProfessionCharacter?.Online == false)
                {
                    <div class="alert alert-warning mt-3 mb-0">
                        @SelectedProfessionCharacter.CharacterName must log in before the profession can be taught.
                    </div>
                }
                else if (SelectedProfessionCharacter is { AvailableProfessions.Count: 0 } unavailableCharacter)
                {
                    <div class="alert alert-info mt-3 mb-0">
                        @unavailableCharacter.CharacterName is online, but already knows every eligible profession
                        or already has two primary professions.
                    </div>
                }
                else if (SelectedProfessionCharacter?.PrimaryProfessionCount >= 2
                    && SelectedProfessionCharacter.AvailableProfessions.All(
                        profession => profession.Category != "Primary"))
                {
                    <div class="alert alert-info mt-3 mb-0">
                        This character already knows two primary professions, so only missing
                        secondary professions are available.
                    </div>
                }
            }
        </div>
    </section>

    <section class="card mb-4">
        <div class="card-header">
            <h2 class="h5 mb-1">Manage known professions</h2>
            <p class="small text-muted mb-0">
                Inspect skill progress or permanently unlearn a profession to free a primary slot.
            </p>
        </div>
        <div class="card-body">
            @if (professionManagement.Count == 0)
            {
                <p class="text-muted mb-0">No characters currently know a profession.</p>
            }
            else
            {
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Character</label>
                        <CharacterPicker Items="@ProfessionManagementPickerItems" AllowBots="false"
                                         SelectedValue="@SelectedManagementGuidValue"
                                         SelectedValueChanged="SelectManagementCharacter" />
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Profession</th>
                                <th>Type</th>
                                <th>Skill</th>
                                <th>Guidance</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var profession in SelectedManagementCharacter?.Professions ?? [])
                            {
                                <tr>
                                    <td class="fw-semibold">@profession.Name</td>
                                    <td>@profession.Category</td>
                                    <td>@profession.CurrentSkill / @profession.MaximumSkill</td>
                                    <td>
                                        @if (profession.SuggestedPairings.Count > 0)
                                        {
                                            <div class="small">
                                                Pairs well with @string.Join(", ", profession.SuggestedPairings)
                                            </div>
                                        }
                                        <div class="d-flex flex-wrap gap-2 mt-1">
                                            <a class="small"
                                               href="@TrainerLink(SelectedManagementCharacter!.CharacterName, profession.Name)">
                                                Find trainer
                                            </a>
                                            <a class="small"
                                               href="characters/@SelectedManagementCharacter!.CharacterGuid?tab=Professions">
                                                Recipe sources
                                            </a>
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-danger"
                                                type="button"
                                                disabled="@(activeTraining is not null || SelectedManagementCharacter?.Online != true)"
                                                @onclick="() => RequestUnlearn(profession)">
                                            Unlearn
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (pendingUnlearn is not null && SelectedManagementCharacter is not null)
                {
                    <div class="alert alert-danger mt-3 mb-0" role="alert">
                        <strong>Unlearn @pendingUnlearn.Name from @SelectedManagementCharacter.CharacterName?</strong>
                        <p class="mb-2">
                            This permanently removes its skill progress, ranks, specialisations, and learned recipes.
                        </p>
                        <div class="d-flex gap-2">
                            <button class="btn btn-danger"
                                    type="button"
                                    disabled="@(activeTraining is not null)"
                                    @onclick="ConfirmUnlearnAsync">
                                @(activeTraining == UnlearnActionKey ? "Unlearning..." : "Yes, unlearn permanently")
                            </button>
                            <button class="btn btn-outline-secondary"
                                    type="button"
                                    disabled="@(activeTraining is not null)"
                                    @onclick="CancelUnlearn">
                                Cancel
                            </button>
                        </div>
                    </div>
                }

                @if (SelectedManagementCharacter?.Online == false)
                {
                    <div class="form-text text-warning">
                        @SelectedManagementCharacter.CharacterName must log in before a profession can be unlearned.
                    </div>
                }
            }
        </div>
    </section>

    @if (characters.Count == 0)
    {
        <div class="alert alert-success" role="status">No available rank or recipe training was found.</div>
    }
    else
    {
    <div class="row g-2 align-items-end mb-4">
        <div class="col-lg-4">
            <label class="form-label" for="training-search">Account or character</label>
            <input id="training-search" class="form-control" @bind="search" @bind:event="oninput"
                   placeholder="Search by name" />
        </div>
        <div class="col-sm-4 col-lg-2">
            <label class="form-label" for="training-type">Type</label>
            <select id="training-type" class="form-select" @bind="trainingType">
                <option>All</option>
                <option>Class</option>
                <option>Profession</option>
            </select>
        </div>
        <div class="col-sm-4 col-lg-3">
            <label class="form-label" for="training-discipline">Class or profession</label>
            <select id="training-discipline" class="form-select" @bind="discipline">
                <option>All</option>
                @foreach (var item in Disciplines)
                {
                    <option value="@item">@item</option>
                }
            </select>
        </div>
        <div class="col-sm-4 col-lg-3">
            <label class="form-label" for="training-sort">Sort characters by</label>
            <select id="training-sort" class="form-select" @bind="sort">
                <option value="Character">Character</option>
                <option value="Account">Account</option>
                <option value="Level">Level, highest first</option>
                <option value="Count">Training count</option>
                <option value="Cost">Total cost</option>
                <option value="Requirement">Next level or skill requirement</option>
            </select>
        </div>
    </div>

    var filteredCharacters = FilteredCharacters;

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <p class="text-muted mb-0">
            @filteredCharacters.Count character(s) have
            @filteredCharacters.Sum(character => character.Requirements.Count) training option(s), costing
            <MoneyDisplay Copper="filteredCharacters.Aggregate(0u, (total, character) => total + TotalCost(character))" />.
        </p>
        <div class="btn-group btn-group-sm" role="group" aria-label="Training sections">
            <button class="btn btn-outline-secondary" type="button" @onclick="ExpandAll">Expand all</button>
            <button class="btn btn-outline-secondary" type="button" @onclick="CollapseAll">Collapse all</button>
        </div>
    </div>

    @if (filteredCharacters.Count == 0)
    {
        <div class="alert alert-info" role="status">No training matches the current filters.</div>
    }

    @foreach (var character in filteredCharacters)
    {
        <section class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-link text-decoration-none p-0"
                            type="button" @onclick="() => ToggleCharacter(character.CharacterGuid)"
                            aria-label="Toggle @character.CharacterName training">
                        @(collapsedCharacters.Contains(character.CharacterGuid) ? "▶" : "▼")
                    </button>
                    <a class="fw-semibold" href="characters/@character.CharacterGuid?tab=Training">@character.CharacterName</a>
                    <span class="text-muted">Level @character.CharacterLevel</span>
                    <span class="text-muted">·</span>
                    <a class="text-muted" href="accounts/@character.AccountId">@character.Username</a>
                </div>
                <div class="text-end">
                    <span class="badge text-bg-warning">@character.Requirements.Count available</span>
                    <div class="small text-muted"><MoneyDisplay Copper="TotalCost(character)" /> total</div>
                </div>
            </div>
            @if (!collapsedCharacters.Contains(character.CharacterGuid))
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Type</th>
                                <th>Training</th>
                                <th>Rank</th>
                                <th>Requirement</th>
                                <th>Cost</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var group in character.Requirements.GroupBy(requirement =>
                                $"{requirement.Category}: {requirement.Discipline}"))
                            {
                                var groupKey = DisciplineKey(character.CharacterGuid, group);
                                var firstRequirement = group.First();
                                <tr class="table-light">
                                    <th colspan="6">
                                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                            <button class="btn btn-sm btn-link text-decoration-none p-0"
                                                    type="button" @onclick="() => ToggleDiscipline(groupKey)">
                                                @(collapsedDisciplines.Contains(groupKey) ? "▶" : "▼")
                                                @group.Key (@group.Count())
                                            </button>
                                            @if (firstRequirement.Category == "Profession")
                                            {
                                                <span class="d-flex gap-3">
                                                    <a class="small fw-normal"
                                                       href="@TrainerLink(character.CharacterName, firstRequirement.Discipline)">
                                                        Find nearest trainer
                                                    </a>
                                                    <a class="small fw-normal"
                                                       href="characters/@character.CharacterGuid?tab=Professions">
                                                        Find recipe sources
                                                    </a>
                                                </span>
                                            }
                                        </div>
                                    </th>
                                </tr>
                                @if (!collapsedDisciplines.Contains(groupKey))
                                {
                                    @foreach (var requirement in group)
                                    {
                                        <tr>
                                            <td>@requirement.Category</td>
                                            <td>
                                                @(requirement.Name ?? $"Spell {requirement.SpellId}")
                                                <div class="small text-muted">Spell ID @requirement.SpellId</div>
                                            </td>
                                            <td>@(requirement.Rank ?? "—")</td>
                                            <td>@FormatRequirement(requirement)</td>
                                            <td><MoneyDisplay Copper="requirement.TrainingCost" /></td>
                                            <td class="text-end">
                                                @if (requirement.Category == "Profession")
                                                {
                                                    var actionKey = TrainingKey(character.CharacterGuid, requirement.SpellId);
                                                    <button class="btn btn-sm btn-primary"
                                                            type="button"
                                                            disabled="@(activeTraining == actionKey)"
                                                            @onclick="() => GrantProfessionTrainingAsync(character, requirement)">
                                                        @(activeTraining == actionKey ? "Teaching..." : "Teach free")
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
    }
}
