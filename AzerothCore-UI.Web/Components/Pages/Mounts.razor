@page "/mounts"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "players.actions")]
@using AzerothCore_UI.Web.Models
@inject AzerothCore_UI.Web.Clients.AccountsApiClient Api
@inject AzerothCore_UI.Web.Services.SelectedCharacterStore SelectedCharacterStore

<PageTitle>Mounts</PageTitle>

<PageHeader Eyebrow="CHARACTER SERVICES"
            Title="Give Mounts"
            Description="Browse the realm's mount catalogue and hand one or more to every selected hero at once."
            BadgeText="GRANTS ITEMS"
            BadgeSubtext="Delivery is immediate"
            Tone="PageHeaderBadgeTone.Caution" />

@if (message is not null)
{
    <div class="alert @(succeeded ? "alert-success" : "alert-danger")">@message</div>
}

<div class="card mb-4">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-lg-4">
                <input class="form-control" placeholder="Search mount name..."
                       value="@search" @oninput="SearchChangedAsync" />
            </div>
            <div class="col-6 col-lg-2">
                <input class="form-control" type="number" min="1" placeholder="Min level"
                       @bind="minimumLevel" @bind:event="oninput" @bind:after="ReloadAsync" />
            </div>
            <div class="col-6 col-lg-2">
                <input class="form-control" type="number" min="1" placeholder="Max level"
                       @bind="maximumLevel" @bind:event="oninput" @bind:after="ReloadAsync" />
            </div>
            <div class="col-6 col-lg-2">
                <select class="form-select" @bind="minimumSkillRank" @bind:after="ReloadAsync">
                    <option value="">Any riding skill</option>
                    <option value="75">Apprentice Riding+</option>
                    <option value="150">Journeyman Riding+</option>
                    <option value="225">Expert Riding+</option>
                    <option value="300">Artisan Riding</option>
                </select>
            </div>
            <div class="col-6 col-lg-2">
                <select class="form-select" @bind="faction" @bind:after="ReloadAsync">
                    <option value="">Any faction</option>
                    <option value="Alliance">Alliance</option>
                    <option value="Horde">Horde</option>
                </select>
            </div>
        </div>
    </div>
</div>

@if (isLoadingPage)
{
    <p><em>Loading the mount catalogue...</em></p>
}
else
{
    <div class="row g-4">
        <div class="col-xl-9">
            <div class="card">
                <div class="card-body">
                    @if (isSearching)
                    {
                        <p><em>Searching mounts...</em></p>
                    }
                    else if (results.Mounts.Count == 0)
                    {
                        <div class="alert alert-secondary">No matching mounts were found.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th></th><th>Name</th><th>Level</th><th>Riding skill</th>
                                        <th>Faction</th><th>Reputation</th><th>Classes</th><th>Source</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var mount in results.Mounts)
                                    {
                                        var mismatched = mount.HeroStatuses.Where(status => status.FactionMismatch).ToArray();
                                        var owned = mount.HeroStatuses.Where(status => status.Owned).ToArray();
                                        <tr class="@(IsSelected(mount) ? "table-primary" : null)">
                                            <td>
                                                <input class="form-check-input" type="checkbox"
                                                       checked="@IsSelected(mount)"
                                                       @onchange="() => ToggleMountSelection(mount)" />
                                            </td>
                                            <td class="fw-semibold">
                                                @mount.Name
                                                @if (owned.Length > 0)
                                                {
                                                    <div class="small text-success">
                                                        Known: @string.Join(", ", owned.Select(status => status.CharacterName))
                                                    </div>
                                                }
                                            </td>
                                            <td>@mount.RequiredLevel</td>
                                            <td>@RidingSkillLabel(mount.RequiredSkillRank)</td>
                                            <td>
                                                @(mount.Faction ?? "Both")
                                                @if (mismatched.Length > 0)
                                                {
                                                    <div class="small text-muted">
                                                        Opposite faction: @string.Join(", ", mismatched.Select(status => status.CharacterName))
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                @if (mount.RequiredFactionId == 0)
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                                else
                                                {
                                                    <div class="small">
                                                        @mount.RequiredFactionName · @ReputationRankLabel(mount.RequiredReputationRank)
                                                    </div>
                                                    @foreach (var status in mount.HeroStatuses)
                                                    {
                                                        <div class="small @(status.ReputationMet ? "text-success" : "text-warning")">
                                                            @(status.ReputationMet
                                                                ? $"{status.CharacterName}: ready"
                                                                : $"{status.CharacterName}: needs {status.RemainingStandingNeeded:N0} more ({status.CurrentRankName})")
                                                        </div>
                                                    }
                                                }
                                            </td>
                                            <td>@ClassRestrictionLabel(mount.AllowableClass)</td>
                                            <td class="small text-muted">@SourceLabel(mount)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>@results.TotalCount results</span>
                            <div>
                                <button class="btn btn-sm btn-outline-secondary me-2"
                                        disabled="@(results.Page <= 1)" @onclick="() => LoadAsync(results.Page - 1)">
                                    Previous
                                </button>
                                <span class="me-2">Page @results.Page of @Math.Max(1, results.TotalPages)</span>
                                <button class="btn btn-sm btn-outline-secondary"
                                        disabled="@(results.Page >= results.TotalPages)" @onclick="() => LoadAsync(results.Page + 1)">
                                    Next
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-xl-3">
            <div class="card mount-give-panel">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <h2 class="h5 mb-0">Give selected mounts</h2>
                        @if (selectedMounts.Count > 0)
                        {
                            <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="ClearMountSelection">
                                Clear
                            </button>
                        }
                    </div>
                    @if (selectedMounts.Count == 0)
                    {
                        <p class="text-muted">Select one or more mounts from the catalogue.</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush small mb-2">
                            @foreach (var mount in selectedMounts)
                            {
                                <li class="list-group-item px-0 py-1 d-flex justify-content-between align-items-center">
                                    <span>
                                        @mount.Name
                                        <span class="text-muted">
                                            (level @mount.RequiredLevel, @RidingSkillLabel(mount.RequiredSkillRank))
                                        </span>
                                    </span>
                                    <button class="btn btn-sm btn-outline-secondary" type="button"
                                            @onclick="() => ToggleMountSelection(mount)">
                                        Remove
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                    <p class="small text-muted">
                        @(targetNames.Count == 0
                            ? "No heroes are currently selected in the header."
                            : $"Will be given to {targetNames.Count} selected hero{(targetNames.Count == 1 ? "" : "es")}.")
                    </p>
                    @if (selectedMounts.Count > 0 && targetNames.Count > 0)
                    {
                        <p class="small text-muted">
                            @(selectedMounts.Count * targetNames.Count) total transfer@(selectedMounts.Count * targetNames.Count == 1 ? "" : "s").
                        </p>
                    }
                    <p class="small text-muted">
                        The recipient may still need to train the matching riding skill before this mount can be summoned.
                    </p>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="allowCrossFaction"
                               @bind="allowCrossFaction" />
                        <label class="form-check-label small" for="allowCrossFaction">
                            Acknowledge cross-faction mount(s)
                        </label>
                    </div>
                    <p class="small text-warning">
                        Mount race/faction is only enforced by AzerothCore when the item is used, not when it's
                        given - a mount can always be handed to any selected hero. Checking this box just records
                        in the audit log that you knowingly gave an opposite-faction mount. After giving, the mount
                        is also taught directly to each recipient (this bypasses the WoW client's own faction check,
                        which would otherwise silently block the character from using the item themselves) - level,
                        class, and riding skill requirements still apply and can still cause teaching to fail.
                    </p>
                    <button class="btn btn-primary" type="button"
                            disabled="@(isGiving || selectedMounts.Count == 0 || targetNames.Count == 0)"
                            @onclick="GiveAsync">
                        Give to selected heroes
                    </button>
                    <PlayerActionFeedback Results="giveResults" />
                </div>
            </div>
        </div>
    </div>
}
