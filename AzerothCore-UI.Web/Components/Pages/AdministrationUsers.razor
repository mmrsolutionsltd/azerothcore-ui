@page "/administration-users"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "security.users")]
@inject AccountsApiClient Api
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Access management</PageTitle>
<PageHeader Eyebrow="SECURITY"
            Title="Access Management"
            Description="Manage website users, capability roles, and the game accounts each user may affect."
            BadgeText="ACCESS CONTROL"
            BadgeSubtext="Changes apply immediately"
            Tone="PageHeaderBadgeTone.Danger" />

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert @(error ? "alert-danger" : "alert-success")">@message</div>
}

<AuthorizeView Policy="security.roles">
<Authorized>
<div class="card mb-4">
    <div class="card-header">Roles and permissions</div>
    <div class="card-body">
        <div class="row g-3 mb-3">
            <div class="col-md-3"><label class="form-label">Role name</label>
                <input class="form-control" @bind="roleName" disabled="@editingSystemRole" /></div>
            <div class="col-md-6"><label class="form-label">Description</label>
                <input class="form-control" @bind="roleDescription" disabled="@editingOwnerRole" /></div>
            <div class="col-md-3 d-flex align-items-end">
                <button class="btn btn-primary me-2" disabled="@editingOwnerRole" @onclick="SaveRoleAsync">Save role</button>
                <button class="btn btn-secondary" @onclick="ClearRoleEditor">New</button>
            </div>
        </div>
        @if (permissions is not null)
        {
            @foreach (var category in permissions.GroupBy(permission => permission.Category))
            {
                <fieldset class="mb-3" disabled="@editingOwnerRole">
                    <legend class="h6">@category.Key</legend>
                    <div class="row">
                    @foreach (var permission in category)
                    {
                        <div class="col-md-4 form-check">
                            <input class="form-check-input" type="checkbox"
                                   id="@($"permission-{permission.Key}")"
                                   checked="@selectedPermissions.Contains(permission.Key)"
                                   @onchange="args => TogglePermission(permission.Key, args)" />
                            <label class="form-check-label" for="@($"permission-{permission.Key}")"
                                   title="@permission.Description">@permission.DisplayName</label>
                        </div>
                    }
                    </div>
                </fieldset>
            }
        }
        <div class="d-flex flex-wrap gap-2">
        @foreach (var role in roles ?? [])
        {
            <button class="btn btn-sm @(role.Name == roleName ? "btn-primary" : "btn-outline-secondary")"
                    @onclick="() => EditRole(role)">@role.Name</button>
            @if (!role.IsSystem)
            {
                <button class="btn btn-sm btn-outline-danger"
                        @onclick="() => DeleteRoleAsync(role)">Delete @role.Name</button>
            }
        }
        </div>
    </div>
</div>
</Authorized>
</AuthorizeView>

<div class="card mb-4">
    <div class="card-header">Account assignment options</div>
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-8">
                <label class="form-label" for="account-assignment-search">Find an account</label>
                <input id="account-assignment-search" class="form-control"
                       @bind="accountSearch" @bind:event="oninput"
                       placeholder="Search by account name..." />
            </div>
            <div class="col-md-4">
                <div class="form-check form-switch mb-2">
                    <input id="include-system-accounts" class="form-check-input" type="checkbox"
                           @bind="includeSystemAccounts"
                           @bind:after="ReloadGameAccountsAsync" />
                    <label class="form-check-label" for="include-system-accounts">
                        Include PlayerBot and AHBot accounts
                    </label>
                </div>
            </div>
        </div>
        <div class="form-text">
            Real-player accounts are shown by default. You can only delegate accounts that your
            own website account is allowed to manage.
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">Create website user</div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3"><label class="form-label">Username</label><input class="form-control" @bind="newUsername" /></div>
            <div class="col-md-3">
                <label class="form-label" for="new-user-password">Temporary password</label>
                <div class="input-group">
                    <input id="new-user-password" type="@(showNewPassword ? "text" : "password")"
                           class="form-control" @bind="newPassword" />
                    <button class="btn btn-outline-secondary" type="button"
                            title="@(showNewPassword ? "Hide password" : "Show password")"
                            aria-label="@(showNewPassword ? "Hide temporary password" : "Show temporary password")"
                            aria-pressed="@showNewPassword"
                            @onclick="() => showNewPassword = !showNewPassword">
                        @if (showNewPassword)
                        {
                            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16"
                                 fill="currentColor">
                                <path d="M13.36 11.24 15 12.88l-.71.71L1.71 1 .99 1.7l1.83 1.83A8.7 8.7 0 0 0 .5 7.5S3 12 8 12c1.03 0 1.96-.19 2.78-.49l1.87 1.87.71-.71-12-12-.71.71 2.2 2.2zm-4.1-.47A3 3 0 0 1 4.73 6.2l1.08 1.08a2 2 0 0 0 2.91 2.91l.54.58zM8 3c5 0 7.5 4.5 7.5 4.5a9.9 9.9 0 0 1-2.03 2.5l-.72-.72A8.7 8.7 0 0 0 14.3 7.5C13.53 6.4 11.4 4 8 4c-.63 0-1.22.08-1.76.23l-.8-.8A9.5 9.5 0 0 1 8 3z"/>
                            </svg>
                        }
                        else
                        {
                            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16"
                                 fill="currentColor">
                                <path d="M8 3c5 0 7.5 4.5 7.5 4.5S13 12 8 12 .5 7.5.5 7.5 3 3 8 3zm0 1C4.6 4 2.47 6.4 1.7 7.5 2.47 8.6 4.6 11 8 11s5.53-2.4 6.3-3.5C13.53 6.4 11.4 4 8 4zm0 1.5a2 2 0 1 1 0 4 2 2 0 0 1 0-4z"/>
                            </svg>
                        }
                    </button>
                </div>
            </div>
            <div class="col-md-3"><label class="form-label">Role</label>
                <select class="form-select" @bind="newRole">
                    @foreach (var role in roles ?? []) { <option value="@role.Name">@role.Name</option> }
                </select>
            </div>
            <div class="col-md-3"><label class="form-label">Account access</label>
                <select class="form-select" @bind="newScope">
                    <option value="All">All accounts</option><option value="Assigned">Assigned accounts</option><option value="None">No accounts</option>
                </select>
            </div>
        </div>
        @if (newScope != "None")
        {
            <div class="form-text mt-2">
                @(newScope == "Assigned"
                    ? "These linked accounts define this user's access."
                    : "Optional: link the user's own accounts so their characters appear first; access remains All accounts.")
            </div>
            @AccountSelector(newAccountIds, "new")
        }
        <div class="d-flex justify-content-between mt-3">
            <div class="form-check"><input class="form-check-input" type="checkbox" @bind="newMustChange" id="must-change" />
                <label class="form-check-label" for="must-change">Require password change at first login</label></div>
            <button class="btn btn-primary" disabled="@isWorking" @onclick="CreateAsync">
                @(isWorking ? "Working…" : "Create user")
            </button>
        </div>
    </div>
</div>

@if (users is null)
{
    <p>Loading users…</p>
}
else
{
    @foreach (var user in users)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between">
                <strong>@user.Username</strong>
                <span>@(user.LastLoginAtUtc?.ToLocalTime().ToString("g") ?? "Never signed in")</span>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4"><label class="form-label">Role</label>
                        <select class="form-select" @bind="roleDrafts[user.Id]">
                            @foreach (var role in roles ?? []) { <option value="@role.Name">@role.Name</option> }
                        </select></div>
                    <div class="col-md-4"><label class="form-label">Account access</label>
                        <select class="form-select" @bind="scopeDrafts[user.Id]">
                            <option value="All">All accounts</option><option value="Assigned">Assigned accounts</option><option value="None">No accounts</option>
                        </select></div>
                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check form-switch"><input class="form-check-input" type="checkbox" @bind="enabledDrafts[user.Id]" />
                            <label class="form-check-label">@(enabledDrafts[user.Id] ? "Enabled" : "Disabled")</label></div>
                    </div>
                </div>
                @if (scopeDrafts[user.Id] != "None")
                {
                    <div class="form-text mt-2">
                        @(scopeDrafts[user.Id] == "Assigned"
                            ? "Linked accounts define this user's access."
                            : "Optional preferred accounts appear first in the shared hero header; access remains All accounts.")
                    </div>
                    @AccountSelector(accountDrafts[user.Id], user.Id.ToString())
                }
                @if (user.MustChangePassword) { <div class="small text-warning mt-2">Password change required</div> }
                @if (user.LockoutUntilUtc > DateTime.UtcNow) { <div class="small text-danger">Locked until @user.LockoutUntilUtc.Value.ToLocalTime()</div> }
                <div class="mt-3">
                    <button class="btn btn-sm btn-primary me-1" @onclick="() => SaveAsync(user)">Save</button>
                    <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => SelectReset(user)">Reset password</button>
                    <button class="btn btn-sm btn-outline-danger me-1" @onclick="() => RevokeAsync(user)">Revoke sessions</button>
                    @if (deleteConfirmationId == user.Id)
                    {
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteAsync(user)">Confirm delete</button>
                        <button class="btn btn-sm btn-secondary ms-1" @onclick="() => deleteConfirmationId = null">Cancel</button>
                    }
                    else { <button class="btn btn-sm btn-outline-danger" @onclick="() => deleteConfirmationId = user.Id">Delete</button> }
                </div>
                <div class="form-text">Saving changes revokes this user’s existing website sessions.</div>
            </div>
        </div>
    }
}

@if (resetUser is not null)
{
    <div class="card mb-4"><div class="card-header">Reset password for @resetUser.Username</div>
        <div class="card-body">
            <input type="password" class="form-control mb-2" placeholder="New temporary password" @bind="resetPassword" />
            <div class="form-check mb-2"><input id="reset-change" class="form-check-input" type="checkbox" @bind="resetMustChange" />
                <label class="form-check-label" for="reset-change">Require change at next login</label></div>
            <button class="btn btn-danger me-2" @onclick="ResetAsync">Reset and revoke sessions</button>
            <button class="btn btn-secondary" @onclick="() => resetUser = null">Cancel</button>
        </div>
    </div>
}

<AuthorizeView Policy="security.audit">
<Authorized>
<h2>Recent account activity</h2>
@if (audit is not null)
{
    <div class="table-responsive"><table class="table table-sm">
        <thead><tr><th>When</th><th>User</th><th>Action</th><th>Outcome</th><th>Address</th><th>Detail</th></tr></thead>
        <tbody>@foreach (var entry in audit) { <tr><td>@entry.OccurredAtUtc.ToLocalTime().ToString("g")</td><td>@entry.Username</td><td>@entry.Action</td><td>@entry.Outcome</td><td>@entry.RemoteAddress</td><td>@entry.Detail</td></tr> }</tbody>
    </table></div>
}
</Authorized>
</AuthorizeView>

@code {
    private IReadOnlyList<AdministrationUserSummary>? users;
    private IReadOnlyList<AdministrationAuditEntry>? audit;
    private IReadOnlyList<AdministrationRole>? roles;
    private IReadOnlyList<AdministrationPermission>? permissions;
    private IReadOnlyList<GameAccountOption>? gameAccounts;
    private readonly Dictionary<ulong, string> roleDrafts = [], scopeDrafts = [];
    private readonly Dictionary<ulong, bool> enabledDrafts = [];
    private readonly Dictionary<ulong, HashSet<uint>> accountDrafts = [];
    private readonly HashSet<uint> newAccountIds = [];
    private readonly HashSet<string> selectedPermissions = [];
    private string actor = "", newUsername = "", newPassword = "", newRole = "Administrator", newScope = "Assigned";
    private string accountSearch = "";
    private string roleName = "", roleDescription = "";
    private bool newMustChange = true, error, editingSystemRole, editingOwnerRole, isWorking,
        showNewPassword, includeSystemAccounts;
    private bool isOwner;
    private HashSet<string> actorPermissions = [];
    private ulong? deleteConfirmationId;
    private string? message, resetPassword;
    private AdministrationUserSummary? resetUser;
    private bool resetMustChange = true;

    protected override async Task OnInitializedAsync()
    {
        var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        actor = principal.Identity?.Name ?? "administrator";
        isOwner = principal.IsInRole("Owner");
        actorPermissions = principal.FindAll("permission").Select(claim => claim.Value).ToHashSet();
        await ReloadAsync();
    }
    private async Task ReloadAsync()
    {
        users = await Api.GetAdministrationUsersAsync();
        var allRoles = await Api.GetAdministrationRolesAsync();
        roles = allRoles.Where(role => isOwner
            || role.Permissions.All(actorPermissions.Contains)).ToArray();
        permissions = await Api.GetAdministrationPermissionsAsync();
        await ReloadGameAccountsAsync();
        try { audit = await Api.GetAdministrationAuditAsync(); } catch { audit = []; }
        roleDrafts.Clear(); scopeDrafts.Clear(); enabledDrafts.Clear(); accountDrafts.Clear();
        foreach (var user in users)
        {
            roleDrafts[user.Id] = user.Role; scopeDrafts[user.Id] = user.AccountScope;
            enabledDrafts[user.Id] = user.Enabled;
            accountDrafts[user.Id] = (await Api.GetAdministrationUserGameAccountsAsync(user.Id)).ToHashSet();
        }
        if (roles.Count > 0 && string.IsNullOrEmpty(roleName)) EditRole(roles[0]);
        if (!roles.Any(role => role.Name == newRole)) newRole = roles.FirstOrDefault()?.Name ?? "";
    }
    private IEnumerable<GameAccountOption> VisibleGameAccounts =>
        (gameAccounts ?? []).Where(account => string.IsNullOrWhiteSpace(accountSearch)
            || account.Username.Contains(accountSearch.Trim(), StringComparison.OrdinalIgnoreCase));
    private RenderFragment AccountSelector(HashSet<uint> selected, string key) => @<div class="border rounded p-2 mt-3">
            <div class="small text-muted mb-2">
                @selected.Count selected · @VisibleGameAccounts.Count() matching accounts
            </div>
            @if (gameAccounts?.Count == 0)
            {
                <div class="alert alert-warning mb-0">
                    Your signed-in website account has no game accounts it can delegate.
                    Sign in as an Owner or ask an Owner to assign accounts to you first.
                </div>
            }
            else if (!VisibleGameAccounts.Any())
            {
                <div class="text-muted">No accounts match the current search.</div>
            }
            else
            {
                <div style="max-height: 12rem; overflow:auto">
                    @foreach (var account in VisibleGameAccounts)
                    {
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="@($"account-{key}-{account.Id}")"
                                   checked="@selected.Contains(account.Id)"
                                   @onchange="args => ToggleAccount(selected, account.Id, args)" />
                            <label class="form-check-label" for="@($"account-{key}-{account.Id}")">
                                @account.Username
                                @if (IsSystemAccount(account.Username))
                                {
                                    <span class="badge text-bg-secondary ms-1">Bot</span>
                                }
                            </label>
                        </div>
                    }
                </div>
            }
        </div>;
    private static bool IsSystemAccount(string username) =>
        username.StartsWith("rndbot", StringComparison.OrdinalIgnoreCase)
        || username.Equals("AHBOT", StringComparison.OrdinalIgnoreCase);
    private async Task ReloadGameAccountsAsync() =>
        gameAccounts = await Api.GetGameAccountOptionsAsync(includeSystemAccounts);
    private static void ToggleAccount(HashSet<uint> selected, uint id, ChangeEventArgs args)
    { if (args.Value as bool? == true) selected.Add(id); else selected.Remove(id); }
    private void TogglePermission(string permission, ChangeEventArgs args)
    { if (args.Value as bool? == true) selectedPermissions.Add(permission); else selectedPermissions.Remove(permission); }
    private void EditRole(AdministrationRole role)
    {
        roleName = role.Name; roleDescription = role.Description;
        editingSystemRole = role.IsSystem; editingOwnerRole = role.Name == "Owner";
        selectedPermissions.Clear(); selectedPermissions.UnionWith(role.Permissions);
    }
    private void ClearRoleEditor()
    { roleName = roleDescription = ""; editingSystemRole = editingOwnerRole = false; selectedPermissions.Clear(); }
    private async Task RunAsync(Func<Task> action)
    {
        if (isWorking) return;
        isWorking = true;
        try { await action(); error = false; await ReloadAsync(); }
        catch (Exception exception) { error = true; message = exception.Message; }
        finally { isWorking = false; }
    }
    private Task SaveRoleAsync() => RunAsync(async () =>
    {
        await Api.SaveAdministrationRoleAsync(new(actor, roleName, roleDescription, selectedPermissions.ToArray()));
        message = $"Saved role {roleName}.";
    });
    private Task DeleteRoleAsync(AdministrationRole role) => RunAsync(async () =>
    { await Api.DeleteAdministrationRoleAsync(role.Name, actor); message = $"Deleted role {role.Name}."; ClearRoleEditor(); });
    private Task CreateAsync() => RunAsync(async () =>
    {
        RequireAssignedAccounts(newScope, newAccountIds);
        await Api.CreateAdministrationUserAsync(new(actor, newUsername, newPassword, newRole,
            newScope, newAccountIds.ToArray(), newMustChange));
        message = $"Created {newUsername}."; newUsername = newPassword = ""; newAccountIds.Clear();
        showNewPassword = false;
    });
    private Task SaveAsync(AdministrationUserSummary user) => RunAsync(async () =>
    {
        RequireAssignedAccounts(scopeDrafts[user.Id], accountDrafts[user.Id]);
        await Api.UpdateAdministrationUserAsync(user.Id, new(actor, roleDrafts[user.Id],
            scopeDrafts[user.Id], accountDrafts[user.Id].ToArray(), enabledDrafts[user.Id]));
        message = $"Updated {user.Username}.";
    });
    private static void RequireAssignedAccounts(string scope, IReadOnlyCollection<uint> accounts)
    {
        if (scope == "Assigned" && accounts.Count == 0)
            throw new InvalidOperationException(
                "Select at least one game account, or choose All accounts or No accounts.");
    }
    private void SelectReset(AdministrationUserSummary user) { resetUser = user; resetPassword = ""; resetMustChange = true; }
    private Task ResetAsync() => RunAsync(async () =>
    {
        if (resetUser is null) return;
        await Api.ResetAdministrationPasswordAsync(resetUser.Id, new(actor, resetPassword ?? "", resetMustChange));
        message = $"Reset {resetUser.Username}'s password."; resetUser = null; resetPassword = "";
    });
    private Task RevokeAsync(AdministrationUserSummary user) => RunAsync(async () =>
    { await Api.RevokeAdministrationSessionsAsync(user.Id, actor); message = $"Revoked all sessions for {user.Username}."; });
    private Task DeleteAsync(AdministrationUserSummary user) => RunAsync(async () =>
    { await Api.DeleteAdministrationUserAsync(user.Id, actor); message = $"Deleted {user.Username}."; deleteConfirmationId = null; });
}
