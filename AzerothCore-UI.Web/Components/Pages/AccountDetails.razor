@page "/accounts/{AccountId:long}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "players.accounts")]
@using AzerothCore_UI.Web.Models
@inject AzerothCore_UI.Web.Clients.AccountsApiClient AccountsClient

<PageTitle>@(account?.Username ?? "Account details")</PageTitle>

<p><a href="accounts">&larr; Back to accounts</a></p>

@if (isLoading)
{
    <p><em>Loading account...</em></p>
}
else if (errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}
else if (account is not null)
{
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <p class="text-muted mb-0">Account ID @account.AccountId</p>
        </div>
        <span class="badge text-bg-secondary">@account.Classification</span>
    </div>

    <dl class="row">
        <dt class="col-sm-3">Last login</dt>
        <dd class="col-sm-9">@(account.LastLogin?.ToString("dd MMM yyyy HH:mm") ?? "Never")</dd>
        <dt class="col-sm-3">Characters</dt>
        <dd class="col-sm-9">@account.Characters.Count</dd>
    </dl>

    <h2>Characters</h2>
    @if (account.Characters.Count == 0)
    {
        <p>This account has no characters.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>GUID</th>
                        <th>Character</th>
                        <th>Level</th>
                        <th>Race</th>
                        <th>Class</th>
                        <th>Location</th>
                        <th>Online</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var character in account.Characters)
                    {
                        <tr>
                            <td>@character.Guid</td>
                            <td><a href="characters/@character.Guid">@character.Name</a></td>
                            <td>@character.Level</td>
                            <td>@CharacterDisplayNames.Race(character.Race)</td>
                            <td>@CharacterDisplayNames.Class(character.Class)</td>
                            <td>@character.LocationName</td>
                            <td>@(character.Online ? "Yes" : "No")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
