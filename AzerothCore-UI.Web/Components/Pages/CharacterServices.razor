@page "/character-services"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "players.services")]
@using AzerothCore_UI.Web.Models
@inject AzerothCore_UI.Web.Clients.AccountsApiClient AccountsClient

<PageTitle>Character services</PageTitle>

<PageHeader Eyebrow="CHARACTER SERVICES"
            Title="Character Services"
            Description="Apply AzerothCore character maintenance and at-login services, including level changes and account transfers."
            BadgeText="WRITE ACCESS"
            BadgeSubtext="Each command is audited"
            Tone="PageHeaderBadgeTone.Danger" />

@if (isLoading) { <p><em>Loading characters...</em></p> }
else
{
    @if (message is not null) { <div class="alert @(operationSucceeded ? "alert-success" : "alert-danger")">@message</div> }
    @if (!CanApply) { <div class="alert alert-warning">Character services require the worldserver and SOAP administration connection.</div> }
    <SharedCharacterSelection Items="@PickerItems" Multiple="true"
                              SelectedValuesChanged="SetSelectedPlayers" />
    @if (batchResults.Count > 0)
    {
        <div class="card mb-4"><div class="card-body">
            <h2 class="h5">Batch results</h2>
            <ul class="list-group list-group-flush">
                @foreach (var result in batchResults)
                {
                    <li class="list-group-item px-0">
                        <span class="badge @(result.Success ? "text-bg-success" : "text-bg-danger") me-2">@(result.Success ? "Success" : "Failed")</span>
                        <strong>@result.PlayerName:</strong> @result.Message
                    </li>
                }
            </ul>
        </div></div>
    }
    <div class="character-services-grid">
        @foreach (var service in Services)
        {
            <div class="card h-100"><div class="card-body d-flex flex-column">
                <h2 class="h5">@service.Title</h2><p class="text-muted flex-grow-1">@service.Description</p>
                @if (service.Key == "level")
                {
                    <label class="form-label" for="service-level">New level</label><input id="service-level" class="form-control mb-3" type="number" min="1" max="80" @bind="newLevel" />
                }
                <button class="btn @(service.Dangerous ? "btn-outline-danger" : "btn-outline-primary")" disabled="@(!CanSelectService(service))" @onclick="() => SelectService(service.Key)">@service.Button</button>
                @if (service.Key == "spells" && SelectedPlayers.Any(player => !player.Online))
                {
                    <div class="form-text">Log this character in before resetting spells.</div>
                }
            </div></div>
        }
        <div class="card h-100"><div class="card-body d-flex flex-column">
            <h2 class="h5">Transfer account</h2>
            <p class="text-muted flex-grow-1">
                Move one character to another WoW login account using AzerothCore's supported transfer command.
            </p>
            <label class="form-label" for="transfer-account">Destination account</label>
            <select id="transfer-account" class="form-select mb-3" @bind="destinationAccountId">
                <option value="">Choose an account</option>
                @foreach (var account in transferAccounts)
                {
                    <option value="@account.AccountId"
                            disabled="@(SelectedTransferPlayer?.Username.Equals(account.Username, StringComparison.OrdinalIgnoreCase) == true || account.CharacterCount >= 10)">
                        @account.Username (@account.CharacterCount/10)
                    </option>
                }
            </select>
            <button class="btn btn-outline-danger" disabled="@(!CanTransferAccount)"
                    @onclick="SelectAccountTransfer">
                Transfer character
            </button>
            @if (SelectedPlayers.Count != 1)
            {
                <div class="form-text">Select exactly one character for an account transfer.</div>
            }
        </div></div>
    </div>
    @if (pendingService is not null)
    {
        <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true"><div class="modal-dialog"><div class="modal-content">
            <div class="modal-header"><h2 class="modal-title h5">Confirm character service</h2><button class="btn-close" @onclick="CancelService"></button></div>
            <div class="modal-body">
                <p>Apply <strong>@ServiceTitle(pendingService)</strong> to these @SelectedPlayers.Count characters?</p>
                <ul>@foreach (var player in SelectedPlayers) { <li>@player.Name (@(player.Online ? "online" : "offline"))</li> }</ul>
                <p class="text-muted mb-0">Each command is audited and sent separately so one failure does not prevent the remaining characters from being processed.</p>
            </div>
            <div class="modal-footer"><button class="btn btn-outline-secondary" @onclick="CancelService">Cancel</button><button class="btn btn-danger" disabled="@isWorking" @onclick="ApplyServiceAsync">Confirm and apply</button></div>
        </div></div></div><div class="modal-backdrop show"></div>
    }
    @if (pendingAccountTransfer && SelectedTransferPlayer is not null && SelectedDestinationAccount is not null)
    {
        <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true"><div class="modal-dialog"><div class="modal-content">
            <div class="modal-header"><h2 class="modal-title h5">Confirm account transfer</h2><button class="btn-close" disabled="@isWorking" @onclick="CancelAccountTransfer"></button></div>
            <div class="modal-body">
                <p>
                    Move <strong>@SelectedTransferPlayer.Name</strong> from
                    <strong>@SelectedTransferPlayer.Username</strong> to
                    <strong>@SelectedDestinationAccount.Username</strong>?
                </p>
                @if (SelectedTransferPlayer.Online)
                {
                    <div class="alert alert-warning">AzerothCore will disconnect this character during the transfer.</div>
                }
                <p class="text-muted mb-0">
                    A verified database backup will be created first. Account-scoped website access and PlayerBot control may change with ownership.
                </p>
                @if (isWorking)
                {
                    <p class="mt-3 mb-0"><em>Creating the backup and transferring the character…</em></p>
                }
            </div>
            <div class="modal-footer"><button class="btn btn-outline-secondary" disabled="@isWorking" @onclick="CancelAccountTransfer">Cancel</button><button class="btn btn-danger" disabled="@isWorking" @onclick="TransferAccountAsync">Create backup and transfer</button></div>
        </div></div></div><div class="modal-backdrop show"></div>
    }
}
