@page "/trainers"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "adventures.training")]
@using AzerothCore_UI.Web.Models
@inject AzerothCore_UI.Web.Clients.AccountsApiClient AccountsClient

<PageTitle>Trainer finder</PageTitle>

<p class="text-muted">
    Find an appropriate trainer and teleport a character directly to that exact NPC spawn.
</p>

@if (isLoading)
{
    <p><em>Loading available characters...</em></p>
}
else if (errorMessage is not null)
{
    <div class="alert alert-danger">@errorMessage</div>
}
else
{
    <div class="card mb-4">
        <div class="card-body">
            <label class="form-label">Character</label>
            <CharacterPicker Items="@PickerItems" AllowBots="true"
                             SelectedValue="@characterName"
                             SelectedValueChanged="SelectCharacter" />
        </div>
    </div>

    <TrainerFinderTool CharacterName="@characterName"
                       InitialCategory="@InitialCategory"
                       InitialSearch="@InitialSearch" />
}
