@page "/trainers"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "adventures.training")]
@using AzerothCore_UI.Web.Models
@inject AzerothCore_UI.Web.Clients.AccountsApiClient AccountsClient

<PageTitle>Trainer finder</PageTitle>

<PageHeader Eyebrow="GEARING ROOM"
            Title="Trainer Finder"
            Description="Find an appropriate trainer and teleport a character directly to that exact NPC spawn." />

@if (isLoading)
{
    <p><em>Loading available characters...</em></p>
}
else if (errorMessage is not null)
{
    <div class="alert alert-danger">@errorMessage</div>
}
else
{
    <div class="card mb-4">
        <div class="card-body">
            <SharedCharacterSelection Items="@PickerItems"
                                      SelectedValueChanged="SelectCharacter" />
            <div class="form-text">Using the active hero selected in the header.</div>
        </div>
    </div>

    <TrainerFinderTool CharacterName="@characterName"
                       InitialCategory="@InitialCategory"
                       InitialSearch="@InitialSearch" />
}
