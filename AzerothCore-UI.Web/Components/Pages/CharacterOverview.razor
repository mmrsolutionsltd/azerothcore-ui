@page "/characters"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "players.characters")]
@rendermode InteractiveServer
@using AzerothCore_UI.Web.Models
@inject AzerothCore_UI.Web.Clients.AccountsApiClient AccountsClient

<PageTitle>Characters</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
    <div>
        <p class="text-muted mb-0">A quick overview of real player characters and their current progress.</p>
    </div>
    <button class="btn btn-outline-primary" @onclick="LoadAsync" disabled="@isLoading">Refresh</button>
</div>

<div class="row g-2 mb-4">
    <div class="col-md-6">
        <label class="form-label" for="character-search">Search</label>
        <input id="character-search" class="form-control" placeholder="Character or account name"
               @bind="search" @bind:event="oninput" />
    </div>
    <div class="col-md-3">
        <label class="form-label" for="character-class">Class</label>
        <select id="character-class" class="form-select" @bind="classFilter">
            <option value="0">All classes</option>
            @foreach (var characterClass in ClassOptions)
            {
                <option value="@characterClass">@CharacterDisplayNames.Class(characterClass)</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label" for="character-status">Status</label>
        <select id="character-status" class="form-select" @bind="statusFilter">
            <option value="all">All</option>
            <option value="online">Online</option>
            <option value="offline">Offline</option>
        </select>
    </div>
</div>

@if (isLoading)
{
    <p><em>Loading characters...</em></p>
}
else if (errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}
else if (FilteredCharacters.Count == 0)
{
    <div class="alert alert-info">No matching real-player characters were found.</div>
}
else
{
    <p class="text-muted">Showing @FilteredCharacters.Count of @characters.Count characters.</p>
    <div class="row g-3">
        @foreach (var character in FilteredCharacters)
        {
            <div class="col-xl-4 col-md-6">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h2 class="h5 mb-1">
                                    <a href="/characters/@character.Guid">@character.Name</a>
                                </h2>
                                <div class="text-muted small">@character.Username</div>
                            </div>
                            <span class="badge @(character.Online ? "text-bg-success" : "text-bg-secondary")">
                                @(character.Online ? "Online" : "Offline")
                            </span>
                        </div>

                        <p class="mt-3 mb-2">
                            Level @character.Level @CharacterDisplayNames.Race(character.Race)
                            @CharacterDisplayNames.Class(character.Class)
                        </p>
                        <dl class="row small mb-3">
                            <dt class="col-4">Location</dt>
                            <dd class="col-8">@character.LocationName</dd>
                            <dt class="col-4">Money</dt>
                            <dd class="col-8"><MoneyDisplay Copper="character.Money" /></dd>
                            <dt class="col-4">Played</dt>
                            <dd class="col-8">@FormatPlayedTime(character.TotalTime)</dd>
                            <dt class="col-4">Progress</dt>
                            <dd class="col-8">@character.ActiveQuestCount quests · @character.ProfessionCount professions</dd>
                            @if (!string.IsNullOrWhiteSpace(character.PetName))
                            {
                                <dt class="col-4">Pet</dt>
                                <dd class="col-8">@character.PetName</dd>
                            }
                            @if (character.HomebindMap is not null)
                            {
                                <dt class="col-4">Hearthstone</dt>
                                <dd class="col-8">Map @character.HomebindMap, zone @character.HomebindZone</dd>
                            }
                        </dl>

                        <div class="d-flex flex-wrap gap-2">
                            <a class="btn btn-sm btn-primary" href="/characters/@character.Guid">Details</a>
                            <a class="btn btn-sm btn-outline-secondary" href="/characters/@character.Guid?tab=Inventory">Inventory</a>
                            <a class="btn btn-sm btn-outline-secondary" href="/characters/@character.Guid?tab=Quests">Quests</a>
                            <a class="btn btn-sm btn-outline-secondary" href="/characters/@character.Guid?tab=Professions">Professions</a>
                            <a class="btn btn-sm btn-outline-secondary" href="/characters/@character.Guid?tab=Training">Training</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<hr class="my-4" />
<h2 class="h5">Character tools</h2>
<div class="d-flex flex-wrap gap-2">
    <a class="btn btn-outline-primary" href="/player-actions">Player actions</a>
    <a class="btn btn-outline-primary" href="/character-services">Character services</a>
    <a class="btn btn-outline-primary" href="/trainers">Trainer finder</a>
    <a class="btn btn-outline-primary" href="/collectibles">Collectibles</a>
</div>
