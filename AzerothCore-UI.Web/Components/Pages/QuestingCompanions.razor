@page "/questing-companions"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "adventures.quests")]
@implements IAsyncDisposable
@inject AccountsApiClient Api
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider
@inject AzerothCore_UI.Web.Services.SelectedCharacterStore SelectedCharacterStore

<PageTitle>Questing companions</PageTitle>

<PageHeader Eyebrow="HOUSEHOLD PARTY COMMAND"
            Title="Questing Companion Hall"
            Description="Lead the adventure normally while trusted heroes follow, fight, gather and share the journey."
            BadgeText="PARTIES REMEMBERED"
            BadgeSubtext="Independent groups for every household player"
            Tone="PageHeaderBadgeTone.Caution" />

<div class="companion-sanctum">

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @(operationSucceeded ? "alert-success" : "alert-danger")">@message</div>
}

@if (RememberedSessions.Count > 0)
{
    <div class="remembered-parties">
        <span class="section-label">REMEMBERED COMPANION PARTIES</span>
        <div>
            @foreach (var session in RememberedSessions)
            {
                <button type="button" class="remembered-party @(leaderName.Equals(session.LeaderName, StringComparison.OrdinalIgnoreCase) ? "selected" : null)"
                        @onclick="() => RestoreSessionAsync(session)">
                    <span class="party-crown">♛</span>
                    <strong>@session.LeaderName</strong>
                    <small>@(session.LeaderOnline ? "Online leader" : "Offline grace") · @session.Companions.Count companion(s)</small>
                    <span class="party-lineup">@string.Join(" · ", session.Companions.Select(companion => companion.Name))</span>
                </button>
            }
        </div>
    </div>
}

<div class="row g-2">
    <div class="col-12 col-xl-6">
        <div class="card companion-card h-100">
            <div class="card-header"><span class="step-rune">I</span> Online party leader</div>
            <div class="card-body">
                @if (string.IsNullOrWhiteSpace(leaderName))
                {
                    <div class="header-selection-empty">Select an online hero in the realm header.</div>
                }
                else
                {
                    var leader = realmRoster?.AvailableHeroes?.FirstOrDefault(player => player.Name.Equals(
                        leaderName, StringComparison.OrdinalIgnoreCase));
                    <div class="header-party-member leader">
                        <span class="party-crown">♛</span>
                        <span><strong>@leaderName</strong><small>Level @leader?.Level · @leader?.Username</small></span>
                        <b>LEADER</b>
                    </div>
                }
                <div class="form-text">The selected party's online leader is resolved from the realm header.</div>
                <p class="small text-muted mt-2 mb-0">
                    This is the character you continue to control in the WoW client.
                </p>
                @if (CurrentSession is not null)
                {
                    <div class="retention-setting">
                        <div><strong>Remember this party</strong><small>After its leader goes offline</small></div>
                        <select class="form-select form-select-sm" @bind="offlineTimeoutMinutes" @bind:after="SaveTimeoutAsync" disabled="@working">
                            <option value="1">1 minute</option><option value="5">5 minutes</option>
                            <option value="10">10 minutes</option><option value="15">15 minutes</option>
                            <option value="30">30 minutes</option><option value="60">1 hour</option>
                            <option value="120">2 hours</option>
                        </select>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-6">
        <div class="card companion-card h-100">
            <div class="card-header"><span class="step-rune">II</span> Choose companions</div>
            <div class="card-body">
                @if (status is null)
                {
                    <p class="text-muted mb-0">Select an online leader first.</p>
                }
                else
                {
                    var selectedLineup = HeaderCompanionNames;
                    @if (selectedLineup.Count == 0)
                    {
                        <div class="header-selection-empty">Add offline heroes in the realm header to form the companion line-up.</div>
                    }
                    else
                    {
                        <div class="header-companion-lineup">
                            @foreach (var name in selectedLineup)
                            {
                                var active = status.ActiveCompanions.Any(companion =>
                                    companion.Name.Equals(name, StringComparison.OrdinalIgnoreCase));
                                var ready = selectedCompanions.Contains(name);
                                var candidate = status.Candidates.FirstOrDefault(value =>
                                    value.Name.Equals(name, StringComparison.OrdinalIgnoreCase));
                                <div class="header-party-member @(active ? "active" : ready ? "ready" : "unavailable")">
                                    <span>✦</span>
                                    <span><strong>@name</strong><small>@candidate?.Username</small></span>
                                    <b>@(active ? "ACTIVE" : ready ? "READY" : "UNAVAILABLE")</b>
                                </div>
                            }
                        </div>
                    }
                    <div class="form-text">The header is the single source of truth: leader first, then up to fourteen companions.</div>
                    @if (UnavailableCandidates.Count > 0)
                    {
                        <details class="small text-muted mt-2">
                            <summary>@UnavailableCandidates.Count unavailable character(s)</summary>
                            @foreach (var candidate in UnavailableCandidates)
                            {
                                <div>
                                    @candidate.Name —
                                    @(candidate.Online ? "already online"
                                        : !candidate.SameFaction ? "opposite faction"
                                        : candidate.ControlReason)
                                    @if (canManageAccountLinks && !candidate.Online
                                        && candidate.SameFaction && !candidate.SameAccount
                                        && !candidate.SameGuild && !candidate.AccountsLinked)
                                    {
                                        <button class="btn btn-sm btn-link py-0"
                                                @onclick="() => RequestAccountLink(candidate, true)">
                                            Trust accounts
                                        </button>
                                    }
                                </div>
                            }
                        </details>
                    }
                    @if (canManageAccountLinks && AvailableCandidates.Any(candidate => candidate.AccountsLinked))
                    {
                        <details class="small text-muted mt-2">
                            <summary>Trusted account links</summary>
                            @foreach (var candidate in AvailableCandidates
                                .Where(value => value.AccountsLinked)
                                .DistinctBy(value => value.AccountId))
                            {
                                <div>
                                    @candidate.Username
                                    <button class="btn btn-sm btn-link text-danger py-0"
                                            @onclick="() => RequestAccountLink(candidate, false)">
                                        Remove trust
                                    </button>
                                </div>
                            }
                        </details>
                    }
                    @if (pendingLinkCandidate is not null)
                    {
                        <div class="alert alert-warning mt-2 mb-0">
                            <div>
                                @(pendingLinkValue
                                    ? $"Trust the accounts for {leaderName} and {pendingLinkCandidate.Name}?"
                                    : $"Remove trust between the accounts for {leaderName} and {pendingLinkCandidate.Name}?")
                                A verified database backup will be created first.
                            </div>
                            <button class="btn btn-sm btn-warning mt-2 me-2"
                                    disabled="@working" @onclick="ConfirmAccountLinkAsync">Confirm</button>
                            <button class="btn btn-sm btn-outline-secondary mt-2"
                                    disabled="@working" @onclick="CancelAccountLink">Cancel</button>
                        </div>
                    }
                    <button class="companion-action mt-3" type="button"
                            disabled="@(working || selectedCompanions.Count == 0)"
                            @onclick="StartAsync">
                        Start selected companions
                    </button>
                }
            </div>
        </div>
    </div>

    @* Quest progress is shown by the in-game addon; the duplicated active-companion
       summary formerly rendered here is intentionally retired.
    <div class="col-12 col-xl-4">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>
                    3. Active companions
                    @if (status is { ProtocolVersion: > 0 })
                    {
                        <span class="badge text-bg-secondary ms-1">Bridge v@status.ProtocolVersion</span>
                    }
                </span>
                <button class="btn btn-sm btn-outline-secondary" type="button"
                        disabled="@(working || string.IsNullOrWhiteSpace(leaderName))"
                        @onclick="RefreshAsync">Refresh</button>
            </div>
            <div class="card-body">
                @if (status is null || status.ActiveCompanions.Count == 0)
                {
                    <p class="text-muted mb-0">No active companions.</p>
                }
                else
                {
                    @if (status.ProtocolVersion == 0)
                    {
                        <div class="alert alert-warning py-2 small">
                            The installed server bridge predates protocol version reporting.
                            Rebuild and install the current mod-web-admin source.
                        </div>
                    }
                    @foreach (var companion in status.ActiveCompanions)
                    {
                        <div class="border rounded p-2 mb-2">
                            <div class="d-flex gap-2 align-items-start">
                                <div class="flex-grow-1">
                                    <strong>@companion.Name</strong>
                                    <div class="small text-muted">
                                        Level @companion.Level · @ClassName(companion.CharacterClass)
                                        · @(companion.InLeaderParty ? "In party" : "Not in party")
                                    </div>
                                    @if (companion.TotalBagSlots > 0)
                                    {
                                        <div class="d-flex flex-wrap gap-1 mt-1">
                                            <span class="badge @(companion.LootEnabled ? "text-bg-success" : "text-bg-warning")">
                                                Loot @(companion.LootEnabled ? "enabled" : "disabled")
                                            </span>
                                            <span class="badge @(companion.FreeBagSlots > 2 ? "text-bg-secondary" : "text-bg-danger")">
                                                @companion.FreeBagSlots/@companion.TotalBagSlots bag slots free
                                            </span>
                                        </div>
                                    }
                                </div>
                                <button class="btn btn-sm btn-outline-danger" type="button"
                                        disabled="@working"
                                        @onclick="() => DismissAsync(companion.Name)">
                                    Dismiss
                                </button>
                            </div>

                            @if (companion.TotalBagSlots == 0)
                            {
                                <div class="small text-warning mt-2">
                                    Loot and quest progress need the latest installed
                                    mod-web-admin build.
                                </div>
                            }
                            else
                            {
                                @if (!string.IsNullOrWhiteSpace(companion.QuestObjectStatus))
                                {
                                    <div class="small mt-2 @QuestObjectStatusClass(companion.QuestObjectStatus)">
                                        World-object collection: @companion.QuestObjectStatus
                                    </div>
                                }
                                @if (!companion.LootEnabled)
                                {
                                    <div class="small text-danger mt-2">
                                        Looting is not active for this companion.
                                        Dismiss and start it again after the updated module is installed.
                                    </div>
                                }
                                @if (companion.FreeBagSlots == 0)
                                {
                                    <div class="small text-danger mt-2">
                                        Bags are full, so this companion cannot collect quest items.
                                    </div>
                                }
                                @if (companion.Quests.Count == 0)
                                {
                                    <div class="small text-muted mt-2">
                                        No mirrored quests are currently in this companion's log.
                                    </div>
                                }
                                else
                                {
                                    <details class="mt-2">
                                        <summary class="small">
                                            Quest progress (@companion.Quests.Count)
                                        </summary>
                                        <div class="mt-2">
                                            @foreach (var quest in companion.Quests)
                                            {
                                                var leaderQuest = FindLeaderQuest(quest.QuestId);
                                                <div class="border-top py-2">
                                                    <div class="d-flex justify-content-between gap-2">
                                                        <strong class="small">@quest.Title</strong>
                                                        <span class="badge @(quest.Complete ? "text-bg-success" : "text-bg-secondary")">
                                                            @(quest.Complete ? "Ready to turn in" : "In progress")
                                                        </span>
                                                    </div>
                                                    @if (quest.Objectives.Count == 0)
                                                    {
                                                        <div class="small text-muted mt-1">
                                                            No countable item or kill objectives.
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        @foreach (var objective in quest.Objectives)
                                                        {
                                                            var leaderObjective =
                                                                FindLeaderObjective(leaderQuest, objective);
                                                            <div class="small mt-1 d-flex justify-content-between gap-2">
                                                                <span>@objective.Name</span>
                                                                <span class="text-nowrap">
                                                                    You: @(leaderObjective?.Current ?? 0)/@objective.Required
                                                                    · @companion.Name:
                                                                    @objective.Current/@objective.Required
                                                                </span>
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </details>
                                }
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>
    *@
</div>

<div class="alert alert-info mt-3 mb-0">
    Any offline, same-faction character in your assigned WoW accounts can be a companion.
    Characters on the leader's account are trusted automatically; characters on another
    account must share the leader's guild or use a trusted account link. Eligible quests
    accepted by the leader are mirrored to active companions. Companions periodically
    check nearby quest givers and independently accept eligible quests for their own
    class or professions; the leader need not have the quest or speak to its giver.
    Companions collect and track their own quest items; Free-for-All
    party loot must be enabled in PlayerBots for this to work consistently. Scripted or
    item-started quests may still need manual help.
</div>
</div>

@code {
    private IReadOnlyList<AdministrationPlayer> players = [];
    private QuestingCompanionStatus? status;
    private RealmRosterSnapshot? realmRoster;
    private string leaderName = "";
    private IReadOnlySet<string> selectedCompanions =
        new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    private string? message;
    private bool operationSucceeded, working;
    private bool canManageAccountLinks, pendingLinkValue;
    private QuestingCompanionCandidate? pendingLinkCandidate;
    private readonly CancellationTokenSource refreshCancellation = new();
    private Task? refreshLoop;
    private string signedInUsername = "";
    private int offlineTimeoutMinutes = 5;
    private IReadOnlyList<string> headerSelectedNames = [];
    private int headerSelectionGeneration;

    private IReadOnlyList<CompanionPartySession> RememberedSessions =>
        realmRoster?.CompanionSessions
            .OrderByDescending(session => session.LeaderOnline)
            .ThenByDescending(session => session.StartedAtUtc).ToArray() ?? [];
    private CompanionPartySession? CurrentSession => RememberedSessions.FirstOrDefault(
        session => session.LeaderName.Equals(leaderName, StringComparison.OrdinalIgnoreCase));

    private IReadOnlyList<QuestingCompanionCandidate> AvailableCandidates =>
        status?.Candidates
            .Where(candidate => !candidate.Online && candidate.SameFaction
                && candidate.ControlAllowed)
            .OrderBy(candidate => candidate.Level)
            .ThenBy(candidate => candidate.Username, StringComparer.OrdinalIgnoreCase)
            .ThenBy(candidate => candidate.Name, StringComparer.OrdinalIgnoreCase)
            .ToArray() ?? [];

    private IReadOnlyList<QuestingCompanionCandidate> UnavailableCandidates =>
        status?.Candidates.Except(AvailableCandidates)
            .OrderBy(candidate => candidate.Level)
            .ThenBy(candidate => candidate.Username, StringComparer.OrdinalIgnoreCase)
            .ThenBy(candidate => candidate.Name, StringComparer.OrdinalIgnoreCase)
            .ToArray() ?? [];

    private IReadOnlyList<string> HeaderCompanionNames => headerSelectedNames
        .Where(name => !name.Equals(leaderName, StringComparison.OrdinalIgnoreCase))
        .ToArray();

    protected override async Task OnInitializedAsync()
    {
        SelectedCharacterStore.SelectionChanged += OnHeaderSelectionChanged;
        SelectedCharacterStore.SelectedCharactersChanged += OnHeaderCharactersChanged;
        try
        {
            players = await Api.GetAdministrationPlayersAsync();
            var authenticationState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();
            signedInUsername = authenticationState.User.Identity?.Name ?? "";
            canManageAccountLinks = authenticationState.User.IsInRole("Owner")
                || authenticationState.User.IsInRole("Administrator");
            try { realmRoster = await Api.GetRealmRosterAsync(); }
            catch { realmRoster = null; }
            await ApplyHeaderSelectionAsync(allowRememberedFallback: true);
            refreshLoop = RefreshLoopAsync(refreshCancellation.Token);
        }
        catch (Exception exception)
        {
            message = exception.Message;
        }
    }

    private async Task SelectLeaderAsync(string? value)
    {
        if (leaderName.Equals(value, StringComparison.OrdinalIgnoreCase) && status is not null)
            return;
        leaderName = value ?? "";
        selectedCompanions = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        status = null;
        pendingLinkCandidate = null;
        message = null;
        var remembered = CurrentSession;
        offlineTimeoutMinutes = remembered?.OfflineTimeoutMinutes ?? 5;
        if (!string.IsNullOrWhiteSpace(leaderName)) await RefreshAsync();
    }

    private async Task ApplyHeaderSelectionAsync(bool allowRememberedFallback = false)
    {
        var selectedNames = await SelectedCharacterStore.GetSelectedAsync();
        var activeName = await SelectedCharacterStore.GetAsync();
        headerSelectedNames = selectedNames.ToArray();

        var selectedSet = selectedNames.ToHashSet(StringComparer.OrdinalIgnoreCase);
        var selectedParty = realmRoster?.Parties
            .Where(party => party.Live && party.Members.Any(member =>
                selectedSet.Contains(member.Name)))
            .OrderByDescending(party => party.LeaderName.Equals(
                activeName, StringComparison.OrdinalIgnoreCase))
            .ThenByDescending(party => party.Members.Any(member => member.Name.Equals(
                activeName, StringComparison.OrdinalIgnoreCase)))
            .FirstOrDefault();
        var activePlayer = players.FirstOrDefault(player =>
            player.Online && !player.IsPlayerBot && player.Name.Equals(
                activeName, StringComparison.OrdinalIgnoreCase));
        var selectedPlayer = selectedNames.Select(name => players.FirstOrDefault(player =>
                player.Online && !player.IsPlayerBot && player.Name.Equals(
                    name, StringComparison.OrdinalIgnoreCase)))
            .FirstOrDefault(player => player is not null);
        var desiredLeader = selectedParty?.LeaderName
            ?? activePlayer?.Name
            ?? selectedPlayer?.Name;

        if (!string.IsNullOrWhiteSpace(desiredLeader))
        {
            await SelectLeaderAsync(desiredLeader);
            SynchronizeSelectedCompanions();
            return;
        }

        var matchingSession = RememberedSessions.FirstOrDefault(session =>
            selectedSet.Contains(session.LeaderName)
            || session.Companions.Any(companion => selectedSet.Contains(companion.Name)));
        if (matchingSession is not null)
        {
            leaderName = matchingSession.LeaderName;
            offlineTimeoutMinutes = matchingSession.OfflineTimeoutMinutes;
            if (matchingSession.LeaderOnline) await RefreshAsync();
            SynchronizeSelectedCompanions();
            return;
        }

        if (allowRememberedFallback && selectedNames.Count == 0)
        {
            var restored = RememberedSessions.FirstOrDefault(session =>
                    session.LeaderOnline && session.StartedByUsername.Equals(
                        signedInUsername, StringComparison.OrdinalIgnoreCase))
                ?? RememberedSessions.FirstOrDefault(session => session.LeaderOnline)
                ?? RememberedSessions.FirstOrDefault();
            if (restored is not null)
            {
                leaderName = restored.LeaderName;
                offlineTimeoutMinutes = restored.OfflineTimeoutMinutes;
                headerSelectedNames = new[] { restored.LeaderName }.Concat(
                    restored.Companions.Select(companion => companion.Name)).ToArray();
                await SelectedCharacterStore.SetSelectedAsync(
                    headerSelectedNames, restored.LeaderName);
                if (restored.LeaderOnline) await RefreshAsync();
                SynchronizeSelectedCompanions();
                return;
            }
        }

        leaderName = "";
        status = null;
        selectedCompanions = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    }

    private void SynchronizeSelectedCompanions() => selectedCompanions =
        AvailableCandidates.Where(candidate => headerSelectedNames.Contains(
                candidate.Name, StringComparer.OrdinalIgnoreCase))
            .Select(candidate => candidate.Name)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

    private void OnHeaderSelectionChanged(string _) => QueueHeaderSelection();

    private void OnHeaderCharactersChanged(IReadOnlyList<string> _) =>
        QueueHeaderSelection();

    private void QueueHeaderSelection()
    {
        var generation = Interlocked.Increment(ref headerSelectionGeneration);
        _ = InvokeAsync(async () =>
        {
            await Task.Yield();
            if (generation != headerSelectionGeneration) return;
            await ApplyHeaderSelectionAsync();
            StateHasChanged();
        });
    }

    private async Task RestoreSessionAsync(CompanionPartySession session)
    {
        leaderName = session.LeaderName;
        offlineTimeoutMinutes = session.OfflineTimeoutMinutes;
        selectedCompanions = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        await SelectedCharacterStore.SetSelectedAsync(
            new[] { session.LeaderName }.Concat(
                session.Companions.Select(companion => companion.Name)),
            session.LeaderName);
        if (session.LeaderOnline) await RefreshAsync();
        else
        {
            status = null;
            operationSucceeded = true;
            message = $"{session.LeaderName}'s party is remembered while the leader is briefly offline.";
        }
    }

    private async Task SaveTimeoutAsync()
    {
        if (string.IsNullOrWhiteSpace(leaderName) || CurrentSession is null) return;
        try
        {
            var result = await Api.SetCompanionPartyTimeoutAsync(
                new(leaderName, offlineTimeoutMinutes));
            operationSucceeded = true;
            message = result?.Message;
            realmRoster = await Api.GetRealmRosterAsync();
        }
        catch (Exception exception)
        {
            operationSucceeded = false;
            message = exception.Message;
        }
    }

    private void RequestAccountLink(QuestingCompanionCandidate candidate, bool linked)
    {
        pendingLinkCandidate = candidate;
        pendingLinkValue = linked;
    }

    private void CancelAccountLink() => pendingLinkCandidate = null;

    private async Task ConfirmAccountLinkAsync()
    {
        if (pendingLinkCandidate is null) return;
        working = true;
        try
        {
            var result = await Api.SetQuestingCompanionAccountLinkAsync(new(
                leaderName, pendingLinkCandidate.Name, pendingLinkValue, true));
            operationSucceeded = true;
            message = result?.Message;
            pendingLinkCandidate = null;
            status = await Api.GetQuestingCompanionsAsync(leaderName);
            try { realmRoster = await Api.GetRealmRosterAsync(); } catch { }
        }
        catch (Exception exception)
        {
            operationSucceeded = false;
            message = exception.Message;
        }
        finally { working = false; }
    }

    private async Task RefreshAsync()
    {
        if (string.IsNullOrWhiteSpace(leaderName)) return;
        working = true;
        try
        {
            players = await Api.GetAdministrationPlayersAsync();
            status = await Api.GetQuestingCompanionsAsync(leaderName);
            try { realmRoster = await Api.GetRealmRosterAsync(); } catch { }
            operationSucceeded = true;
            message = null;
        }
        catch (Exception exception)
        {
            operationSucceeded = false;
            message = exception.Message;
        }
        finally { working = false; }
    }

    private async Task StartAsync()
    {
        working = true;
        try
        {
            foreach (var companion in selectedCompanions)
                await Api.StartQuestingCompanionAsync(
                    new(leaderName, companion));
            operationSucceeded = true;
            message = selectedCompanions.Count == 1
                ? "The companion is logging in and joining the party."
                : $"{selectedCompanions.Count} companions are logging in and joining the party.";
            selectedCompanions = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            await Task.Delay(1500);
            status = await Api.GetQuestingCompanionsAsync(leaderName);
            try { realmRoster = await Api.GetRealmRosterAsync(); } catch { }
        }
        catch (Exception exception)
        {
            operationSucceeded = false;
            message = exception.Message;
        }
        finally { working = false; }
    }

    private async Task DismissAsync(string companion)
    {
        working = true;
        try
        {
            var result = await Api.DismissQuestingCompanionAsync(
                new(leaderName, companion));
            operationSucceeded = true;
            message = result?.Message ?? $"{companion} is logging out.";
            await Task.Delay(750);
            status = await Api.GetQuestingCompanionsAsync(leaderName);
        }
        catch (Exception exception)
        {
            operationSucceeded = false;
            message = exception.Message;
        }
        finally { working = false; }
    }

    private async Task ResetCompanionAsync(string companion)
    {
        working = true;
        try
        {
            var result = await Api.ResetQuestingCompanionAsync(
                new(leaderName, companion));
            operationSucceeded = true;
            message = result?.Message
                ?? $"{companion}'s AI behaviour was reset.";
            status = await Api.GetQuestingCompanionsAsync(leaderName);
        }
        catch (Exception exception)
        {
            operationSucceeded = false;
            message = exception.Message;
        }
        finally { working = false; }
    }

    private async Task SetBehaviorAsync(QuestingCompanionBehaviorRequest request)
    {
        working = true;
        try
        {
            var result = await Api.SetQuestingCompanionBehaviorAsync(
                request with { LeaderName = leaderName });
            operationSucceeded = true;
            message = result?.Message ?? "Companion behaviour was updated.";
            status = await Api.GetQuestingCompanionsAsync(leaderName);
        }
        catch (Exception exception)
        {
            operationSucceeded = false;
            message = exception.Message;
        }
        finally { working = false; }
    }

    private async Task SetPresetAsync(QuestingCompanionPresetRequest request)
    {
        working = true;
        try
        {
            var result = await Api.SetQuestingCompanionPresetAsync(
                request with { LeaderName = leaderName });
            operationSucceeded = true;
            message = result?.Message ?? "Companion preset was applied.";
            status = await Api.GetQuestingCompanionsAsync(leaderName);
        }
        catch (Exception exception)
        {
            operationSucceeded = false;
            message = exception.Message;
        }
        finally { working = false; }
    }

    private async Task RegroupCompanionAsync(string companion)
    {
        working = true;
        try
        {
            var result = await Api.RegroupQuestingCompanionAsync(
                new(leaderName, companion));
            operationSucceeded = true;
            message = result?.Message ?? $"{companion} was regrouped.";
            status = await Api.GetQuestingCompanionsAsync(leaderName);
        }
        catch (Exception exception)
        {
            operationSucceeded = false;
            message = exception.Message;
        }
        finally { working = false; }
    }

    private async Task SetEquipmentProtectionAsync(
        QuestingCompanionEquipmentProtectionRequest request)
    {
        working = true;
        try
        {
            var scopedRequest = request with { LeaderName = leaderName };
            var result = await Api.SetQuestingCompanionEquipmentProtectionAsync(
                scopedRequest);
            operationSucceeded = true;
            message = result?.Message;
            status = await Api.GetQuestingCompanionsAsync(leaderName);
        }
        catch (Exception exception)
        {
            operationSucceeded = false;
            message = exception.Message;
        }
        finally { working = false; }
    }

    private static string ClassName(int value) => value switch
    {
        1 => "Warrior", 2 => "Paladin", 3 => "Hunter", 4 => "Rogue",
        5 => "Priest", 6 => "Death Knight", 7 => "Shaman", 8 => "Mage",
        9 => "Warlock", 11 => "Druid", _ => $"Class {value}"
    };

    private async Task RefreshLoopAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (working || string.IsNullOrWhiteSpace(leaderName)
                    || status?.ActiveCompanions.Count == 0)
                    continue;

                await InvokeAsync(async () =>
                {
                    if (working || string.IsNullOrWhiteSpace(leaderName))
                        return;
                    try
                    {
                        players = await Api.GetAdministrationPlayersAsync();
                        try { realmRoster = await Api.GetRealmRosterAsync(); } catch { }
                        var leaderOnline = players.Any(player => !player.IsPlayerBot
                            && player.Online && player.Name.Equals(leaderName,
                                StringComparison.OrdinalIgnoreCase));
                        if (leaderOnline)
                            status = await Api.GetQuestingCompanionsAsync(leaderName);
                        else if (CurrentSession is null)
                        {
                            leaderName = "";
                            status = null;
                        }
                        operationSucceeded = true;
                        message = null;
                        StateHasChanged();
                    }
                    catch
                    {
                        // Keep the last useful snapshot; manual refresh reports errors.
                    }
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        SelectedCharacterStore.SelectionChanged -= OnHeaderSelectionChanged;
        SelectedCharacterStore.SelectedCharactersChanged -= OnHeaderCharactersChanged;
        await refreshCancellation.CancelAsync();
        if (refreshLoop is not null)
            await refreshLoop;
        refreshCancellation.Dispose();
    }

}
