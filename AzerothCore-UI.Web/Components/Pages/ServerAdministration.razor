@page "/server"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "server.control")]
@using AzerothCore_UI.Web.Models
@inject AzerothCore_UI.Web.Clients.AccountsApiClient AccountsClient

<PageTitle>Server administration</PageTitle>

<p class="text-muted">Local lifecycle controls and server configuration.</p>

@if (isLoading)
{
    <p><em>Checking server status...</em></p>
}
else if (status is null)
{
    <div class="alert alert-danger">@errorMessage</div>
}
else
{
    @if (errorMessage is not null)
    {
        <div class="alert alert-warning">@errorMessage</div>
    }
    @if (resultMessage is not null)
    {
        <div class="alert @(operationSucceeded ? "alert-success" : "alert-danger")">@resultMessage</div>
    }

    <div class="row g-3 mb-4">
        @foreach (var process in new[] { status.WorldServer, status.AuthServer })
        {
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <h2 class="h5">@process.Name</h2>
                            <span class="badge @(process.IsRunning ? "text-bg-success" : "text-bg-secondary")">
                                @(process.IsRunning ? "Running" : "Stopped")
                            </span>
                        </div>
                        <div>PID: @(process.ProcessId?.ToString() ?? "—")</div>
                        <div>Started: @(process.StartedAt?.ToLocalTime().ToString("g") ?? "—")</div>
                        <div>Memory: @FormatBytes(process.WorkingSetBytes)</div>
                    </div>
                </div>
            </div>
        }
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h2 class="h5 mb-0">Online population</h2>
                        <strong>@status.Population.Total / @status.PlayerLimit</strong>
                    </div>
                    <div class="progress mb-2" role="progressbar" aria-label="Online population"
                         aria-valuenow="@PopulationPercent" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar" style="width: @PopulationPercent%"></div>
                    </div>
                    <span class="me-3">Humans: <strong>@status.Population.HumanPlayers</strong></span>
                    <span>PlayerBots: <strong>@status.Population.PlayerBots</strong></span>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2 mb-4">
        <button class="btn btn-success" disabled="@isWorking" @onclick="StartAsync">Start</button>
        <button class="btn btn-warning" disabled="@(!CanStop)" @onclick="RestartAsync">Restart</button>
        <button class="btn btn-danger" disabled="@(!CanStop)" @onclick="StopAsync">Stop</button>
        <button class="btn btn-outline-secondary" disabled="@isWorking" @onclick="RefreshAsync">Refresh</button>
        <div class="form-check align-self-center ms-2">
            <input id="force-stop" class="form-check-input" type="checkbox" @bind="forceStop" />
            <label class="form-check-label" for="force-stop">Allow forced stop if graceful shutdown fails</label>
        </div>
    </div>

    <div class="alert @(status.SoapReachable || (status.SoapConfigured && !status.WorldServer.IsRunning) ? "alert-success" : "alert-warning")">
        SOAP: @(status.SoapReachable
            ? "Connected"
            : !status.SoapConfigured
                ? "Credentials not configured"
                : !status.WorldServer.IsRunning
                    ? "Configured; available when worldserver is running"
                    : "Configured but unavailable")
    </div>

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item"><button class="nav-link @(activeView == "PlayerBots" ? "active" : null)" @onclick='() => activeView = "PlayerBots"'>PlayerBots settings</button></li>
        <li class="nav-item"><button class="nav-link @(activeView == "Rates" ? "active" : null)" @onclick='() => activeView = "Rates"'>Gameplay rates</button></li>
        <li class="nav-item"><button class="nav-link @(activeView == "Logs" ? "active" : null)" @onclick='() => activeView = "Logs"'>Recent logs</button></li>
    </ul>

    @if (activeView == "PlayerBots")
    {
        @if (playerBotSettings is null)
        {
            <div class="alert alert-warning">PlayerBots configuration could not be loaded.</div>
        }
        else
        {
            <div class="alert alert-info">
                Changes are validated by the API and backed up before saving. A worldserver restart is required to apply them.
            </div>
            <div class="card"><div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-check form-switch mb-3">
                            <input id="bots-enabled" class="form-check-input" type="checkbox" @bind="playerBotSettings.Enabled" />
                            <label class="form-check-label" for="bots-enabled">Enable PlayerBots</label>
                        </div>
                        <div class="form-check form-switch mb-3">
                            <input id="bots-autologin" class="form-check-input" type="checkbox" @bind="playerBotSettings.RandomBotAutologin" />
                            <label class="form-check-label" for="bots-autologin">Automatically log in random bots</label>
                        </div>
                        <label class="form-label" for="min-bots">Minimum random bots</label>
                        <input id="min-bots" class="form-control mb-3" type="number" min="0" max="5000" @bind="playerBotSettings.MinRandomBots" />
                        <label class="form-label" for="max-bots">Maximum random bots</label>
                        <input id="max-bots" class="form-control" type="number" min="0" max="5000" @bind="playerBotSettings.MaxRandomBots" />
                        <div class="form-text">Supported range: 0&ndash;5,000. Large bot populations can use substantial CPU and memory.</div>
                        @if (PlayerBotValidationMessage is not null)
                        {
                            <div class="invalid-feedback d-block">@PlayerBotValidationMessage</div>
                        }
                    </div>
                    <div class="col-md-6">
                        <div class="row g-2 mb-3">
                            <div class="col-6"><label class="form-label" for="min-level">Minimum level</label><input id="min-level" class="form-control" type="number" min="1" max="80" @bind="playerBotSettings.MinLevel" /></div>
                            <div class="col-6"><label class="form-label" for="max-level">Maximum level</label><input id="max-level" class="form-control" type="number" min="1" max="80" @bind="playerBotSettings.MaxLevel" /></div>
                        </div>
                        <div class="form-check form-switch mb-3"><input id="bots-lfg" class="form-check-input" type="checkbox" @bind="playerBotSettings.JoinLfg" /><label class="form-check-label" for="bots-lfg">Participate in dungeon finder</label></div>
                        <div class="form-check form-switch mb-3"><input id="bots-bg" class="form-check-input" type="checkbox" @bind="playerBotSettings.JoinBattlegrounds" /><label class="form-check-label" for="bots-bg">Participate in battlegrounds</label></div>
                        <div class="form-check form-switch"><input id="bots-trading" class="form-check-input" type="checkbox" @bind="playerBotSettings.EnableTrading" /><label class="form-check-label" for="bots-trading">Allow random-bot trading</label></div>
                    </div>
                </div>
                <hr />
                <button class="btn btn-primary" disabled="@(isWorking || !PlayerBotSettingsValid)" @onclick="SavePlayerBotSettingsAsync">Save settings</button>
            </div></div>
        }
    }
    else if (activeView == "Rates")
    {
        @if (gameplayRates is null)
        {
            <div class="alert alert-warning">Gameplay rates could not be loaded.</div>
        }
        else
        {
            <div class="alert alert-info">
                Values are multipliers: <strong>1</strong> is normal and <strong>2</strong> is double. Changes require a worldserver restart.
            </div>
            <div class="card"><div class="card-body">
                <div class="row g-3">
                    <div class="col-sm-6 col-lg-3"><label class="form-label" for="rate-kill-xp">Kill XP</label><div class="input-group"><input id="rate-kill-xp" class="form-control" type="number" min="0" max="100" step="0.1" @bind="gameplayRates.KillXp" /><span class="input-group-text">&times;</span></div></div>
                    <div class="col-sm-6 col-lg-3"><label class="form-label" for="rate-quest-xp">Quest XP</label><div class="input-group"><input id="rate-quest-xp" class="form-control" type="number" min="0" max="100" step="0.1" @bind="gameplayRates.QuestXp" /><span class="input-group-text">&times;</span></div></div>
                    <div class="col-sm-6 col-lg-3"><label class="form-label" for="rate-explore-xp">Exploration XP</label><div class="input-group"><input id="rate-explore-xp" class="form-control" type="number" min="0" max="100" step="0.1" @bind="gameplayRates.ExplorationXp" /><span class="input-group-text">&times;</span></div></div>
                    <div class="col-sm-6 col-lg-3"><label class="form-label" for="rate-reputation">Reputation</label><div class="input-group"><input id="rate-reputation" class="form-control" type="number" min="0" max="100" step="0.1" @bind="gameplayRates.Reputation" /><span class="input-group-text">&times;</span></div></div>
                    <div class="col-sm-6 col-lg-3"><label class="form-label" for="rate-drop-money">Money drops</label><div class="input-group"><input id="rate-drop-money" class="form-control" type="number" min="0" max="100" step="0.1" @bind="gameplayRates.MoneyDrops" /><span class="input-group-text">&times;</span></div></div>
                    <div class="col-sm-6 col-lg-3"><label class="form-label" for="rate-quest-money">Quest money</label><div class="input-group"><input id="rate-quest-money" class="form-control" type="number" min="0" max="100" step="0.1" @bind="gameplayRates.QuestMoney" /><span class="input-group-text">&times;</span></div></div>
                    <div class="col-sm-6 col-lg-3"><label class="form-label" for="rate-honor">Honor</label><div class="input-group"><input id="rate-honor" class="form-control" type="number" min="0" max="100" step="0.1" @bind="gameplayRates.Honor" /><span class="input-group-text">&times;</span></div></div>
                    <div class="col-sm-6 col-lg-3"><label class="form-label" for="rate-repair">Repair cost</label><div class="input-group"><input id="rate-repair" class="form-control" type="number" min="0" max="100" step="0.1" @bind="gameplayRates.RepairCost" /><span class="input-group-text">&times;</span></div></div>
                </div>
                <hr />
                <h6>Gathering node abundance</h6>
                <p class="text-muted small">
                    <strong>100%</strong> is the original respawn rate. Higher values make genuine profession-locked nodes return sooner without changing treasure chests. A verified database backup is created before either value changes.
                </p>
                <div class="row g-3">
                    <div class="col-sm-6 col-lg-3">
                        <label class="form-label" for="rate-herb-abundance">Herbs</label>
                        <div class="input-group">
                            <input id="rate-herb-abundance" class="form-control" type="number" min="25" max="500" step="5" @bind="gameplayRates.HerbAbundancePercent" />
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <label class="form-label" for="rate-mining-abundance">Minerals</label>
                        <div class="input-group">
                            <input id="rate-mining-abundance" class="form-control" type="number" min="25" max="500" step="5" @bind="gameplayRates.MiningAbundancePercent" />
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                </div>
                <hr />
                <button class="btn btn-primary" disabled="@(isWorking || !GatheringRatesValid)" @onclick="SaveGameplayRatesAsync">Save rates</button>
            </div></div>
        }
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-striped">
                <thead><tr><th>Source</th><th>Message</th></tr></thead>
                <tbody>
                    @foreach (var entry in status.RecentLogs)
                    {
                        <tr><td>@entry.Source</td><td class="text-break">@entry.Message</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
