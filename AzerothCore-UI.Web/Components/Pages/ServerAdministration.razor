@page "/server"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "server.control")]
@using AzerothCore_UI.Web.Models
@inject AzerothCore_UI.Web.Clients.AccountsApiClient AccountsClient

<PageTitle>@PageHeading</PageTitle>

<h1>@PageHeading</h1>
<p class="text-muted">@PageDescription</p>

@if (isLoading)
{
    <p><em>Checking server status...</em></p>
}
else if (status is null)
{
    <div class="alert alert-danger">@errorMessage</div>
}
else
{
    @if (errorMessage is not null)
    {
        <div class="alert alert-warning">@errorMessage</div>
    }
    @if (resultMessage is not null)
    {
        <div class="alert @(operationSucceeded ? "alert-success" : "alert-danger")">@resultMessage</div>
    }

    @if (!PlayerActionsOnly && !DungeonAssistantOnly)
    {
    <div class="row g-3 mb-4">
        @foreach (var process in new[] { status.WorldServer, status.AuthServer })
        {
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between"><h2 class="h5">@process.Name</h2>
                            <span class="badge @(process.IsRunning ? "text-bg-success" : "text-bg-secondary")">@(process.IsRunning ? "Running" : "Stopped")</span>
                        </div>
                        <div>PID: @(process.ProcessId?.ToString() ?? "—")</div>
                        <div>Started: @(process.StartedAt?.ToLocalTime().ToString("g") ?? "—")</div>
                        <div>Memory: @FormatBytes(process.WorkingSetBytes)</div>
                    </div>
                </div>
            </div>
        }
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h2 class="h5 mb-0">Online population</h2>
                        <strong>@status.Population.Total / @status.PlayerLimit</strong>
                    </div>
                    <div class="progress mb-2" role="progressbar" aria-label="Online population" aria-valuenow="@PopulationPercent" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar" style="width: @PopulationPercent%"></div>
                    </div>
                    <span class="me-3">Humans: <strong>@status.Population.HumanPlayers</strong></span>
                    <span>PlayerBots: <strong>@status.Population.PlayerBots</strong></span>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2 mb-4">
        <button class="btn btn-success" disabled="@isWorking" @onclick="StartAsync">Start</button>
        <button class="btn btn-warning" disabled="@(!CanStop)" @onclick="RestartAsync">Restart</button>
        <button class="btn btn-danger" disabled="@(!CanStop)" @onclick="StopAsync">Stop</button>
        <button class="btn btn-outline-secondary" disabled="@isWorking" @onclick="RefreshAsync">Refresh</button>
        <div class="form-check align-self-center ms-2">
            <input id="force-stop" class="form-check-input" type="checkbox" @bind="forceStop" />
            <label class="form-check-label" for="force-stop">Allow forced stop if graceful shutdown fails</label>
        </div>
    </div>

    <div class="alert @(status.SoapReachable || (status.SoapConfigured && !status.WorldServer.IsRunning) ? "alert-success" : "alert-warning")">
        SOAP: @(status.SoapReachable
            ? "Connected"
            : !status.SoapConfigured
                ? "Credentials not configured"
                : !status.WorldServer.IsRunning
                    ? "Configured; available when worldserver is running"
                    : "Configured but unavailable")
    </div>

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item"><button class="nav-link @(activeView == "PlayerBots" ? "active" : null)" @onclick='() => activeView = "PlayerBots"'>PlayerBots settings</button></li>
        <li class="nav-item"><button class="nav-link @(activeView == "Rates" ? "active" : null)" @onclick='() => activeView = "Rates"'>Gameplay rates</button></li>
        <li class="nav-item"><button class="nav-link @(activeView == "Logs" ? "active" : null)" @onclick='() => activeView = "Logs"'>Recent logs</button></li>
    </ul>
    }

    @if (PlayerActionsOnly || DungeonAssistantOnly)
    {
        @if (!CanUseSoap)
        {
            <div class="alert alert-warning">These tools require the worldserver and SOAP administration connection to be available.</div>
        }
        @if (PlayerActionsOnly)
        {
        @if (batchActionResults.Count > 0)
        {
            <div class="card mb-4"><div class="card-body">
                <h2 class="h5">Batch results</h2>
                <ul class="list-group list-group-flush">
                    @foreach (var result in batchActionResults)
                    {
                        <li class="list-group-item px-0">
                            <span class="badge @(result.Success ? "text-bg-success" : "text-bg-danger") me-2">@(result.Success ? "Success" : "Failed")</span>
                            <strong>@result.PlayerName:</strong> @result.Message
                        </li>
                    }
                </ul>
            </div></div>
        }
        <div class="player-actions-grid">
            <div class="player-action-panel">
                <h2 class="h5">Action targets</h2>
                <CharacterPicker Items="@AdministrationPickerItems" Multiple="true" AllowBots="true"
                                 SelectedValues="@selectedActionPlayerNames"
                                 SelectedValuesChanged="SetSelectedActionPlayers" />
                <div class="form-text mt-2">Applies to items, mail, money, saved-location teleport, move-to-anchor, and speed.</div>
            </div>
            <div class="player-action-panel">
                <h2 class="h5">Give item</h2>
                <div class="input-group mb-2">
                    <input class="form-control" value="@(itemId == 0 ? "No item selected" : $"{selectedItemName} (ID {itemId})")" readonly />
                    <button class="btn btn-outline-secondary" type="button" @onclick="OpenItemPickerAsync">Choose item…</button>
                </div>
                <input class="form-control mb-2" type="number" min="1" max="1000" @bind="quantity" />
                <button class="btn btn-primary" disabled="@(!CanUseSoap || selectedActionPlayerNames.Count == 0)" @onclick="GiveItemAsync">Give item</button>
                <button class="btn btn-outline-primary ms-2" disabled="@(!CanUseSoap || selectedActionPlayerNames.Count == 0)" @onclick="MailItemAsync">Mail item</button>
            </div>
            <div class="player-action-panel">
                <h2 class="h5">Give money</h2>
                <div class="row g-2 mb-2">
                    <div class="col-4">
                        <label class="form-label" for="money-gold">Gold</label>
                        <div class="input-group"><input id="money-gold" class="form-control" type="number" min="0" @bind="moneyGold" /><span class="input-group-text"><img class="money-input-coin" src="images/coins/gold.svg" alt="gold" /></span></div>
                    </div>
                    <div class="col-4">
                        <label class="form-label" for="money-silver">Silver</label>
                        <div class="input-group"><input id="money-silver" class="form-control" type="number" min="0" max="99" @bind="moneySilver" /><span class="input-group-text"><img class="money-input-coin" src="images/coins/silver.svg" alt="silver" /></span></div>
                    </div>
                    <div class="col-4">
                        <label class="form-label" for="money-copper">Copper</label>
                        <div class="input-group"><input id="money-copper" class="form-control" type="number" min="0" max="99" @bind="moneyCopper" /><span class="input-group-text"><img class="money-input-coin" src="images/coins/copper.svg" alt="copper" /></span></div>
                    </div>
                </div>
                <button class="btn btn-primary" disabled="@(!CanUseSoap || selectedActionPlayerNames.Count == 0)" @onclick="GiveMoneyAsync">Send money</button>
                <p class="small text-muted mt-2">Delivered through in-game mail, including to an offline character.</p>
            </div>
            <div class="player-action-panel">
                <h2 class="h5">Teleport</h2>
                <div class="btn-group btn-group-sm mb-2" role="group" aria-label="Teleport destination type">
                    <button type="button" class="btn @(teleportMode == "place" ? "btn-primary" : "btn-outline-primary")"
                            @onclick='() => SetTeleportMode("place")'>Place</button>
                    <button type="button" class="btn @(teleportMode == "npc" ? "btn-primary" : "btn-outline-primary")"
                            @onclick='() => SetTeleportMode("npc")'>NPC</button>
                </div>
                @if (teleportMode == "place")
                {
                <div class="input-group mb-2">
                    <input class="form-control" value="@(string.IsNullOrWhiteSpace(teleportLocation) ? "No location selected" : teleportLocation)" readonly />
                    <button class="btn btn-outline-secondary" type="button" @onclick="OpenLocationPickerAsync">Choose location…</button>
                </div>
                <button class="btn btn-primary"
                        disabled="@(!CanUseSoap || selectedActionPlayerNames.Count == 0 || string.IsNullOrWhiteSpace(teleportLocation))"
                        @onclick="TeleportAsync">Teleport to place</button>
                }
                else
                {
                    <div class="input-group mb-2">
                        <input class="form-control"
                               value="@(selectedTeleportNpc is null ? "No NPC selected" : $"{selectedTeleportNpc.Name} — {MapName(selectedTeleportNpc.MapId)}")"
                               readonly />
                        <button class="btn btn-outline-secondary" type="button"
                                disabled="@(selectedActionPlayerNames.Count == 0)"
                                @onclick="OpenNpcTeleportPickerAsync">Choose NPC…</button>
                    </div>
                    @if (selectedTeleportNpc is not null)
                    {
                        <div class="small text-muted mb-2">
                            @selectedTeleportNpc.Subname
                            · entry @selectedTeleportNpc.CreatureId · spawn @selectedTeleportNpc.SpawnId
                        </div>
                        @if (selectedTeleportNpc.PotentiallyHostile)
                        {
                            <div class="alert alert-danger py-2 mb-2">
                                This NPC may be hostile and could attack or kill the teleported character.
                            </div>
                            <div class="form-check mb-2">
                                <input id="confirm-npc-teleport" class="form-check-input" type="checkbox"
                                       @bind="confirmNpcTeleport" />
                                <label class="form-check-label" for="confirm-npc-teleport">
                                    Confirm teleporting to a potentially hostile NPC
                                </label>
                            </div>
                        }
                    }
                    <button class="btn btn-primary"
                            disabled="@(!CanUseSoap || selectedActionPlayerNames.Count == 0 ||
                                selectedTeleportNpc is null ||
                                (selectedTeleportNpc.PotentiallyHostile && !confirmNpcTeleport))"
                            @onclick="TeleportToNpcAsync">Teleport to NPC</button>
                    @if (npcReturnPlayerNames.Count > 0)
                    {
                        <div class="border rounded p-2 mt-2 small">
                            <div>Return available: @string.Join(", ", npcReturnPlayerNames)</div>
                            <div class="form-check mt-1">
                                <input id="confirm-npc-return" class="form-check-input" type="checkbox"
                                       @bind="confirmNpcReturn" />
                                <label class="form-check-label" for="confirm-npc-return">
                                    Confirm returning players
                                </label>
                            </div>
                            <button class="btn btn-sm btn-outline-secondary mt-1"
                                    disabled="@(!CanUseSoap || !confirmNpcReturn)"
                                    @onclick="ReturnFromNpcAsync">Return players</button>
                        </div>
                    }
                }
            </div>
            <div class="player-action-panel">
                <h2 class="h5">Player-relative movement</h2>
                <label class="form-label">Single anchor player</label>
                <CharacterPicker Items="@AdministrationPickerItems" AllowBots="true"
                                 SelectedValue="@anchorPlayer" SelectedValueChanged="SelectAnchorPlayer" />
                <button class="btn btn-primary" disabled="@(!CanUseSoap || selectedActionPlayerNames.Count == 0 || string.IsNullOrWhiteSpace(anchorPlayer))" @onclick="MoveToPlayerAsync">Move selected players to anchor</button>
                <p class="small text-muted mt-2">All selected action targets and the anchor must be online. The anchor cannot also be a target. Battleground, arena, transport, and unsafe cross-instance movement is rejected.</p>
            </div>
            <div class="player-action-panel">
                <h2 class="h5">Movement speed</h2>
                <label class="form-label" for="player-speed">Speed multiplier</label>
                <div class="input-group mb-2"><input id="player-speed" class="form-control" type="number" min="0.5" max="10" step="0.25" @bind="playerSpeed" /><span class="input-group-text">x</span></div>
                <div class="d-flex flex-wrap gap-2 mb-2">
                    @foreach (var speed in new decimal[] { 0.5m, 1m, 1.5m, 2m, 3m, 5m })
                    {
                        <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="() => playerSpeed = speed">@speed.ToString("0.#")x</button>
                    }
                </div>
                <button class="btn btn-primary" disabled="@(!CanUseSoap || selectedActionPlayerNames.Count == 0)" @onclick="SetPlayerSpeedAsync">Apply speed</button>
                <p class="small text-muted mt-2">Changes walk, run, swim, and flight speed for the current online session. Use 1x to restore normal speed.</p>
            </div>
            <div class="player-action-panel">
                <h2 class="h5">Guild bank</h2>
                <p class="small text-muted">Select one online real-player guild master above, then inspect their guild.</p>
                <button class="btn btn-outline-secondary mb-2"
                        disabled="@(!CanUseSoap || SelectedActionPlayers.Count != 1 || SelectedActionPlayers[0].IsPlayerBot || isLoadingGuildBank)"
                        @onclick="InspectGuildBankAsync">
                    @(isLoadingGuildBank ? "Inspecting…" : "Inspect guild")
                </button>
                @if (guildBank is not null)
                {
                    <div class="border rounded p-3">
                        <div><strong>@guildBank.GuildName</strong></div>
                        <div class="small text-muted">
                            @guildBank.PurchasedTabs / @guildBank.MaximumTabs bank tabs unlocked
                            · selected character: @guildBank.PlayerName
                        </div>
                        @if (!guildBank.IsGuildMaster)
                        {
                            <div class="alert alert-warning py-2 mt-2 mb-0">Only the guild master can unlock a tab.</div>
                        }
                        else if (guildBank.PurchasedTabs >= guildBank.MaximumTabs)
                        {
                            <div class="alert alert-success py-2 mt-2 mb-0">All guild bank tabs are unlocked.</div>
                        }
                        else
                        {
                            <div class="small mt-2">
                                Normal price: @FormatMoney(guildBank.NextTabCostCopper). The admin unlock will not charge the character.
                            </div>
                            <div class="form-check my-2">
                                <input id="confirm-guild-tab" class="form-check-input" type="checkbox"
                                       @bind="confirmGuildTabUnlock" />
                                <label class="form-check-label" for="confirm-guild-tab">
                                    Confirm free unlock of tab @(guildBank.PurchasedTabs + 1)
                                </label>
                            </div>
                            <button class="btn btn-primary" disabled="@(!CanUseSoap || !confirmGuildTabUnlock)"
                                    @onclick="UnlockGuildBankTabAsync">Unlock next tab</button>
                        }
                    </div>
                }
            </div>
            <div class="player-action-panel">
                <h2 class="h5">Summon a useful NPC</h2>
                <p class="small text-muted">
                    Temporarily summon a verified neutral vendor beside one selected online real player.
                    The player must be stationary and out of combat.
                </p>
                <label class="form-label" for="utility-npc">Service</label>
                <select id="utility-npc" class="form-select mb-2" @bind="selectedUtilityNpcId"
                        @bind:after="() => confirmUtilityNpcSummon = false">
                    @foreach (var npc in utilityNpcs)
                    {
                        <option value="@npc.CreatureId">@npc.Service — @npc.Name</option>
                    }
                </select>
                @if (SelectedUtilityNpc is not null)
                {
                    <div class="small text-muted mb-2">@SelectedUtilityNpc.Description</div>
                }
                <label class="form-label" for="utility-npc-despawn">Despawn after</label>
                <div class="input-group mb-2">
                    <input id="utility-npc-despawn" class="form-control" type="number"
                           min="1" max="30" @bind="utilityNpcDespawnMinutes" />
                    <span class="input-group-text">minutes</span>
                </div>
                <div class="form-check mb-2">
                    <input id="confirm-utility-npc" class="form-check-input" type="checkbox"
                           @bind="confirmUtilityNpcSummon" />
                    <label class="form-check-label" for="confirm-utility-npc">
                        Confirm temporary neutral NPC summon
                    </label>
                </div>
                <button class="btn btn-primary"
                        disabled="@(!CanUseSoap || SelectedActionPlayers.Count != 1 ||
                            SelectedActionPlayers[0].IsPlayerBot || SelectedActionPlayers[0].Online != true ||
                            SelectedUtilityNpc is null || utilityNpcDespawnMinutes is < 1 or > 30 ||
                            !confirmUtilityNpcSummon)"
                        @onclick="SummonUtilityNpcAsync">Summon NPC</button>
                <div class="form-text">
                    Service NPCs may be used inside dungeons, but never in battlegrounds or arenas.
                    At most three temporary web-spawned creatures may exist per player.
                </div>
            </div>
        </div>
        }
        @if (DungeonAssistantOnly)
        {
        <div class="card mt-4">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
                    <div class="flex-grow-1">
                        <h2 class="h5">Dungeon party assistance</h2>
                        <label class="form-label" for="party-leader">Online real-player leader</label>
                        <CharacterPicker Items="@AdministrationPickerItems" AllowBots="true"
                                         SelectedValue="@partyLeader" SelectedValueChanged="SelectPartyLeader" />
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-secondary" disabled="@(!CanUseSoap || isLoadingParty)" @onclick="LoadPartyAsync">Inspect party</button>
                        <button class="btn btn-primary" disabled="@(!CanUseSoap || party is null || party.MemberCount >= 5)" @onclick="FillPartyWithBotsAsync">Auto-fill roles</button>
                        <button class="btn btn-outline-danger" disabled="@(!CanUseSoap || party is null || !party.Members.Any(member => member.IsPlayerBot))" @onclick="ClearPartyBotsAsync">Remove all bots</button>
                    </div>
                </div>
                @if (isLoadingParty)
                {
                    <p><em>Inspecting the live party…</em></p>
                }
                else if (party is not null)
                {
                    <div class="row g-4">
                        <div class="col-lg-5">
                            <h3 class="h6">Current party (@party.MemberCount / 5)</h3>
                            <div class="table-responsive"><table class="table table-sm align-middle">
                                <thead><tr><th>Name</th><th>Level</th><th>Role</th><th></th></tr></thead><tbody>
                                @foreach (var member in party.Members)
                                {
                                    <tr><td>@member.Name @(member.IsPlayerBot ? "(Bot)" : "")</td><td>@member.Level</td><td>@member.Role</td>
                                        <td class="text-end">@if (member.IsPlayerBot) { <button class="btn btn-sm btn-outline-danger" disabled="@(!CanUseSoap)" @onclick="() => RemovePartyBotAsync(member.Name)">Remove</button> }</td></tr>
                                }
                                </tbody></table></div>
                        </div>
                        <div class="col-lg-7">
                            <h3 class="h6">Eligible online PlayerBots</h3>
                            <p class="small text-muted">Ungrouped, same faction, and within five levels of the leader.</p>
                            @if (party.Candidates.Count == 0)
                            {
                                <div class="alert alert-secondary">No eligible online bots are currently available.</div>
                            }
                            else
                            {
                                <div class="table-responsive party-candidates"><table class="table table-sm table-hover align-middle">
                                    <thead><tr><th>Name</th><th>Class</th><th>Level</th><th>Role</th><th></th></tr></thead><tbody>
                                    @foreach (var bot in party.Candidates)
                                    {
                                        <tr><td>@bot.Name</td><td>@CharacterClassName(bot.CharacterClass)</td><td>@bot.Level</td><td>@bot.Role</td>
                                            <td class="text-end"><button class="btn btn-sm btn-primary" disabled="@(!CanUseSoap || party.MemberCount >= 5)" @onclick="() => AddPartyBotAsync(bot.Name)">Add</button></td></tr>
                                    }
                                    </tbody></table></div>
                            }
                        </div>
                    </div>
                    <hr class="my-4" />
                    <div class="row g-4">
                        <div class="col-lg-7">
                            <h3 class="h6">Choose a dungeon</h3>
                            <input class="form-control mb-2" placeholder="Start typing a dungeon name" autocomplete="off"
                                   @bind="dungeonSearch" @bind:event="oninput" />
                            @if (dungeons.Count == 0)
                            {
                                <div class="alert alert-secondary">No launchable dungeon entrances were reported by the worldserver.</div>
                            }
                            else if (!FilteredDungeons.Any())
                            {
                                <div class="alert alert-secondary">No dungeon names match that search.</div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover align-middle">
                                        <thead><tr><th>Dungeon</th><th>Difficulty</th><th>Levels</th><th></th></tr></thead>
                                        <tbody>
                                        @foreach (var dungeon in FilteredDungeons)
                                        {
                                            <tr class="@(dungeon.DungeonId == selectedDungeonId ? "table-primary" : null)">
                                                <td>
                                                    @dungeon.Name
                                                    @if (RecommendedDungeonIds.Contains(dungeon.DungeonId))
                                                    {
                                                        <span class="badge text-bg-success ms-1">Recommended</span>
                                                    }
                                                </td>
                                                <td>@dungeon.Difficulty</td>
                                                <td>@dungeon.MinimumLevel&ndash;@dungeon.MaximumLevel</td>
                                                <td class="text-end">
                                                    <button class="btn btn-sm @(dungeon.DungeonId == selectedDungeonId ? "btn-primary" : "btn-outline-primary")"
                                                            type="button" @onclick="() => SelectDungeonAsync(dungeon.DungeonId)">
                                                        @(dungeon.DungeonId == selectedDungeonId ? "Selected" : "Select")
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                        <div class="col-lg-5">
                            <h3 class="h6">Launch party</h3>
                            @if (SelectedDungeon is null)
                            {
                                <div class="alert alert-secondary">Select a dungeon to review the launch.</div>
                            }
                            else
                            {
                                <dl class="row small mb-3">
                                    <dt class="col-5">Destination</dt><dd class="col-7">@SelectedDungeon.Name</dd>
                                    <dt class="col-5">Difficulty</dt><dd class="col-7">@SelectedDungeon.Difficulty</dd>
                                    <dt class="col-5">Level range</dt><dd class="col-7">@SelectedDungeon.MinimumLevel&ndash;@SelectedDungeon.MaximumLevel</dd>
                                    <dt class="col-5">Map</dt><dd class="col-7">@SelectedDungeon.MapId</dd>
                                </dl>
                                @if (isLoadingReadiness)
                                {
                                    <div class="alert alert-info small">Checking party roles, lockouts, and quests…</div>
                                }
                                else if (dungeonReadiness is not null)
                                {
                                    <div class="d-flex flex-wrap gap-2 mb-3">
                                        <span class="badge @(dungeonReadiness.HasTank ? "text-bg-success" : "text-bg-warning")">
                                            @(dungeonReadiness.HasTank ? "Tank ready" : "Tank missing")
                                        </span>
                                        <span class="badge @(dungeonReadiness.HasHealer ? "text-bg-success" : "text-bg-warning")">
                                            @(dungeonReadiness.HasHealer ? "Healer ready" : "Healer missing")
                                        </span>
                                        <span class="badge @(dungeonReadiness.DamageCount >= 3 ? "text-bg-success" : "text-bg-warning")">
                                            @dungeonReadiness.DamageCount / 3 damage
                                        </span>
                                        <span class="badge @(dungeonReadiness.PartyFull ? "text-bg-success" : "text-bg-secondary")">
                                            @(dungeonReadiness.PartyFull ? "Party full" : $"{party.MemberCount} / 5 members")
                                        </span>
                                    </div>
                                    @if (dungeonReadiness.Lockouts.Count > 0)
                                    {
                                        <div class="alert alert-warning small">
                                            <strong>Active lockouts:</strong>
                                            @foreach (var lockout in dungeonReadiness.Lockouts)
                                            {
                                                <div>@lockout.PlayerName — difficulty @lockout.Difficulty, resets @lockout.ResetAtUtc.ToLocalTime().ToString("g")</div>
                                            }
                                        </div>
                                    }
                                    @if (dungeonReadiness.RelevantQuests.Count > 0)
                                    {
                                        <details class="mb-3">
                                            <summary class="small fw-semibold">@dungeonReadiness.RelevantQuests.Count relevant dungeon quests</summary>
                                            <div class="small mt-2">
                                                @foreach (var quest in dungeonReadiness.RelevantQuests)
                                                {
                                                    var eligiblePlayers = quest.PlayerStatuses
                                                        .Where(playerStatus => playerStatus.CanTeleport).ToArray();
                                                    var prerequisitePlayers = quest.PlayerStatuses
                                                        .Where(playerStatus => playerStatus.Status == "MissingPrerequisite").ToArray();
                                                    <div class="border rounded p-2 mb-2">
                                                        <div class="fw-semibold">
                                                            @quest.Title <span class="text-muted fw-normal">(#@quest.QuestId, level @quest.MinimumLevel)</span>
                                                        </div>
                                                        @if (quest.QuestGiver is not null)
                                                        {
                                                            <div class="text-muted">
                                                                Quest giver: @quest.QuestGiver.Name
                                                                (map @quest.QuestGiver.MapId, zone @quest.QuestGiver.ZoneId)
                                                            </div>
                                                        }
                                                        @foreach (var playerStatus in quest.PlayerStatuses)
                                                        {
                                                            <div class="d-flex flex-wrap align-items-center gap-1 mt-1">
                                                                <span class="fw-semibold">@playerStatus.PlayerName</span>
                                                                <span class="badge @QuestStatusBadgeClass(playerStatus.Status)">
                                                                    @QuestStatusLabel(playerStatus.Status)
                                                                </span>
                                                                <span class="text-muted">@playerStatus.Detail</span>
                                                            </div>
                                                        }
                                                        @if (quest.Prerequisite is not null && prerequisitePlayers.Length > 0)
                                                        {
                                                            <div class="border-start border-warning border-3 ps-2 mt-2">
                                                                <div>
                                                                    Required first: <strong>@quest.Prerequisite.Title</strong>
                                                                    <span class="text-muted">(#@quest.Prerequisite.QuestId)</span>
                                                                </div>
                                                                @if (quest.Prerequisite.QuestGiver is not null)
                                                                {
                                                                    <div class="text-muted">
                                                                        Quest giver: @quest.Prerequisite.QuestGiver.Name
                                                                        (map @quest.Prerequisite.QuestGiver.MapId,
                                                                        zone @quest.Prerequisite.QuestGiver.ZoneId)
                                                                    </div>
                                                                    <div class="form-check mt-1">
                                                                        <input id="confirm-prerequisite-@quest.QuestId" class="form-check-input"
                                                                               type="checkbox"
                                                                               checked="@confirmedQuestTeleports.Contains(quest.Prerequisite.QuestId)"
                                                                               @onchange="eventArgs => SetQuestTeleportConfirmation(
                                                                                   quest.Prerequisite.QuestId, eventArgs.Value is true)" />
                                                                        <label class="form-check-label" for="confirm-prerequisite-@quest.QuestId">
                                                                            Confirm teleporting @string.Join(", ",
                                                                                prerequisitePlayers.Select(playerStatus => playerStatus.PlayerName))
                                                                        </label>
                                                                    </div>
                                                                    <button class="btn btn-sm btn-outline-warning mt-1" type="button"
                                                                            disabled="@(!CanUseSoap ||
                                                                                !confirmedQuestTeleports.Contains(quest.Prerequisite.QuestId))"
                                                                            @onclick="() => TeleportToPrerequisiteGiverAsync(quest)">
                                                                        Teleport to prerequisite quest giver
                                                                    </button>
                                                                }
                                                                else
                                                                {
                                                                    <div class="text-muted">No compatible NPC giver was found for this prerequisite.</div>
                                                                }
                                                            </div>
                                                        }
                                                        @if (quest.QuestGiver is not null && eligiblePlayers.Length > 0)
                                                        {
                                                            <div class="form-check mt-2">
                                                                <input id="confirm-quest-@quest.QuestId" class="form-check-input"
                                                                       type="checkbox"
                                                                       checked="@confirmedQuestTeleports.Contains(quest.QuestId)"
                                                                       @onchange="eventArgs => SetQuestTeleportConfirmation(
                                                                           quest.QuestId, eventArgs.Value is true)" />
                                                                <label class="form-check-label" for="confirm-quest-@quest.QuestId">
                                                                    Confirm teleporting @string.Join(", ", eligiblePlayers.Select(playerStatus => playerStatus.PlayerName))
                                                                </label>
                                                            </div>
                                                            <button class="btn btn-sm btn-outline-primary mt-1" type="button"
                                                                    disabled="@(!CanUseSoap || !confirmedQuestTeleports.Contains(quest.QuestId))"
                                                                    @onclick="() => TeleportToQuestGiverAsync(quest)">
                                                                Teleport eligible players to quest giver
                                                            </button>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </details>
                                    }
                                    @if (questReturnPlayerNames.Count > 0)
                                    {
                                        <div class="border rounded p-2 mb-3 small">
                                            <div class="fw-semibold">Quest-giver return available</div>
                                            <div class="text-muted">@string.Join(", ", questReturnPlayerNames)</div>
                                            <div class="form-check mt-2">
                                                <input id="confirm-quest-return" class="form-check-input"
                                                       type="checkbox" @bind="confirmQuestReturn" />
                                                <label class="form-check-label" for="confirm-quest-return">
                                                    Confirm returning these players to their saved locations
                                                </label>
                                            </div>
                                            <button class="btn btn-sm btn-outline-secondary mt-1" type="button"
                                                    disabled="@(!CanUseSoap || !confirmQuestReturn)"
                                                    @onclick="ReturnFromQuestGiverAsync">
                                                Return players
                                            </button>
                                        </div>
                                    }
                                }
                                @if (PartyHasLevelWarning)
                                {
                                    <div class="alert alert-warning small">
                                        At least one party member is outside this dungeon's recommended level range.
                                    </div>
                                }
                                <p class="small text-muted">
                                    All @party.MemberCount current party members must be online and in a safe state. The worldserver checks the complete party before moving it.
                                </p>
                                <div class="form-check mb-3">
                                    <input id="confirm-dungeon-launch" class="form-check-input" type="checkbox" @bind="confirmDungeonLaunch" />
                                    <label class="form-check-label" for="confirm-dungeon-launch">
                                        Confirm moving the whole party to @SelectedDungeon.Name
                                    </label>
                                </div>
                                <button class="btn btn-success" type="button"
                                        disabled="@(!CanUseSoap || !confirmDungeonLaunch)" @onclick="LaunchPartyAsync">
                                    Launch party
                                </button>
                            }
                        </div>
                    </div>
                    @if (dungeonGuide is not null)
                    {
                        <div class="card mt-4 border-info">
                            <div class="card-header d-flex flex-wrap justify-content-between gap-2 align-items-center">
                                <strong>Guide &amp; boss loot</strong>
                                <div class="form-check form-switch mb-0">
                                    <input id="party-loot-only" class="form-check-input"
                                           type="checkbox" @bind="showPartyLootOnly" />
                                    <label class="form-check-label small" for="party-loot-only">
                                        Party-relevant loot only
                                    </label>
                                </div>
                            </div>
                            <div class="card-body">
                                <p>@dungeonGuide.Overview</p>
                                <div class="alert alert-secondary small">
                                    <strong>Recommended route:</strong> @dungeonGuide.Route
                                </div>
                                @if (dungeonGuide.ImportantNotes.Count > 0)
                                {
                                    <ul class="small">
                                        @foreach (var note in dungeonGuide.ImportantNotes)
                                        {
                                            <li>@note</li>
                                        }
                                    </ul>
                                }
                                @if (dungeonGuide.Bosses.Count == 0)
                                {
                                    <div class="alert alert-warning small mb-0">
                                        This server has no ordered encounter records for this destination.
                                    </div>
                                }
                                else
                                {
                                    <div class="accordion" id="dungeon-boss-guide">
                                        @foreach (var boss in dungeonGuide.Bosses)
                                        {
                                            var visibleLoot = boss.Loot
                                                .Where(item => !showPartyLootOnly || item.SuggestedForParty)
                                                .ToArray();
                                            <details class="border rounded mb-2"
                                                     open="@(boss.Order == 1)">
                                                <summary class="p-2 fw-semibold">
                                                    @boss.Order. @boss.Name
                                                    <span class="badge text-bg-secondary ms-1">
                                                        @visibleLoot.Length loot
                                                    </span>
                                                </summary>
                                                <div class="border-top p-3">
                                                    <p class="small">@boss.Tactics</p>
                                                    @if (visibleLoot.Length == 0)
                                                    {
                                                        <div class="small text-muted">
                                                            @(showPartyLootOnly
                                                                ? "No party-relevant uncommon-or-better drops were found. Disable the filter to see all boss loot."
                                                                : "No uncommon-or-better drops were found in the current world database.")
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="table-responsive">
                                                            <table class="table table-sm align-middle mb-0">
                                                                <thead>
                                                                <tr>
                                                                    <th>Item</th>
                                                                    <th>Required</th>
                                                                    <th>Item level</th>
                                                                    <th>Drop</th>
                                                                </tr>
                                                                </thead>
                                                                <tbody>
                                                                @foreach (var item in visibleLoot)
                                                                {
                                                                    <tr>
                                                                        <td>
                                                                            <span class="@LootQualityClass(item.Quality)">
                                                                                @item.Name
                                                                            </span>
                                                                            <span class="text-muted small"> #@item.ItemId</span>
                                                                            @if (item.QuestRequired)
                                                                            {
                                                                                <span class="badge text-bg-warning ms-1">Quest</span>
                                                                            }
                                                                            <DungeonLootStats Item="item" />
                                                                        </td>
                                                                        <td>@(item.RequiredLevel > 0 ? item.RequiredLevel.ToString() : "—")</td>
                                                                        <td>@item.ItemLevel</td>
                                                                        <td>
                                                                            @(item.DropChance > 0
                                                                                ? $"{item.DropChance:0.##}%"
                                                                                : "Loot group")
                                                                        </td>
                                                                    </tr>
                                                                }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    }
                                                </div>
                                            </details>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
        }
    }
    else if (activeView == "PlayerBots")
    {
        @if (playerBotSettings is null)
        {
            <div class="alert alert-warning">PlayerBots configuration could not be loaded.</div>
        }
        else
        {
            <div class="alert alert-info">
                Changes are validated by the API and backed up before saving. A worldserver restart is required to apply them.
            </div>
            <div class="card">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-check form-switch mb-3">
                                <input id="bots-enabled" class="form-check-input" type="checkbox" @bind="playerBotSettings.Enabled" />
                                <label class="form-check-label" for="bots-enabled">Enable PlayerBots</label>
                            </div>
                            <div class="form-check form-switch mb-3">
                                <input id="bots-autologin" class="form-check-input" type="checkbox" @bind="playerBotSettings.RandomBotAutologin" />
                                <label class="form-check-label" for="bots-autologin">Automatically log in random bots</label>
                            </div>
                            <label class="form-label" for="min-bots">Minimum random bots</label>
                            <input id="min-bots" class="form-control mb-3" type="number" min="0" max="5000" @bind="playerBotSettings.MinRandomBots" />
                            <label class="form-label" for="max-bots">Maximum random bots</label>
                            <input id="max-bots" class="form-control" type="number" min="0" max="5000" @bind="playerBotSettings.MaxRandomBots" />
                            <div class="form-text">Supported range: 0&ndash;5,000. Large bot populations can use substantial CPU and memory.</div>
                            @if (PlayerBotValidationMessage is not null)
                            {
                                <div class="invalid-feedback d-block">@PlayerBotValidationMessage</div>
                            }
                        </div>
                        <div class="col-md-6">
                            <div class="row g-2 mb-3">
                                <div class="col-6"><label class="form-label" for="min-level">Minimum level</label><input id="min-level" class="form-control" type="number" min="1" max="80" @bind="playerBotSettings.MinLevel" /></div>
                                <div class="col-6"><label class="form-label" for="max-level">Maximum level</label><input id="max-level" class="form-control" type="number" min="1" max="80" @bind="playerBotSettings.MaxLevel" /></div>
                            </div>
                            <div class="form-check form-switch mb-3"><input id="bots-lfg" class="form-check-input" type="checkbox" @bind="playerBotSettings.JoinLfg" /><label class="form-check-label" for="bots-lfg">Participate in dungeon finder</label></div>
                            <div class="form-check form-switch mb-3"><input id="bots-bg" class="form-check-input" type="checkbox" @bind="playerBotSettings.JoinBattlegrounds" /><label class="form-check-label" for="bots-bg">Participate in battlegrounds</label></div>
                            <div class="form-check form-switch"><input id="bots-trading" class="form-check-input" type="checkbox" @bind="playerBotSettings.EnableTrading" /><label class="form-check-label" for="bots-trading">Allow random-bot trading</label></div>
                        </div>
                    </div>
                    <hr />
                    <button class="btn btn-primary" disabled="@(isWorking || !PlayerBotSettingsValid)" @onclick="SavePlayerBotSettingsAsync">Save settings</button>
                </div>
            </div>
        }
    }
    else if (activeView == "Rates")
    {
        @if (gameplayRates is null)
        {
            <div class="alert alert-warning">Gameplay rates could not be loaded.</div>
        }
        else
        {
            <div class="alert alert-info">
                Values are multipliers: <strong>1</strong> is the normal rate and <strong>2</strong> is double. Changes require a worldserver restart.
            </div>
            <div class="card">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-sm-6 col-lg-3"><label class="form-label" for="rate-kill-xp">Kill XP</label><div class="input-group"><input id="rate-kill-xp" class="form-control" type="number" min="0" max="100" step="0.1" @bind="gameplayRates.KillXp" /><span class="input-group-text">×</span></div></div>
                        <div class="col-sm-6 col-lg-3"><label class="form-label" for="rate-quest-xp">Quest XP</label><div class="input-group"><input id="rate-quest-xp" class="form-control" type="number" min="0" max="100" step="0.1" @bind="gameplayRates.QuestXp" /><span class="input-group-text">×</span></div></div>
                        <div class="col-sm-6 col-lg-3"><label class="form-label" for="rate-explore-xp">Exploration XP</label><div class="input-group"><input id="rate-explore-xp" class="form-control" type="number" min="0" max="100" step="0.1" @bind="gameplayRates.ExplorationXp" /><span class="input-group-text">×</span></div></div>
                        <div class="col-sm-6 col-lg-3"><label class="form-label" for="rate-reputation">Reputation</label><div class="input-group"><input id="rate-reputation" class="form-control" type="number" min="0" max="100" step="0.1" @bind="gameplayRates.Reputation" /><span class="input-group-text">×</span></div></div>
                        <div class="col-sm-6 col-lg-3"><label class="form-label" for="rate-drop-money">Money drops</label><div class="input-group"><input id="rate-drop-money" class="form-control" type="number" min="0" max="100" step="0.1" @bind="gameplayRates.MoneyDrops" /><span class="input-group-text">×</span></div></div>
                        <div class="col-sm-6 col-lg-3"><label class="form-label" for="rate-quest-money">Quest money</label><div class="input-group"><input id="rate-quest-money" class="form-control" type="number" min="0" max="100" step="0.1" @bind="gameplayRates.QuestMoney" /><span class="input-group-text">×</span></div></div>
                        <div class="col-sm-6 col-lg-3"><label class="form-label" for="rate-honor">Honor</label><div class="input-group"><input id="rate-honor" class="form-control" type="number" min="0" max="100" step="0.1" @bind="gameplayRates.Honor" /><span class="input-group-text">×</span></div></div>
                        <div class="col-sm-6 col-lg-3"><label class="form-label" for="rate-repair">Repair cost</label><div class="input-group"><input id="rate-repair" class="form-control" type="number" min="0" max="100" step="0.1" @bind="gameplayRates.RepairCost" /><span class="input-group-text">×</span></div></div>
                    </div>
                    <hr />
                    <button class="btn btn-primary" disabled="@isWorking" @onclick="SaveGameplayRatesAsync">Save rates</button>
                </div>
            </div>
        }
    }
    else
    {
        <div class="table-responsive"><table class="table table-sm table-striped"><thead><tr><th>Source</th><th>Message</th></tr></thead><tbody>
        @foreach (var entry in status.RecentLogs) { <tr><td>@entry.Source</td><td class="text-break">@entry.Message</td></tr> }
        </tbody></table></div>
    }

    @if (showItemPicker)
    {
        <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="item-picker-title">
            <div class="modal-dialog modal-xl modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title h5" id="item-picker-title">Choose an item</h2>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="() => showItemPicker = false"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-2 mb-2">
                            <div class="col-lg-4 col-md-6">
                                <label class="form-label" for="item-search">Item name</label>
                                <input id="item-search" class="form-control" value="@itemSearch" @oninput="OnItemSearchAsync" placeholder="Start typing an item name…" autocomplete="off" autofocus />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="item-category">Category</label>
                                <select id="item-category" class="form-select" @bind="itemCategory" @bind:after="OnItemCategoryChangedAsync">
                                    <option value="all">All items</option><option value="weapons">Weapons</option><option value="armor">Armor</option>
                                    <option value="potions">Potions</option><option value="elixirs">Elixirs</option><option value="flasks">Flasks</option>
                                    <option value="scrolls">Scrolls</option><option value="food">Food &amp; drink</option><option value="bags">Bags</option>
                                    <option value="gems">Gems</option><option value="reagents">Reagents</option><option value="trade-goods">Trade goods</option>
                                    <option value="recipes">Recipes</option><option value="quest">Quest items</option><option value="glyphs">Glyphs</option>
                                    <option value="miscellaneous">Miscellaneous</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label" for="item-quality">Quality</label>
                                <select id="item-quality" class="form-select" @bind="itemQuality" @bind:after="OnItemFiltersChangedAsync">
                                    <option value="">All</option>
                                    <option value="0">Poor</option><option value="1">Common</option>
                                    <option value="2">Uncommon</option><option value="3">Rare</option>
                                    <option value="4">Epic</option><option value="5">Legendary</option>
                                    <option value="6">Artifact</option><option value="7">Heirloom</option>
                                </select>
                            </div>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-lg-4 col-md-6">
                                <label class="form-label">Item level range</label>
                                <div class="input-group">
                                    <span class="input-group-text">≥</span>
                                    <InputNumber class="form-control" @bind-Value="minimumItemLevel" @bind-Value:after="OnItemFiltersChangedAsync" min="0" placeholder="Min" aria-label="Minimum item level" />
                                    <span class="input-group-text">≤</span>
                                    <InputNumber class="form-control" @bind-Value="maximumItemLevel" @bind-Value:after="OnItemFiltersChangedAsync" min="0" placeholder="Max" aria-label="Maximum item level" />
                                </div>
                            </div>
                            <div class="col-lg-4 col-md-6">
                                <label class="form-label">Required level range</label>
                                <div class="input-group">
                                    <span class="input-group-text">≥</span>
                                    <InputNumber class="form-control" @bind-Value="minimumRequiredLevel" @bind-Value:after="OnItemFiltersChangedAsync" min="0" max="255" placeholder="Min" aria-label="Minimum required level" />
                                    <span class="input-group-text">≤</span>
                                    <InputNumber class="form-control" @bind-Value="maximumRequiredLevel" @bind-Value:after="OnItemFiltersChangedAsync" min="0" max="255" placeholder="Max" aria-label="Maximum required level" />
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <label class="form-label" for="item-suitability">Selected-character suitability</label>
                                <select id="item-suitability" class="form-select" @bind="itemSuitability" @bind:after="OnItemFiltersChangedAsync"
                                        disabled="@(selectedActionPlayerNames.Count == 0)">
                                    <option value="all">Suitable for every target</option>
                                    <option value="any">Suitable for at least one target</option>
                                    <option value="off">Do not filter by targets</option>
                                </select>
                                <div class="form-text">
                                    @(selectedActionPlayerNames.Count == 0
                                        ? "Select action targets to enable this filter."
                                        : $"{selectedActionPlayerNames.Count} action target(s) selected.")
                                </div>
                            </div>
                        </div>
                        @if (isLoadingItems)
                        {
                            <p><em>Searching items…</em></p>
                        }
                        else if (itemResults.Items.Count == 0)
                        {
                            <div class="alert alert-secondary">No matching items were found.</div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead><tr><th>Name</th><th>ID</th><th>Quality</th><th>Item level</th><th>Required level</th><th>Targets</th></tr></thead>
                                    <tbody>
                                    @foreach (var item in itemResults.Items)
                                    {
                                        <tr class="picker-result-row" tabindex="0" role="button"
                                            aria-label="Select @item.Name"
                                            @onclick="() => SelectItem(item)"
                                            @onkeydown="args => SelectItemFromKeyboard(args, item)">
                                            <td class="fw-semibold @ItemQualityClass(item.Quality)">@item.Name</td>
                                            <td>@item.ItemId</td><td>@ItemQualityName(item.Quality)</td><td>@item.ItemLevel</td><td>@item.RequiredLevel</td>
                                            <td>
                                                @if (item.TargetCount == 0)
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                                else
                                                {
                                                    <span class="badge @(item.SuitableTargetCount == item.TargetCount ? "text-bg-success" : item.SuitableTargetCount > 0 ? "text-bg-warning" : "text-bg-danger")"
                                                          title="Suitable: @string.Join(", ", item.SuitableTargetNames). Incompatible: @string.Join(", ", item.IncompatibleTargetNames)">
                                                        @item.SuitableTargetCount/@item.TargetCount suitable
                                                    </span>
                                                    @if (item.LikelyUpgradeTargetCount > 0)
                                                    {
                                                        <span class="badge text-bg-primary ms-1">Upgrade for @item.LikelyUpgradeTargetCount</span>
                                                    }
                                                    @if (item.Quality == 7)
                                                    {
                                                        <span class="badge text-bg-info ms-1">Heirloom</span>
                                                    }
                                                }
                                            </td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                    <div class="modal-footer justify-content-between">
                        <span class="text-muted">@itemResults.TotalCount matching items</span>
                        <div>
                            <button class="btn btn-outline-secondary me-2" disabled="@(isLoadingItems || itemResults.Page <= 1)" @onclick="() => LoadItemsAsync(itemResults.Page - 1)">Previous</button>
                            <span class="me-2">Page @itemResults.Page of @Math.Max(1, itemResults.TotalPages)</span>
                            <button class="btn btn-outline-secondary" disabled="@(isLoadingItems || itemResults.Page >= itemResults.TotalPages)" @onclick="() => LoadItemsAsync(itemResults.Page + 1)">Next</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop show"></div>
    }

    @if (showNpcTeleportPicker)
    {
        <div class="modal show d-block" tabindex="-1" role="dialog" aria-modal="true"
             aria-labelledby="npc-teleport-picker-title">
            <div class="modal-dialog modal-xl modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title h5" id="npc-teleport-picker-title">Choose an NPC</h2>
                        <button type="button" class="btn-close" aria-label="Close"
                                @onclick="() => showNpcTeleportPicker = false"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label" for="npc-teleport-search">NPC name</label>
                        <input id="npc-teleport-search" class="form-control mb-3"
                               value="@npcTeleportSearch" @oninput="OnNpcTeleportSearchAsync"
                               placeholder="Type at least two characters…" autocomplete="off" autofocus />
                        <div class="form-text mb-3">
                            Results are ranked from @SelectedActionPlayers.FirstOrDefault()?.Name.
                            Potentially hostile NPCs are allowed with explicit confirmation.
                            Instance NPCs remain unavailable.
                        </div>
                        @if (isLoadingNpcTeleports)
                        {
                            <p><em>Searching NPCs…</em></p>
                        }
                        else if (npcTeleportSearch.Trim().Length < 2)
                        {
                            <div class="alert alert-secondary">Enter at least two characters.</div>
                        }
                        else if (npcTeleportResults.Npcs.Count == 0)
                        {
                            <div class="alert alert-secondary">No matching outdoor NPC spawns were found.</div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead>
                                        <tr><th>NPC</th><th>Map</th><th>Zone</th><th>Distance</th><th></th></tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var npc in npcTeleportResults.Npcs)
                                    {
                                        <tr class="picker-result-row" tabindex="0" role="button"
                                            aria-label="Select @npc.Name"
                                            @onclick="() => SelectTeleportNpc(npc)"
                                            @onkeydown="args => SelectTeleportNpcFromKeyboard(args, npc)">
                                            <td>
                                                <div class="fw-semibold">@npc.Name</div>
                                                <div class="small text-muted">@npc.Subname · entry @npc.CreatureId · spawn @npc.SpawnId</div>
                                                @if (npc.PotentiallyHostile)
                                                {
                                                    <span class="badge text-bg-danger">May be hostile</span>
                                                }
                                            </td>
                                            <td>@MapName(npc.MapId)</td>
                                            <td>@npc.ZoneId</td>
                                            <td>
                                                @(npc.SameMap && npc.Distance is not null
                                                    ? npc.Distance.Value.ToString("N0") : "Different map")
                                            </td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                    <div class="modal-footer justify-content-between">
                        <span class="text-muted">@npcTeleportResults.TotalCount matching spawns</span>
                        <div>
                            <button class="btn btn-outline-secondary me-2"
                                    disabled="@(isLoadingNpcTeleports || npcTeleportResults.Page <= 1)"
                                    @onclick="() => LoadNpcTeleportsAsync(npcTeleportResults.Page - 1)">Previous</button>
                            <span class="me-2">
                                Page @npcTeleportResults.Page of @Math.Max(1, npcTeleportResults.TotalPages)
                            </span>
                            <button class="btn btn-outline-secondary"
                                    disabled="@(isLoadingNpcTeleports || npcTeleportResults.Page >= npcTeleportResults.TotalPages)"
                                    @onclick="() => LoadNpcTeleportsAsync(npcTeleportResults.Page + 1)">Next</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop show"></div>
    }
    @if (showLocationPicker)
    {
        <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="location-picker-title">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title h5" id="location-picker-title">Choose a teleport location</h2>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="() => showLocationPicker = false"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label" for="location-search">Location name</label>
                        <input id="location-search" class="form-control mb-3" value="@locationSearch" @oninput="OnLocationSearchAsync" placeholder="Start typing a location name…" autocomplete="off" autofocus />
                        @if (isLoadingLocations)
                        {
                            <p><em>Searching locations…</em></p>
                        }
                        else if (locationResults.Locations.Count == 0)
                        {
                            <div class="alert alert-secondary">No matching teleport locations were found.</div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead><tr><th>Location</th><th>Map</th><th>Coordinates</th></tr></thead>
                                    <tbody>
                                    @foreach (var location in locationResults.Locations)
                                    {
                                        <tr class="picker-result-row" tabindex="0" role="button"
                                            aria-label="Select @location.Name"
                                            @onclick="() => SelectLocation(location)"
                                            @onkeydown="args => SelectLocationFromKeyboard(args, location)">
                                            <td class="fw-semibold">@location.Name</td>
                                            <td>@MapName(location.MapId)</td>
                                            <td class="small text-muted">@location.PositionX.ToString("0.0"), @location.PositionY.ToString("0.0"), @location.PositionZ.ToString("0.0")</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                    <div class="modal-footer justify-content-between">
                        <span class="text-muted">@locationResults.TotalCount matching locations</span>
                        <div>
                            <button class="btn btn-outline-secondary me-2" disabled="@(isLoadingLocations || locationResults.Page <= 1)" @onclick="() => LoadLocationsAsync(locationResults.Page - 1)">Previous</button>
                            <span class="me-2">Page @locationResults.Page of @Math.Max(1, locationResults.TotalPages)</span>
                            <button class="btn btn-outline-secondary" disabled="@(isLoadingLocations || locationResults.Page >= locationResults.TotalPages)" @onclick="() => LoadLocationsAsync(locationResults.Page + 1)">Next</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop show"></div>
    }
}
