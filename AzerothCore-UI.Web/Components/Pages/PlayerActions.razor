@page "/player-actions"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "players.actions")]
@using AzerothCore_UI.Web.Models
@inject AzerothCore_UI.Web.Clients.AccountsApiClient AccountsClient
@inject AzerothCore_UI.Web.Services.SelectedCharacterStore SelectedCharacterStore
@implements IDisposable

<PageTitle>Player actions</PageTitle>

@if (isLoading)
{
    <p><em>Loading available characters...</em></p>
}
else if (errorMessage is not null)
{
    <div class="alert alert-danger">@errorMessage</div>
}
else
{
    <PlayerActionTools Targets="@SelectedTargets" />
}
