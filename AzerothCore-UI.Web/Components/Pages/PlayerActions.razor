@page "/player-actions"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "players.actions")]
@using AzerothCore_UI.Web.Models
@inject AzerothCore_UI.Web.Clients.AccountsApiClient AccountsClient

<PageTitle>Player actions</PageTitle>

@if (isLoading)
{
    <p><em>Loading available characters...</em></p>
}
else if (errorMessage is not null)
{
    <div class="alert alert-danger">@errorMessage</div>
}
else
{
    <section class="mb-3" aria-labelledby="action-targets-heading">
        <CharacterPicker Title="Action targets" TitleId="action-targets-heading"
                         Items="@PickerItems" Multiple="true" AllowBots="true"
                         SelectedValues="@selectedNames"
                         SelectedValuesChanged="SetSelectedPlayers" />
    </section>

    <PlayerActionTools Targets="@SelectedTargets" />
}
