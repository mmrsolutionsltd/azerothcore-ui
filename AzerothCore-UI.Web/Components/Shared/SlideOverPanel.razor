@inject IJSRuntime Javascript

<div class="tool-sheet-backdrop" @onclick="CloseAsync"></div>
<section class="tool-sheet" role="dialog" aria-modal="true" aria-label="Tool panel"
         @onkeydown="HandleKeyDownAsync">
    <div class="tool-sheet-header">
        <button type="button" class="tool-sheet-close" @ref="closeButtonRef" @onclick="CloseAsync"
                title="Back to the hero roster (Esc)">
            <span aria-hidden="true">‹</span> Back to roster
        </button>
    </div>
    <div class="tool-sheet-body">
        @ChildContent
    </div>
</section>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private ElementReference closeButtonRef;
    private bool focused;

    // Focuses the sheet's own close button exactly once per mount (the sheet only
    // mounts/unmounts at the home <-> tool boundary - see MainLayout - so this runs
    // once when a tool sheet first opens, not on every route change while it's open).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focused) return;
        focused = true;
        try
        {
            await Javascript.InvokeVoidAsync("azerothCoreUi.focusElement", closeButtonRef);
        }
        catch (Exception exception) when (
            exception is InvalidOperationException or JSDisconnectedException
                or TaskCanceledException)
        {
        }
    }

    private Task HandleKeyDownAsync(KeyboardEventArgs args) =>
        args.Key == "Escape" ? CloseAsync() : Task.CompletedTask;

    private Task CloseAsync() => OnClose.InvokeAsync();
}
