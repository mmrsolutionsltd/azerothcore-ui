<div class="companion-behavior">
    <div class="d-flex flex-wrap gap-1 align-items-center mb-2">
        <span class="small fw-semibold me-1">Presets</span>
        <button type="button" class="btn btn-sm btn-outline-success"
                disabled="@Disabled" @onclick="ApplyQuestingPresetAsync">
            Questing
        </button>
        <button type="button" class="btn btn-sm btn-outline-primary"
                disabled="@Disabled" @onclick="ApplyTankPresetAsync">
            Dungeon tank
        </button>
        <button type="button" class="btn btn-sm btn-outline-info"
                disabled="@Disabled" @onclick="ApplyHealerPresetAsync">
            Dungeon healer
        </button>
        <span class="badge text-bg-secondary ms-auto">@PresetName(Companion.Behavior.Preset)</span>
    </div>

    <div class="row g-2">
        <div class="col-12 col-md-4">
            <label class="form-label small mb-1">Role</label>
            <select class="form-select form-select-sm" @bind="role" disabled="@Disabled">
                <option value="auto">Auto (talents)</option>
                <option value="tank">Tank</option>
                <option value="healer">Healer</option>
                <option value="damage">Damage</option>
            </select>
        </div>
        <div class="col-6 col-md-4">
            <label class="form-label small mb-1">Movement</label>
            <select class="form-select form-select-sm" @bind="movement" disabled="@Disabled">
                <option value="follow">Follow</option>
                <option value="stay">Stay</option>
            </select>
        </div>
        <div class="col-6 col-md-4">
            <label class="form-label small mb-1">Combat focus</label>
            <select class="form-select form-select-sm" @bind="combatFocus" disabled="@Disabled">
                <option value="assist">Assist leader</option>
                <option value="defend">Defend party</option>
            </select>
        </div>
        <div class="col-12">
            <div class="d-flex align-items-center gap-2">
                <label class="form-label small mb-0 text-nowrap">Follow distance</label>
                <input class="form-range flex-grow-1" type="range" min="1" max="20" step="1"
                       @bind="followDistance" disabled="@Disabled" />
                <span class="badge text-bg-light companion-distance">@followDistance.ToString("0")m</span>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-3 mt-2">
        <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" role="switch"
                   id="loot-@Companion.Name" @bind="lootEnabled" disabled="@Disabled" />
            <label class="form-check-label small" for="loot-@Companion.Name">Loot</label>
        </div>
        <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" role="switch"
                   id="gather-@Companion.Name" @bind="gatherEnabled" disabled="@Disabled" />
            <label class="form-check-label small" for="gather-@Companion.Name">Gather</label>
        </div>
        <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" role="switch"
                   id="sell-@Companion.Name" @bind="autoSellTrash" disabled="@Disabled" />
            <label class="form-check-label small" for="sell-@Companion.Name">Sell junk and unusable white gear</label>
        </div>
        <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" role="switch"
                   id="repair-@Companion.Name" @bind="autoRepair" disabled="@Disabled" />
            <label class="form-check-label small" for="repair-@Companion.Name">Repair</label>
        </div>
        <div class="ms-auto d-flex gap-1">
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    disabled="@Disabled" title="Clear stuck AI state and resume following"
                    @onclick="RegroupAsync">
                <i class="bi bi-people"></i> Regroup
            </button>
            <button type="button" class="btn btn-sm btn-primary"
                    disabled="@Disabled" @onclick="ApplyAsync">
                Apply
            </button>
        </div>
    </div>
    <div class="small text-muted mt-2">
        Tank and healer roles require a compatible current specialization; these controls do not change talents or equipment.
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public ActiveQuestingCompanion Companion { get; set; } = default!;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<QuestingCompanionBehaviorRequest> BehaviorRequested { get; set; }

    [Parameter]
    public EventCallback<QuestingCompanionPresetRequest> PresetRequested { get; set; }

    [Parameter]
    public EventCallback<string> RegroupRequested { get; set; }

    private string role = "auto", movement = "follow", combatFocus = "assist";
    private double followDistance = 3;
    private bool lootEnabled = true, gatherEnabled = true,
        autoSellTrash = true, autoRepair = true;
    private string? behaviorSignature;

    protected override void OnParametersSet()
    {
        var behavior = Companion.Behavior;
        var signature = $"{Companion.Name}|{behavior.Preset}|{behavior.Role}|"
            + $"{behavior.Movement}|{behavior.CombatFocus}|{behavior.FollowDistance}|"
            + $"{behavior.LootEnabled}|{behavior.GatherEnabled}|"
            + $"{behavior.AutoSellTrash}|{behavior.AutoRepair}";
        if (signature == behaviorSignature) return;

        behaviorSignature = signature;
        role = behavior.Role;
        movement = behavior.Movement;
        combatFocus = behavior.CombatFocus;
        followDistance = behavior.FollowDistance;
        lootEnabled = behavior.LootEnabled;
        gatherEnabled = behavior.GatherEnabled;
        autoSellTrash = behavior.AutoSellTrash;
        autoRepair = behavior.AutoRepair;
    }

    private Task ApplyAsync() => BehaviorRequested.InvokeAsync(new(
        "", Companion.Name, "custom", role, movement, combatFocus,
        followDistance, lootEnabled, gatherEnabled, autoSellTrash, autoRepair));

    private Task ApplyPresetAsync(string preset) =>
        PresetRequested.InvokeAsync(new("", Companion.Name, preset));

    private Task ApplyQuestingPresetAsync() => ApplyPresetAsync("questing");
    private Task ApplyTankPresetAsync() => ApplyPresetAsync("dungeon-tank");
    private Task ApplyHealerPresetAsync() => ApplyPresetAsync("dungeon-healer");

    private Task RegroupAsync() => RegroupRequested.InvokeAsync(Companion.Name);

    private static string PresetName(string preset) => preset switch
    {
        "questing" => "Questing",
        "dungeon-tank" => "Dungeon tank",
        "dungeon-healer" => "Dungeon healer",
        "custom" => "Custom",
        _ => "Legacy"
    };
}
