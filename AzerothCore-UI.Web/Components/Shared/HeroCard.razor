@using AzerothCore_UI.Web.Models

<article class="hero-card class-@Hero.CharacterClass @(Hero.IsLeader ? "leader" : null) @(Hero.IsCompanion ? "companion" : null) @(IsActive ? "active" : null) @(IsDead ? "dead" : null) @(Hero.Online ? null : "offline") @(IsTarget ? "is-target" : null)"
         @oncontextmenu="OnSelectOnly" @oncontextmenu:preventDefault="true">
    <button type="button" class="hero-card-main" title="@TargetToggleTitle"
            @onclick="OnHeroClick">
        <span class="class-medallion">@CharacterDisplayNames.ClassGlyph(Hero.CharacterClass)</span>
        <span class="hero-identity">
            <strong>@Hero.Name</strong>
            <small>Level @Hero.Level @CharacterDisplayNames.Class((byte)Hero.CharacterClass)</small>
        </span>
        <span class="hero-flags">
            @if (IsTarget) { <b class="target-flag">✓ TARGET</b> }
            @if (IsActive) { <b class="active-flag">ACTIVE</b> }
            @if (Hero.IsLeader) { <b title="Online party leader">♛ LEADER</b> }
            else if (Hero.IsCompanion) { <b class="bot">COMPANION</b> }
            else if (Hero.IsPlayerBot) { <b class="bot">PLAYERBOT</b> }
            else if (HasParty) { <b>PARTY</b> }
            <i class="@(Hero.Online ? null : "offline-dot")" title="@(Hero.Online ? "Online" : "Offline")"></i>
        </span>
        @if (Hero.Online)
        {
            <span class="health-track @(Hero.MaximumHealth is null ? "snapshot" : null) @(IsLowHealth ? "low-health" : null)"
                  role="progressbar" aria-label="@($"{Hero.Name} health")"
                  aria-valuenow="@HealthWidth" aria-valuemin="0" aria-valuemax="100">
                <span style="@HealthStyle"></span>
                <em>@HealthText</em>
            </span>
        }
        else
        {
            <span class="health-track offline-track">
                <em>OFFLINE</em>
            </span>
        }
    </button>

    <AuthorizeView Policy="players.services">
        <Authorized>
            <button type="button" class="revive-banner @(IsDead ? "dead" : null)"
                    disabled="@(Reviving || (Hero.Online && !IsDead))"
                    title="@ReviveTitle"
                    @onclick="OnRevive">
                <span class="revive-icon" aria-hidden="true">✝</span>
                @(Reviving ? "Reviving…" : (IsDead ? "Revive!" : "Revive"))
            </button>
        </Authorized>
    </AuthorizeView>

    @if (Overview is not null)
    {
        <div class="hero-stats" @onclick="OnHeroClick" title="@TargetToggleTitle">
            <CharacterStatsList Character="Overview" />
        </div>
    }

    <div class="hero-card-actions">
        <span>@Hero.Username</span>
        <button type="button" class="focus-hero"
                disabled="@IsActive"
                title="Make @Hero.Name the active hero for single-hero pages (e.g. the Artisan Gearing Room) without changing the selected group"
                @onclick="OnActivate">
            @(IsActive ? "Active" : "Focus")
        </button>
        <AuthorizeView Policy="players.characters">
            <Authorized>
        <button type="button" class="upgrades-toggle"
                        disabled="@UpgradesLoading"
                        title="Show Artisan Gearing Room upgrades for @Hero.Name"
                        @onclick="OnToggleUpgrades">
                    @(UpgradesLoading ? "Loading…" : (UpgradesOpen ? "Close" : "Upgrades"))
                </button>
                <AuthorizeView Policy="adventures.quests">
                    <Authorized Context="questPolicy">
                        <button type="button" class="companions-toggle"
                                title="Manage questing companions for @Hero.Name"
                                @onclick="OnToggleCompanions">
                            @(CompanionsOpen ? "Close" : "Companions")
                        </button>
                        @if (Companion is null && !string.IsNullOrWhiteSpace(CompanionLeaderName)
                            && !Hero.Name.Equals(CompanionLeaderName, StringComparison.OrdinalIgnoreCase))
                        {
                            <button type="button" class="add-companion"
                                    disabled="@(AddingCompanion || !CanAddCompanion)"
                                    title="@AddCompanionTitle"
                                    @onclick="OnAddCompanion">
                                @(AddingCompanion ? "Adding…" : "Add companion")
                            </button>
                        }
                    </Authorized>
                </AuthorizeView>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Policy="adventures.training">
            <Authorized Context="trainingPolicy">
                <button type="button" class="training-toggle"
                        title="Manage class and profession training for @Hero.Name"
                        @onclick="OnToggleTraining">
                    @(TrainingOpen ? "Close" : "Training")
                </button>
            </Authorized>
        </AuthorizeView>
        <button type="button" class="dismiss-hero" title="Remove @Hero.Name from this hero row"
                @onclick="OnRemove">Dismiss</button>
    </div>
    @if (Companion is not null)
    {
        <CompanionHeaderControls @key="Companion.Name"
            LeaderName="@CompanionLeaderName"
            Companion="@Companion"
            ProtocolVersion="@ProtocolVersion"
            RefreshRequested="OnCompanionRefresh" />
    }
</article>

@code {
    [Parameter, EditorRequired] public RealmRosterCharacter Hero { get; set; } = default!;
    [Parameter] public CharacterOverviewSummary? Overview { get; set; }
    [Parameter] public bool IsActive { get; set; }
    [Parameter] public bool IsTarget { get; set; }
    [Parameter] public bool HasParty { get; set; }
    [Parameter] public bool UpgradesLoading { get; set; }
    [Parameter] public bool UpgradesOpen { get; set; }
    [Parameter] public bool CompanionsOpen { get; set; }
    [Parameter] public bool TrainingOpen { get; set; }
    [Parameter] public bool Reviving { get; set; }
    [Parameter] public ActiveQuestingCompanion? Companion { get; set; }
    [Parameter] public string CompanionLeaderName { get; set; } = "";
    [Parameter] public int ProtocolVersion { get; set; }
    [Parameter] public QuestingCompanionCandidate? CompanionCandidate { get; set; }
    [Parameter] public bool AddingCompanion { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnHeroClick { get; set; }
    [Parameter] public EventCallback OnSelectOnly { get; set; }
    [Parameter] public EventCallback OnActivate { get; set; }
    [Parameter] public EventCallback OnToggleUpgrades { get; set; }
    [Parameter] public EventCallback OnToggleCompanions { get; set; }
    [Parameter] public EventCallback OnToggleTraining { get; set; }
    [Parameter] public EventCallback OnRevive { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }
    [Parameter] public EventCallback OnCompanionRefresh { get; set; }
    [Parameter] public EventCallback OnAddCompanion { get; set; }

    private bool IsDead => Hero.Online && Hero.CurrentHealth == 0;
    private bool IsLowHealth => Hero.MaximumHealth is > 0
        && Hero.CurrentHealth * 100m / Hero.MaximumHealth.Value < 30m;
    private decimal HealthWidth => Hero.MaximumHealth is > 0
        ? Math.Clamp(Hero.CurrentHealth * 100m / Hero.MaximumHealth.Value, 0, 100)
        : Hero.CurrentHealth > 0 ? 100 : 0;
    private string HealthStyle
    {
        get
        {
            var width = HealthWidth.ToString("0.##",
                System.Globalization.CultureInfo.InvariantCulture);
            var colour = IsLowHealth || IsDead ? "#c43b3f" : "#43b856";
            return $"width:{width}%;background-color:{colour}";
        }
    }
    private string HealthText => Hero.MaximumHealth is > 0
        ? $"{Math.Round(Math.Clamp(Hero.CurrentHealth * 100m / Hero.MaximumHealth.Value, 0, 100))}%"
        : Hero.CurrentHealth == 0 ? "DEAD" : $"{Hero.CurrentHealth:N0} HP";

    private string TargetToggleTitle => IsTarget
        ? $"{Hero.Name} is a target for the player-action tools - click to exclude, double-click to focus"
        : $"{Hero.Name} is excluded from the player-action tools - click to include, double-click to focus";

    private string ReviveTitle => Hero.Online
        ? (IsDead ? $"Revive {Hero.Name}" : $"{Hero.Name} is alive")
        : $"Revive {Hero.Name} if needed (offline - live status unknown)";

    private bool CanAddCompanion => CompanionCandidate is
        { Online: false, SameFaction: true, ControlAllowed: true };

    private string AddCompanionTitle => CompanionCandidate switch
    {
        null => $"{Hero.Name} is not currently a companion candidate for {CompanionLeaderName}",
        { Online: true } => $"{Hero.Name} is already online",
        { SameFaction: false } => $"{Hero.Name} is the opposite faction",
        { ControlAllowed: false } candidate => candidate.ControlReason,
        _ => $"Add {Hero.Name} as a companion for {CompanionLeaderName}, with the same default behaviour as starting a companion group"
    };
}
