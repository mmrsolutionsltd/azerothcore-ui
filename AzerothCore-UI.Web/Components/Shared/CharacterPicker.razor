@using AzerothCore_UI.Web.Models
@inject AzerothCore_UI.Web.Services.SelectedCharacterStore SelectedCharacterStore
@implements IDisposable

<div class="character-picker border rounded p-2">
	<div class="character-picker-heading d-flex flex-wrap align-items-center gap-2 mb-2">
		@if (!string.IsNullOrWhiteSpace(Title))
		{
			<h2 id="@TitleId" class="h5 mb-0">@Title</h2>
		}
		<div class="ms-auto">
			<div class="character-picker-controls d-flex flex-nowrap align-items-center justify-content-end gap-2">
				<div class="form-check form-switch mb-0 flex-shrink-0">
					<input id="@($"{pickerId}-offline")" class="form-check-input" type="checkbox" @bind="showOffline" />
					<label class="form-check-label small" for="@($"{pickerId}-offline")">Offline</label>
				</div>
				<div class="form-check form-switch mb-0 flex-shrink-0">
					<input id="@($"{pickerId}-bots")" class="form-check-input" type="checkbox"
						   disabled="@(!AllowBots)" @bind="showBots" />
					<label class="form-check-label small" for="@($"{pickerId}-bots")">Bots</label>
				</div>
				@if (Multiple)
				{
					<button class="btn btn-sm btn-link p-0 flex-shrink-0" type="button"
							title="Select all online characters allowed by the bot filter"
							@onclick="SelectOnlineAsync">Online</button>
					<button class="btn btn-sm btn-link p-0 flex-shrink-0" type="button" @onclick="ClearAsync">Clear</button>
				}
			</div>
		</div>
	</div>
	<div class="character-picker-items d-flex flex-wrap align-content-start gap-1">
		@if (FilteredItems.Count == 0)
		{
			<div class="small text-muted px-1 py-2">No characters match these filters.</div>
		}
		else
		{
			@foreach (var item in FilteredItems)
			{
				var selected = IsSelected(item.Value);
				<button type="button"
						class="character-picker-item btn btn-sm text-start d-inline-flex align-items-center gap-2 @(selected ? "btn-primary" : "btn-light")"
						title="@SelectionHint(item)"
						@onclick="() => ToggleAsync(item.Value)"
						@ondblclick="() => SelectOnlineFromAsync(item)"
						@oncontextmenu="() => SelectOnlyAsync(item)"
						@oncontextmenu:preventDefault="true">
					<span class="text-truncate">
						<strong>@item.Name</strong>
						@if (!string.IsNullOrWhiteSpace(item.Detail))
						{
							<span class="small @(selected ? null : "text-muted")"> — @item.Detail</span>
						}
					</span>
					<span class="badge @(item.Online ? "text-bg-success" : "text-bg-secondary")">
						@(item.Online ? "Online" : "Offline")
					</span>
					@if (item.IsPlayerBot)
					{
						<span class="badge text-bg-info">Bot</span>
					}
				</button>
			}
		}
	</div>
	<div class="small text-muted mt-1">
		@if (Multiple)
		{
			<span>@SelectedValues.Count selected · Right-click selects only one · Double-click an online character selects all online</span>
		}
		else
		{
			<span>@(string.IsNullOrEmpty(SelectedValue) ? "No character selected" : "1 selected")</span>
		}
		@if (HiddenSelectedCount > 0)
		{
			<span> · @HiddenSelectedCount hidden by filters</span>
		}
	</div>
</div>

@code {
	[Parameter] public string? Title { get; set; }
	[Parameter] public string? TitleId { get; set; }
	[Parameter, EditorRequired] public IReadOnlyList<CharacterPickerItem> Items { get; set; } = [];
	[Parameter] public bool Multiple { get; set; }
	[Parameter] public bool AllowBots { get; set; } = true;
	[Parameter] public bool ShowOfflineInitially { get; set; }
	[Parameter] public bool ShowBotsInitially { get; set; }
	[Parameter] public bool RememberSelection { get; set; } = true;
	[Parameter] public bool PreserveItemOrder { get; set; }
	[Parameter] public int MaximumSelections { get; set; } = int.MaxValue;
	[Parameter] public string? SelectedValue { get; set; }
	[Parameter] public EventCallback<string?> SelectedValueChanged { get; set; }
	[Parameter] public IReadOnlySet<string> SelectedValues { get; set; } = new HashSet<string>();
	[Parameter] public EventCallback<IReadOnlySet<string>> SelectedValuesChanged { get; set; }
	private readonly string pickerId = $"character-picker-{Guid.NewGuid():N}";
	private bool showOffline, showBots;
	private bool restoredRememberedSelection;

	protected override void OnInitialized()
	{
		showOffline = ShowOfflineInitially;
		showBots = AllowBots && ShowBotsInitially;
		SelectedCharacterStore.SelectionChanged += OnSharedSelectionChanged;
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (restoredRememberedSelection || Items.Count == 0 || !RememberSelection
			|| (Multiple ? SelectedValues.Count > 0
				: !string.IsNullOrWhiteSpace(SelectedValue))
			) return;
		restoredRememberedSelection = true;
		var rememberedName = await SelectedCharacterStore.GetAsync();
		var rememberedItem = Items.FirstOrDefault(item =>
			!item.IsPlayerBot
			&& item.Name.Equals(rememberedName, StringComparison.OrdinalIgnoreCase));
		if (rememberedItem is null) return;
		if (Multiple)
		{
			var values = SelectedValues.ToHashSet(StringComparer.OrdinalIgnoreCase);
			if (values.Count < MaximumSelections && values.Add(rememberedItem.Value))
				await SelectedValuesChanged.InvokeAsync(values);
		}
		else
			await SelectedValueChanged.InvokeAsync(rememberedItem.Value);
	}
	private IReadOnlyList<CharacterPickerItem> FilteredItems
	{
		get
		{
			var filtered = Items.Where(item => (item.Online || showOffline)
				&& (!item.IsPlayerBot || (AllowBots && showBots)));
			return PreserveItemOrder
				? filtered.ToArray()
				: filtered.OrderByDescending(item => item.Online)
					.ThenBy(item => item.IsPlayerBot)
					.ThenBy(item => item.Name).ToArray();
		}
	}
	private int HiddenSelectedCount => Multiple
		? SelectedValues.Count(value => FilteredItems.All(item => item.Value != value))
		: string.IsNullOrEmpty(SelectedValue) || FilteredItems.Any(item => item.Value == SelectedValue) ? 0 : 1;

	private bool IsSelected(string value) => Multiple
		? SelectedValues.Contains(value)
		: string.Equals(SelectedValue, value, StringComparison.Ordinal);

	private async Task ToggleAsync(string value)
	{
		if (!Multiple)
		{
			var selectedItem = Items.FirstOrDefault(item => item.Value == value);
			var nextValue = string.Equals(SelectedValue, value, StringComparison.Ordinal)
				? null : value;
			await SelectedValueChanged.InvokeAsync(nextValue);
			if (nextValue is not null && RememberSelection
				&& selectedItem is { IsPlayerBot: false })
				await SelectedCharacterStore.SetAsync(selectedItem.Name);
			return;
		}
		var values = SelectedValues.ToHashSet(StringComparer.OrdinalIgnoreCase);
		CharacterPickerItem? rememberedItem = null;
		if (!values.Remove(value) && values.Count < MaximumSelections)
		{
			values.Add(value);
			rememberedItem = Items.FirstOrDefault(item => item.Value == value);
		}
		await SelectedValuesChanged.InvokeAsync(values);
		if (RememberSelection && rememberedItem is { IsPlayerBot: false })
			await SelectedCharacterStore.SetAsync(rememberedItem.Name);
	}

	private async Task SelectOnlineAsync()
	{
		var values = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
		foreach (var item in FilteredItems.Where(item => item.Online))
		{
			if (values.Count >= MaximumSelections) break;
			values.Add(item.Value);
		}
		await SelectedValuesChanged.InvokeAsync(values);
	}

	private Task SelectOnlineFromAsync(CharacterPickerItem item) =>
		item.Online ? SelectOnlineAsync() : Task.CompletedTask;

	private static string SelectionHint(CharacterPickerItem item) => item.Online
		? $"Right-click to select only {item.Name}; double-click to select all online characters"
		: $"Right-click to select only {item.Name}";

	private async Task SelectOnlyAsync(CharacterPickerItem item)
	{
		if (!Multiple)
		{
			await SelectedValueChanged.InvokeAsync(item.Value);
			if (RememberSelection && !item.IsPlayerBot)
				await SelectedCharacterStore.SetAsync(item.Name);
			return;
		}

		IReadOnlySet<string> values = MaximumSelections > 0
			? new HashSet<string>([item.Value], StringComparer.OrdinalIgnoreCase)
			: new HashSet<string>(StringComparer.OrdinalIgnoreCase);
		await SelectedValuesChanged.InvokeAsync(values);
		if (RememberSelection && !item.IsPlayerBot)
			await SelectedCharacterStore.SetAsync(item.Name);
	}

	private Task ClearAsync() =>
		SelectedValuesChanged.InvokeAsync(new HashSet<string>(StringComparer.OrdinalIgnoreCase));

	private void OnSharedSelectionChanged(string characterName)
	{
		var item = Items.FirstOrDefault(candidate => !candidate.IsPlayerBot
			&& candidate.Name.Equals(characterName, StringComparison.OrdinalIgnoreCase));
		if (item is null || IsSelected(item.Value)) return;
		_ = InvokeAsync(async () =>
		{
			if (Multiple)
				await SelectedValuesChanged.InvokeAsync(
					new HashSet<string>([item.Value], StringComparer.OrdinalIgnoreCase));
			else
				await SelectedValueChanged.InvokeAsync(item.Value);
		});
	}

	public void Dispose() =>
		SelectedCharacterStore.SelectionChanged -= OnSharedSelectionChanged;
}
