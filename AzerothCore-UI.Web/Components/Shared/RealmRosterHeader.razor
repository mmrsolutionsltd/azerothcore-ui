@using AzerothCore_UI.Web.Models
@implements IAsyncDisposable
@inject AzerothCore_UI.Web.Clients.AccountsApiClient Api
@inject AzerothCore_UI.Web.Services.SelectedCharacterStore SelectedCharacterStore
@inject NavigationManager Navigation

<section class="hero-roster" aria-label="Selected heroes and realm roster">
    <div class="hero-roster-heading">
        <span>CHOOSE YOUR HEROES</span>
        <small>@selectedNames.Count/@AzerothCore_UI.Web.Services.SelectedCharacterStore.MaximumCharacters selected</small>
        <div class="roster-selection-controls">
            <label title="Include offline characters in the choices below">
                <input type="checkbox" @bind="showOffline" />
                <span>Offline</span>
            </label>
            <label title="Load and include random PlayerBots in the choices below">
                <input type="checkbox" checked="@showBots"
                       @onchange="ToggleBotsAsync" />
                <span>Bots</span>
            </label>
            <button type="button" title="Select up to five visible online characters"
                    @onclick="SelectOnlineAsync">Online</button>
            <button type="button" title="Clear the shared hero selection"
                    disabled="@(selectedNames.Count == 0)" @onclick="ClearAsync">Clear</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(message))
        {
            <em class="roster-message @(operationSucceeded ? "success" : "failure")">@message</em>
        }
    </div>

    @if (snapshot is null)
    {
        <div class="roster-loading">Consulting the realm…</div>
    }
    else
    {
        @if (SelectedHeroes.Count > 0)
        {
            <div class="hero-card-row">
                @foreach (var hero in SelectedHeroes)
                {
                    <HeroCard @key="hero.Name" Hero="hero"
                              Overview="overviewByName.GetValueOrDefault(hero.Name)"
                              IsActive="IsActive(hero.Name)"
                              IsTarget="targetNames.Contains(hero.Name)"
                              HasParty="PartyFor(hero.Name) is not null"
                              UpgradesLoading="upgradesLoading.Contains(hero.Name)"
                              UpgradesOpen="@(openPanelFor == hero.Name && activePanelTab == "Upgrades")"
                              CompanionsOpen="@(openPanelFor == hero.Name && activePanelTab == "Companions")"
                              TrainingOpen="@(openPanelFor == hero.Name && activePanelTab == "Training")"
                              Reviving="reviving.Contains(hero.Name)"
                              Companion="ActiveCompanionFor(hero.Name)"
                              CompanionLeaderName="@companionLeaderName"
                              ProtocolVersion="@(companionStatus?.ProtocolVersion ?? 0)"
                              OnHeroClick="args => HandleSelectedHeroClickAsync(hero.Name, args)"
                              OnSelectOnly="() => MakeOnlyTargetAsync(hero.Name)"
                              OnActivate="() => ActivateAsync(hero.Name)"
                              OnToggleUpgrades="() => ToggleUpgradesAsync(hero)"
                              OnToggleCompanions="() => ToggleCompanionsAsync(hero)"
                              OnToggleTraining="() => ToggleTrainingAsync(hero)"
                              OnRevive="() => ReviveAsync(hero.Name)"
                              OnRemove="() => RemoveAsync(hero.Name)"
                              OnCompanionRefresh="RefreshCompanionControlsAsync" />
                }
            </div>

            @if (openPanelFor is { } openName
                && SelectedHeroes.ToList().FindIndex(hero => hero.Name.Equals(
                    openName, StringComparison.OrdinalIgnoreCase)) is var openIndex
                && openIndex >= 0)
            {
                <div class="hero-panel-tabs" role="tablist">
                    <button type="button" class="@(activePanelTab == "Upgrades" ? "active" : null)" @onclick='() => SetPanelTab("Upgrades")'>Upgrades</button>
                    <button type="button" class="@(activePanelTab == "Companions" ? "active" : null)" @onclick='() => SetPanelTab("Companions")'>Companions</button>
                    <button type="button" class="@(activePanelTab == "Training" ? "active" : null)" @onclick='() => SetPanelTab("Training")'>Training</button>
                </div>
                @if (activePanelTab == "Upgrades")
                {
                    <HeroUpgradePanel Hero="SelectedHeroes[openIndex]" AnchorIndex="openIndex"
                                      TotalCount="SelectedHeroes.Count"
                                      Loading="upgradesLoading.Contains(openName)"
                                      Error="@upgradesError.GetValueOrDefault(openName)"
                                      Plan="upgradePlanCache.GetValueOrDefault(openName)"
                                      SelectedSlotId="openUpgradeSlotId"
                                      Filter="@upgradeFilter"
                                      OnRefresh="() => RefreshUpgradesAsync(SelectedHeroes[openIndex])"
                                      OnClose="CloseUpgrades"
                                      OnSelectSlot="SelectUpgradeSlot"
                                      OnFilterChanged="filter => upgradeFilter = filter" />
                }
                else if (activePanelTab == "Companions")
                {
                    @if (CompanionLeaderHero is { } companionLeader)
                    {
                        <CompanionSessionPanel Leader="companionLeader"
                                               SelectedHeroes="SelectedHeroes"
                                               Status="companionStatus"
                                               OnChanged="RefreshCompanionControlsAsync" />
                    }
                    else
                    {
                        <div class="companion-session-panel">
                            <p class="text-muted mb-0">
                                No eligible online leader in your selected heroes yet -
                                add or focus an online, non-bot, non-companion hero first.
                            </p>
                        </div>
                    }
                }
                else
                {
                    <HeroTrainingPanel Hero="SelectedHeroes[openIndex]"
                                       Loading="trainingLoading"
                                       Error="@trainingError"
                                       Starter="StarterFor(SelectedHeroes[openIndex].Guid)"
                                       Management="ManagementFor(SelectedHeroes[openIndex].Guid)"
                                       Requirements="RequirementsFor(SelectedHeroes[openIndex].Guid)"
                                       OnChanged="RefreshTrainingDataAsync" />
                }
            }
        }

        <div class="hero-choice-strip">
            <span class="choice-label">@(SelectedHeroes.Count == 0 ? "SELECT HEROES" : "ADD ANOTHER")</span>
            @foreach (var hero in AvailableChoices)
            {
                <HeroChoiceButton @key="hero.Name" Hero="hero"
                                  Disabled="@(selectedNames.Count >= AzerothCore_UI.Web.Services.SelectedCharacterStore.MaximumCharacters)"
                                  OnHeroClick="args => HandleHeroClickAsync(hero.Name, args)"
                                  OnSelectOnly="() => SelectOnlyAsync(hero.Name)" />
            }
            @if (AvailableChoices.Count == 0)
            {
                <small class="all-selected">@(selectedNames.Count == 0 ? "No scoped characters found" : "Your hero row is ready")</small>
            }
        </div>
    }
</section>

@code {
    private readonly CancellationTokenSource cancellation = new();
    private readonly HashSet<string> reviving = new(StringComparer.OrdinalIgnoreCase);
    private RealmRosterSnapshot? snapshot;
    private QuestingCompanionStatus? companionStatus;
    private string companionLeaderName = "";
    private Task? refreshLoop;
    private string? activeName;
    private IReadOnlyList<string> selectedNames = [];
    private string? message;
    private bool operationSucceeded;
    private bool showOffline;
    private bool showBots;
    private readonly Dictionary<string, CraftingUpgradePlan?> upgradePlanCache =
        new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> upgradesLoading =
        new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> upgradesError =
        new(StringComparer.OrdinalIgnoreCase);
    private string? openPanelFor;
    private string activePanelTab = "Upgrades";
    private int? openUpgradeSlotId;
    private string upgradeFilter = "All";
    private Dictionary<string, CharacterOverviewSummary> overviewByName =
        new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> targetNames = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<CharacterTrainingSummary> trainingCharacters = [];
    private IReadOnlyList<ProfessionStarterCharacter> trainingStarters = [];
    private IReadOnlyList<ProfessionManagementCharacter> trainingManagement = [];
    private bool trainingDataLoaded;
    private bool trainingLoading;
    private string? trainingError;

    private IReadOnlyList<RealmRosterCharacter> AllHeroes =>
        snapshot?.AvailableHeroes
        ?? snapshot?.Parties.SelectMany(party => party.Members)
            .Concat(snapshot.SoloPlayers).DistinctBy(hero => hero.Name,
                StringComparer.OrdinalIgnoreCase).ToArray()
        ?? [];

    private IReadOnlyList<RealmRosterCharacter> SelectedHeroes => selectedNames
        .Select(name => AllHeroes.FirstOrDefault(hero => hero.Name.Equals(
            name, StringComparison.OrdinalIgnoreCase))
            ?? new RealmRosterCharacter(0, name, "", 0, 0, 0,
                false, false, false))
        .OrderByDescending(hero => hero.IsLeader)
        .ToArray();

    private IReadOnlyList<RealmRosterCharacter> AvailableChoices => AllHeroes
        .Where(hero => selectedNames.All(name => !name.Equals(
            hero.Name, StringComparison.OrdinalIgnoreCase)))
        .Where(hero => hero.Online || showOffline)
        .Where(hero => !hero.IsPlayerBot || showBots)
        .ToArray();

    protected override async Task OnInitializedAsync()
    {
        showOffline = IsCompanionPage();
        Navigation.LocationChanged += OnLocationChanged;
        activeName = await SelectedCharacterStore.GetAsync();
        selectedNames = await SelectedCharacterStore.GetSelectedAsync();
        targetNames = new(await SelectedCharacterStore.GetTargetsAsync(),
            StringComparer.OrdinalIgnoreCase);
        SelectedCharacterStore.SelectionChanged += OnActiveSelectionChanged;
        SelectedCharacterStore.SelectedCharactersChanged += OnSelectedCharactersChanged;
        SelectedCharacterStore.TargetsChanged += OnTargetsChanged;
        await RefreshAsync();
        refreshLoop = RefreshLoopAsync(cancellation.Token);
    }

    private async Task RefreshAsync()
    {
        try
        {
            var retainSelectedBots = AllHeroes.Any(hero => hero.IsPlayerBot
                && selectedNames.Contains(hero.Name,
                    StringComparer.OrdinalIgnoreCase));
            snapshot = await Api.GetRealmRosterAsync(cancellation.Token,
                showBots || retainSelectedBots);
            await NormalizeLeaderOrderAsync();
            await RefreshCompanionControlsAsync();
        }
        catch when (!cancellation.IsCancellationRequested) { }

        try
        {
            var overview = await Api.GetCharacterOverviewAsync(cancellation.Token);
            overviewByName = overview.ToDictionary(
                character => character.Name, StringComparer.OrdinalIgnoreCase);
        }
        catch when (!cancellation.IsCancellationRequested) { }
    }

    private async Task NormalizeLeaderOrderAsync(string? activeCharacter = null)
    {
        var stored = await SelectedCharacterStore.GetSelectedAsync();
        var ordered = stored.OrderByDescending(name =>
                AllHeroes.FirstOrDefault(hero => hero.Name.Equals(
                    name, StringComparison.OrdinalIgnoreCase))?.IsLeader == true)
            .ToArray();
        selectedNames = ordered;
        if (stored.SequenceEqual(ordered,
                StringComparer.OrdinalIgnoreCase)) return;
        await SelectedCharacterStore.SetSelectedAsync(ordered,
            activeCharacter ?? await SelectedCharacterStore.GetAsync());
    }

    // Must never call the crafting-upgrade endpoint here - that data is fetched
    // on demand only (see ToggleUpgradesAsync), not on this 15s poll.
    private async Task RefreshLoopAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
                await InvokeAsync(async () => { await RefreshAsync(); StateHasChanged(); });
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
    }

    private async Task ToggleAsync(string name)
    {
        if (selectedNames.Contains(name, StringComparer.OrdinalIgnoreCase))
        {
            await SelectedCharacterStore.RemoveAsync(name);
            message = null;
            return;
        }
        if (await SelectedCharacterStore.AddAsync(name))
        {
            await NormalizeLeaderOrderAsync(name);
            operationSucceeded = true;
            message = null;
        }
        else
        {
            operationSucceeded = false;
            message = "Your hero row is full. Remove a hero before adding another.";
        }
    }

    private Task HandleHeroClickAsync(string name, MouseEventArgs args) =>
        args.Detail >= 2 ? SelectOnlineAsync() : ToggleAsync(name);

    // For heroes already in the header row: clicking the card body toggles whether
    // they're included as a target for the right-side tools. It does not remove them
    // from the row - that's the Dismiss button's job (OnRemove/RemoveAsync below).
    // Double-clicking instead makes that hero the active/focused one (same as the
    // Focus button), so dependent UI like the Artisan Gearing Room can update to it.
    private Task HandleSelectedHeroClickAsync(string name, MouseEventArgs args) =>
        args.Detail >= 2
            ? ActivateAsync(name)
            : SelectedCharacterStore.ToggleTargetAsync(name).AsTask();

    // Right-clicking an already-selected hero card narrows the target set down to just
    // that hero, without touching row membership - unlike SelectOnlyAsync below, which
    // HeroChoiceButton's right-click still uses to solo-select an unselected candidate
    // into the row.
    private Task MakeOnlyTargetAsync(string name) =>
        SelectedCharacterStore.SetOnlyTargetAsync(name).AsTask();

    private async Task ToggleBotsAsync(ChangeEventArgs args)
    {
        showBots = args.Value as bool? == true;
        if (showBots) await RefreshAsync();
    }

    private Task RemoveAsync(string name) => SelectedCharacterStore.RemoveAsync(name).AsTask();

    private Task ActivateAsync(string name) =>
        SelectedCharacterStore.SetAsync(name).AsTask();

    private Task SelectOnlyAsync(string name) =>
        SelectedCharacterStore.SetSelectedAsync([name], name).AsTask();

    private Task ClearAsync() =>
        SelectedCharacterStore.SetSelectedAsync([]).AsTask();

    private Task SelectOnlineAsync()
    {
        var names = AllHeroes.Where(hero => hero.Online
                && (showBots || !hero.IsPlayerBot))
            .OrderByDescending(hero => hero.IsLeader)
            .Take(AzerothCore_UI.Web.Services.SelectedCharacterStore.MaximumCharacters)
            .Select(hero => hero.Name)
            .ToArray();
        return SelectedCharacterStore.SetSelectedAsync(
            names, names.FirstOrDefault()).AsTask();
    }

    private async Task ReviveAsync(string name)
    {
        if (!reviving.Add(name)) return;
        message = null;
        try
        {
            var result = await Api.ApplyCharacterServiceAsync(
                new CharacterServiceRequest(name, "revive", null, true));
            operationSucceeded = result?.Success == true;
            message = result?.Message ?? $"Revive requested for {name}.";
            await RefreshAsync();
        }
        catch (Exception exception)
        {
            operationSucceeded = false;
            message = exception.Message;
        }
        finally { reviving.Remove(name); }
    }

    private async Task ToggleUpgradesAsync(RealmRosterCharacter hero)
    {
        if (openPanelFor is not null && openPanelFor.Equals(
                hero.Name, StringComparison.OrdinalIgnoreCase))
        {
            openPanelFor = null;
            return;
        }
        openPanelFor = hero.Name;
        activePanelTab = "Upgrades";
        openUpgradeSlotId = null;
        upgradeFilter = "All";
        if (!upgradePlanCache.ContainsKey(hero.Name))
            await FetchUpgradePlanAsync(hero);
    }

    private Task ToggleCompanionsAsync(RealmRosterCharacter hero)
    {
        if (openPanelFor is not null && openPanelFor.Equals(hero.Name, StringComparison.OrdinalIgnoreCase)
            && activePanelTab == "Companions") { openPanelFor = null; return Task.CompletedTask; }
        openPanelFor = hero.Name;
        activePanelTab = "Companions";
        return RefreshCompanionControlsAsync();
    }

    private async Task ToggleTrainingAsync(RealmRosterCharacter hero)
    {
        if (openPanelFor is not null && openPanelFor.Equals(hero.Name, StringComparison.OrdinalIgnoreCase)
            && activePanelTab == "Training") { openPanelFor = null; return; }
        openPanelFor = hero.Name;
        activePanelTab = "Training";
        if (!trainingDataLoaded) await FetchTrainingDataAsync();
    }

    private async Task SetPanelTab(string tab)
    {
        activePanelTab = tab;
        if (tab == "Training" && !trainingDataLoaded) await FetchTrainingDataAsync();
    }

    private async Task FetchUpgradePlanAsync(RealmRosterCharacter hero)
    {
        upgradesLoading.Add(hero.Name);
        upgradesError.Remove(hero.Name);
        StateHasChanged();
        try
        {
            var loadedPlan = await Api.GetCraftingUpgradePlanAsync(
                hero.Guid, cancellationToken: cancellation.Token);
            upgradePlanCache[hero.Name] = loadedPlan;
            openUpgradeSlotId = loadedPlan?.Slots
                .FirstOrDefault(slot => slot.Recommendations.Count > 0)?.Slot
                ?? loadedPlan?.Slots.FirstOrDefault()?.Slot;
        }
        catch (Exception exception) when (!cancellation.IsCancellationRequested)
        {
            upgradesError[hero.Name] = exception.Message;
        }
        finally
        {
            upgradesLoading.Remove(hero.Name);
        }
    }

    private Task RefreshUpgradesAsync(RealmRosterCharacter hero)
    {
        upgradePlanCache.Remove(hero.Name);
        return FetchUpgradePlanAsync(hero);
    }

    private void SelectUpgradeSlot(int slotId)
    {
        openUpgradeSlotId = slotId;
        upgradeFilter = "All";
    }

    private void CloseUpgrades() => openPanelFor = null;

    // The training/profession endpoints return every scoped character at once, so
    // they're fetched once and cached, then sliced per hero below - not refetched
    // per card the way crafting-upgrade plans are.
    private async Task FetchTrainingDataAsync()
    {
        trainingLoading = true;
        trainingError = null;
        StateHasChanged();
        try
        {
            trainingCharacters = await Api.GetAvailableTrainingAsync(cancellation.Token);
            trainingStarters = await Api.GetProfessionStartersAsync(cancellation.Token);
            trainingManagement = await Api.GetProfessionManagementAsync(cancellation.Token);
            trainingDataLoaded = true;
        }
        catch (Exception exception) when (!cancellation.IsCancellationRequested)
        {
            trainingError = exception.Message;
        }
        finally
        {
            trainingLoading = false;
        }
    }

    private Task RefreshTrainingDataAsync() => FetchTrainingDataAsync();

    private ProfessionStarterCharacter? StarterFor(uint guid) =>
        trainingStarters.FirstOrDefault(character => character.CharacterGuid == guid);

    private ProfessionManagementCharacter? ManagementFor(uint guid) =>
        trainingManagement.FirstOrDefault(character => character.CharacterGuid == guid);

    private IReadOnlyList<TrainingRequirement> RequirementsFor(uint guid) =>
        trainingCharacters.FirstOrDefault(character => character.CharacterGuid == guid)
            ?.Requirements ?? [];

    private void OnActiveSelectionChanged(string name) => _ = InvokeAsync(() =>
    {
        activeName = name;
        StateHasChanged();
    });

    private void OnSelectedCharactersChanged(IReadOnlyList<string> names) =>
        _ = InvokeAsync(async () =>
        {
            selectedNames = names;
            targetNames = new(await SelectedCharacterStore.GetTargetsAsync(),
                StringComparer.OrdinalIgnoreCase);
            await RefreshCompanionControlsAsync();
            StateHasChanged();
        });

    private void OnTargetsChanged(IReadOnlyList<string> names) => _ = InvokeAsync(() =>
    {
        targetNames = new(names, StringComparer.OrdinalIgnoreCase);
        StateHasChanged();
    });

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) =>
        _ = InvokeAsync(() =>
        {
            if (IsCompanionPage()) showOffline = true;
            StateHasChanged();
        });

    private bool IsCompanionPage() => Navigation.ToBaseRelativePath(Navigation.Uri)
        .Split('?', '#')[0].Trim('/').Equals(
            "questing-companions", StringComparison.OrdinalIgnoreCase);

    private RealmRosterParty? PartyFor(string name) => snapshot?.Parties.FirstOrDefault(
        party => party.Live && party.Members.Any(member => member.Name.Equals(
            name, StringComparison.OrdinalIgnoreCase)));

    private bool IsActive(string name) => name.Equals(activeName,
        StringComparison.OrdinalIgnoreCase);

    private ActiveQuestingCompanion? ActiveCompanionFor(string name) =>
        companionStatus?.ActiveCompanions.FirstOrDefault(companion =>
            companion.Name.Equals(name, StringComparison.OrdinalIgnoreCase));

    private RealmRosterCharacter? CompanionLeaderHero => SelectedHeroes.FirstOrDefault(
        hero => hero.Name.Equals(companionLeaderName, StringComparison.OrdinalIgnoreCase));

    private async Task RefreshCompanionControlsAsync()
    {
        var leader = SelectedHeroes.FirstOrDefault(hero => hero.Online
                && !hero.IsPlayerBot && hero.IsLeader)
            ?? SelectedHeroes.FirstOrDefault(hero => hero.Online
                && !hero.IsPlayerBot && !hero.IsCompanion);
        if (leader is null)
        {
            companionLeaderName = "";
            companionStatus = null;
            return;
        }

        try
        {
            companionLeaderName = leader.Name;
            companionStatus = await Api.GetQuestingCompanionsAsync(leader.Name);
        }
        catch when (!cancellation.IsCancellationRequested)
        {
            companionStatus = null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        SelectedCharacterStore.SelectionChanged -= OnActiveSelectionChanged;
        SelectedCharacterStore.SelectedCharactersChanged -= OnSelectedCharactersChanged;
        SelectedCharacterStore.TargetsChanged -= OnTargetsChanged;
        await cancellation.CancelAsync();
        if (refreshLoop is not null) await refreshLoop;
        cancellation.Dispose();
    }
}
