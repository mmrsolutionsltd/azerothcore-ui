@inherits PlayerActionToolBase

<PlayerActionToolHeader Title="Movement speed" Icon="➤" />
<div class="d-flex flex-wrap gap-2 mb-2" aria-label="Movement speed presets">
	@foreach (var preset in Presets)
	{
		<button class="btn btn-sm btn-outline-secondary" type="button"
			disabled="@IsWorking" @onclick="() => ApplyPresetAsync(preset)">
			@preset.ToString("0.#")x
		</button>
	}
</div>
<PlayerActionFeedback Results="Results" />

@code {
	private static readonly decimal[] Presets = [0.5m, 1m, 1.5m, 2m, 3m, 5m];
	private Task ApplyPresetAsync(decimal preset) => RunBatchAsync(
		$"Set speed to {preset:0.#}x",
		player => AccountsClient.SetPlayerSpeedAsync(new(player, preset)));
}
