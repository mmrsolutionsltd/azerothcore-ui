@inherits PlayerActionToolBase

<PlayerActionToolHeader Title="Give" Icon="✉" />
<div class="btn-group btn-group-sm mb-2" role="group" aria-label="Give type">
	<button type="button" class="btn @(mode == "item" ? "btn-primary" : "btn-outline-primary")"
			@onclick='() => SetMode("item")'>
		Item
	</button>
	<button type="button" class="btn @(mode == "money" ? "btn-primary" : "btn-outline-primary")"
			@onclick='() => SetMode("money")'>
		Money
	</button>
</div>
@if (mode == "item")
{
	<div class="row g-2 mb-2">
		<div class="col-9">
			<input class="form-control clickable-input"
				   value="@(itemId == 0 ? "No item selected" : $"{selectedItemName} (ID {itemId})")"
				   @onclick="OpenPicker" readonly />
		</div>
		<div class="col-3">
			<input class="form-control" type="number" min="1" max="1000" @bind="quantity"
				   aria-label="Item quantity" />
		</div>
	</div>
}
else
{
	<div class="row g-2 mb-2">
		<div class="col-4">
			<div class="input-group">
				<input id="money-gold" class="form-control" type="number" min="0" @bind="gold" />
				<span class="input-group-text"><img class="money-input-coin" src="images/coins/gold.svg" alt="gold" /></span>
			</div>
		</div>
		<div class="col-4">
			<div class="input-group">
				<input id="money-silver" class="form-control" type="number" min="0" max="99" @bind="silver" />
				<span class="input-group-text"><img class="money-input-coin" src="images/coins/silver.svg" alt="silver" /></span>
			</div>
		</div>
		<div class="col-4">
			<div class="input-group">
				<input id="money-copper" class="form-control" type="number" min="0" max="99" @bind="copper" />
				<span class="input-group-text"><img class="money-input-coin" src="images/coins/copper.svg" alt="copper" /></span>
			</div>
		</div>
	</div>
}
<PlayerActionFeedback Results="Results" />
<PlayerActionToolFooter ShowResult="HasActionResult" Message="@ResultMessage" Succeeded="OperationSucceeded">
	@if (mode == "item")
	{
		<button class="btn btn-primary" disabled="@(!CanExecute || itemId == 0)"
				@onclick="GiveItemAsync">
			Give item
		</button>
		<button class="btn btn-outline-primary" disabled="@(!CanExecute || itemId == 0)"
				@onclick="MailAsync">
			Mail item
		</button>
	}
	else
	{
		<button class="btn btn-primary" disabled="@(!CanExecute)" @onclick="SendMoneyAsync">
			Send
		</button>
	}
</PlayerActionToolFooter>

<ItemPickerDialog IsOpen="@showPicker" TargetNames="@TargetNames"
                  InitialSearchText="@selectedItemName"
				  ItemSelected="SelectItem" Closed="ClosePicker" />

@code {
	private string mode = "item";
	private uint itemId;
	private int quantity = 1;
	private string? selectedItemName;
	private bool showPicker;
	private int gold;
	private int silver;
	private int copper;

	private IReadOnlyCollection<string> TargetNames =>
		Targets.Select(target => target.Name).ToArray();

	private void SetMode(string value) => mode = value;

	private void OpenPicker() => showPicker = true;
	private void ClosePicker() => showPicker = false;

	private void SelectItem(AdministrationItem item)
	{
		itemId = item.ItemId;
		selectedItemName = item.Name;
		showPicker = false;
	}

	private Task GiveItemAsync() => RunBatchAsync(
		"Give item",
		player => AccountsClient.GiveItemAsync(new(player, itemId, quantity)));

	private Task MailAsync() => RunBatchAsync(
		"Mail item",
		player => AccountsClient.MailItemAsync(new(
			player, itemId, quantity,
			"Server administration",
			"Items from the server administrator.")));

	private Task SendMoneyAsync() => RunBatchAsync(
		"Send money",
		player => AccountsClient.GiveMoneyAsync(new(player, gold, silver, copper)));
}
