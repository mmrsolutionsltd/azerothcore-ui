@inherits PlayerActionToolBase

<PlayerActionToolHeader Title="Give Reputation" Icon="🏵" />
<div class="mb-2">
	<input class="form-control clickable-input"
		   value="@(selectedFaction is null ? "No faction selected" : $"{selectedFaction.Name} (ID {selectedFaction.FactionId})")"
		   @onclick="OpenPicker" readonly />
</div>
<div class="mb-1">
	<input class="form-control" type="number" placeholder="Amount" @bind="amount" />
</div>
<p class="small text-muted mb-2">Positive grants reputation, negative removes it.</p>
<PlayerActionFeedback Results="Results" />
<PlayerActionToolFooter ShowResult="HasActionResult" Message="@ResultMessage" Succeeded="OperationSucceeded">
	<button class="btn btn-primary" disabled="@(!CanExecute || selectedFaction is null || amount == 0)"
			@onclick="GrantAsync">
		Grant reputation
	</button>
</PlayerActionToolFooter>

<ReputationFactionPickerDialog IsOpen="@showPicker" InitialSearchText="@selectedFaction?.Name"
                                FactionSelected="SelectFaction" Closed="ClosePicker" />

@code {
	private bool showPicker;
	private ReputationFaction? selectedFaction;
	private int amount;

	private void OpenPicker() => showPicker = true;
	private void ClosePicker() => showPicker = false;

	private void SelectFaction(ReputationFaction faction)
	{
		selectedFaction = faction;
		showPicker = false;
	}

	private async Task<AdministrationResult?> GrantOneAsync(string player)
	{
		if (selectedFaction is null) return null;
		var result = await AccountsClient.GiveReputationAsync(new(player, selectedFaction.FactionId, amount));
		return result is null ? null : new AdministrationResult(result.Success, result.Message);
	}

	private Task GrantAsync() => RunBatchAsync("Grant reputation", GrantOneAsync);
}
