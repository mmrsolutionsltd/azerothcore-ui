@inherits PlayerActionToolBase
@implements IDisposable

<PlayerActionToolHeader Title="Give Reputation" Icon="🏵" />
<div class="mb-2">
	<input class="form-control form-control-sm" placeholder="Search faction name or paste an id..."
		   value="@search" @oninput="SearchChangedAsync" />
</div>
@if (isSearching)
{
	<p class="small text-muted">Searching factions...</p>
}
else if (search.Length > 0 && factions.Count == 0)
{
	<p class="small text-muted">
		No matching factions were found. If this server's faction reference data isn't
		populated yet, enter a known faction id directly below instead.
	</p>
}
else if (factions.Count > 0)
{
	<ul class="list-group list-group-flush small mb-2 reputation-faction-results">
		@foreach (var faction in factions)
		{
			<li class="list-group-item list-group-item-action" role="button" @onclick="() => SelectFaction(faction)">
				@faction.Name <span class="text-muted">(ID @faction.FactionId)</span>
			</li>
		}
	</ul>
}
<div class="row g-2 mb-2">
	<div class="col-8">
		<input class="form-control" type="number" min="0" placeholder="Faction ID"
			   @bind="factionId" @bind:after="ClearSelectedFactionLabel" />
	</div>
	<div class="col-4">
		<input class="form-control" type="number" placeholder="Amount" @bind="amount" />
	</div>
</div>
@if (selectedFactionName is not null)
{
	<p class="small text-muted mb-2">Selected: <strong>@selectedFactionName</strong> (ID @factionId)</p>
}
<PlayerActionFeedback Results="Results" />
<PlayerActionToolFooter ShowResult="HasActionResult" Message="@ResultMessage" Succeeded="OperationSucceeded">
	<button class="btn btn-primary" disabled="@(!CanExecute || factionId == 0 || amount == 0)"
			@onclick="GrantAsync">
		Grant reputation
	</button>
</PlayerActionToolFooter>

@code {
	private string search = "";
	private IReadOnlyList<ReputationFaction> factions = [];
	private string? selectedFactionName;
	private uint factionId;
	private int amount;
	private bool isSearching;
	private CancellationTokenSource? debounce;

	private async Task SearchChangedAsync(ChangeEventArgs args)
	{
		search = args.Value?.ToString() ?? "";
		debounce?.Cancel();
		debounce?.Dispose();
		debounce = new();
		try { await Task.Delay(250, debounce.Token); await SearchAsync(); }
		catch (OperationCanceledException) { }
	}

	private async Task SearchAsync()
	{
		if (search.Length == 0) { factions = []; return; }
		isSearching = true;
		try
		{
			var result = await AccountsClient.GetReputationFactionsAsync(search);
			factions = result.Factions;
		}
		finally
		{
			isSearching = false;
		}
	}

	private void SelectFaction(ReputationFaction faction)
	{
		factionId = faction.FactionId;
		selectedFactionName = faction.Name;
		factions = [];
		search = faction.Name;
	}

	private void ClearSelectedFactionLabel() => selectedFactionName = null;

	private async Task<AdministrationResult?> GrantOneAsync(string player)
	{
		var result = await AccountsClient.GiveReputationAsync(new(player, factionId, amount));
		return result is null ? null : new AdministrationResult(result.Success, result.Message);
	}

	private Task GrantAsync() => RunBatchAsync("Grant reputation", GrantOneAsync);

	public void Dispose()
	{
		debounce?.Cancel();
		debounce?.Dispose();
	}
}
