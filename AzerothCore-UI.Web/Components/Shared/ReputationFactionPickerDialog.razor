@using AzerothCore_UI.Web.Models
@inject AzerothCore_UI.Web.Clients.AccountsApiClient AccountsClient
@inject AzerothCore_UI.Web.Services.RecentPickerSelectionStore RecentSelections
@inject IJSRuntime Javascript

@if (IsOpen)
{
    <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true"
         aria-labelledby="reputation-picker-title">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="reputation-picker-title">Choose a faction</h2>
                    <button type="button" class="btn-close" aria-label="Close"
                            @onclick="CloseAsync"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label" for="reputation-search">Faction name</label>
                        <input id="reputation-search" class="form-control" value="@search"
                               @oninput="SearchAsync" placeholder="Start typing a faction name…"
                               autocomplete="off" autofocus @ref="searchInput" />
                    </div>
                    <RecentPickerSelections TItem="ReputationFaction"
                                            Items="recentFactions"
                                            DisplayText="FactionDisplayText"
                                            Selected="SelectAsync" />
                    @if (errorMessage is not null)
                    {
                        <div class="alert alert-danger">@errorMessage</div>
                    }
                    @if (isLoading)
                    {
                        <p><em>Searching factions…</em></p>
                    }
                    else if (results.Factions.Count == 0)
                    {
                        <div class="alert alert-secondary">No matching factions were found.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr><th>Name</th><th>ID</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var faction in results.Factions)
                                    {
                                        <tr class="picker-result-row" tabindex="0" role="button"
                                            aria-label="Select @faction.Name"
                                            @onclick="() => SelectAsync(faction)"
                                            @onkeydown="args => SelectFromKeyboardAsync(args, faction)">
                                            <td class="fw-semibold">@faction.Name</td>
                                            <td>@faction.FactionId</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="modal-footer justify-content-between">
                    <span class="text-muted">@results.TotalCount matching factions</span>
                    <div>
                        <button class="btn btn-outline-secondary me-2"
                                disabled="@(isLoading || results.Page <= 1)"
                                @onclick="() => LoadAsync(results.Page - 1)">Previous</button>
                        <span class="me-2">Page @results.Page of @Math.Max(1, results.TotalPages)</span>
                        <button class="btn btn-outline-secondary"
                                disabled="@(isLoading || results.Page >= results.TotalPages)"
                                @onclick="() => LoadAsync(results.Page + 1)">Next</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}
