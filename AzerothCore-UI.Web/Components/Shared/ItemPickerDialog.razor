@using AzerothCore_UI.Web.Models
@inject AzerothCore_UI.Web.Clients.AccountsApiClient AccountsClient

@if (IsOpen)
{
    <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true"
         aria-labelledby="item-picker-title">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="item-picker-title">Choose an item</h2>
                    <button type="button" class="btn-close" aria-label="Close"
                            @onclick="CloseAsync"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2 mb-2">
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label" for="item-search">Item name</label>
                            <input id="item-search" class="form-control" value="@search"
                                   @oninput="SearchAsync" placeholder="Start typing an item name…"
                                   autocomplete="off" autofocus />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="item-category">Category</label>
                            <select id="item-category" class="form-select" @bind="category"
                                    @bind:after="FiltersChangedAsync">
                                <option value="all">All items</option>
                                <option value="weapons">Weapons</option>
                                <option value="armor">Armor</option>
                                <option value="potions">Potions</option>
                                <option value="elixirs">Elixirs</option>
                                <option value="flasks">Flasks</option>
                                <option value="scrolls">Scrolls</option>
                                <option value="food">Food &amp; drink</option>
                                <option value="bags">Bags</option>
                                <option value="gems">Gems</option>
                                <option value="reagents">Reagents</option>
                                <option value="trade-goods">Trade goods</option>
                                <option value="recipes">Recipes</option>
                                <option value="quest">Quest items</option>
                                <option value="glyphs">Glyphs</option>
                                <option value="miscellaneous">Miscellaneous</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label" for="item-quality">Quality</label>
                            <select id="item-quality" class="form-select" @bind="quality"
                                    @bind:after="FiltersChangedAsync">
                                <option value="">All</option>
                                <option value="0">Poor</option>
                                <option value="1">Common</option>
                                <option value="2">Uncommon</option>
                                <option value="3">Rare</option>
                                <option value="4">Epic</option>
                                <option value="5">Legendary</option>
                                <option value="6">Artifact</option>
                                <option value="7">Heirloom</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label">Item level range</label>
                            <div class="input-group">
                                <span class="input-group-text">≥</span>
                                <InputNumber class="form-control" @bind-Value="minimumItemLevel"
                                             @bind-Value:after="FiltersChangedAsync" min="0"
                                             placeholder="Min" aria-label="Minimum item level" />
                                <span class="input-group-text">≤</span>
                                <InputNumber class="form-control" @bind-Value="maximumItemLevel"
                                             @bind-Value:after="FiltersChangedAsync" min="0"
                                             placeholder="Max" aria-label="Maximum item level" />
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <label class="form-label">Required level range</label>
                            <div class="input-group">
                                <span class="input-group-text">≥</span>
                                <InputNumber class="form-control" @bind-Value="minimumRequiredLevel"
                                             @bind-Value:after="FiltersChangedAsync" min="0" max="255"
                                             placeholder="Min" aria-label="Minimum required level" />
                                <span class="input-group-text">≤</span>
                                <InputNumber class="form-control" @bind-Value="maximumRequiredLevel"
                                             @bind-Value:after="FiltersChangedAsync" min="0" max="255"
                                             placeholder="Max" aria-label="Maximum required level" />
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <label class="form-label" for="item-suitability">
                                Selected-character suitability
                            </label>
                            <select id="item-suitability" class="form-select" @bind="suitability"
                                    @bind:after="FiltersChangedAsync" disabled="@(TargetNames.Count == 0)">
                                <option value="all">Suitable for every target</option>
                                <option value="any">Suitable for at least one target</option>
                                <option value="off">Do not filter by targets</option>
                            </select>
                            <div class="form-text">
                                @(TargetNames.Count == 0
                                    ? "Select action targets to enable this filter."
                                    : $"{TargetNames.Count} action target(s) selected.")
                            </div>
                        </div>
                    </div>
                    @if (errorMessage is not null)
                    {
                        <div class="alert alert-danger">@errorMessage</div>
                    }
                    @if (isLoading)
                    {
                        <p><em>Searching items…</em></p>
                    }
                    else if (results.Items.Count == 0)
                    {
                        <div class="alert alert-secondary">No matching items were found.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>Name</th><th>ID</th><th>Quality</th>
                                        <th>Item level</th><th>Required level</th><th>Targets</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in results.Items)
                                    {
                                        <tr class="picker-result-row" tabindex="0" role="button"
                                            aria-label="Select @item.Name"
                                            @onclick="() => SelectAsync(item)"
                                            @onkeydown="args => SelectFromKeyboardAsync(args, item)">
                                            <td class="fw-semibold @QualityClass(item.Quality)">@item.Name</td>
                                            <td>@item.ItemId</td>
                                            <td>@QualityName(item.Quality)</td>
                                            <td>@item.ItemLevel</td>
                                            <td>@item.RequiredLevel</td>
                                            <td>
                                                @if (item.TargetCount == 0)
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                                else
                                                {
                                                    <span class="badge @(item.SuitableTargetCount == item.TargetCount
                                                        ? "text-bg-success"
                                                        : item.SuitableTargetCount > 0
                                                            ? "text-bg-warning"
                                                            : "text-bg-danger")"
                                                          title="Suitable: @string.Join(", ", item.SuitableTargetNames). Incompatible: @string.Join(", ", item.IncompatibleTargetNames)">
                                                        @item.SuitableTargetCount/@item.TargetCount suitable
                                                    </span>
                                                    @if (item.LikelyUpgradeTargetCount > 0)
                                                    {
                                                        <span class="badge text-bg-primary ms-1">
                                                            Upgrade for @item.LikelyUpgradeTargetCount
                                                        </span>
                                                    }
                                                    @if (item.Quality == 7)
                                                    {
                                                        <span class="badge text-bg-info ms-1">Heirloom</span>
                                                    }
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="modal-footer justify-content-between">
                    <span class="text-muted">@results.TotalCount matching items</span>
                    <div>
                        <button class="btn btn-outline-secondary me-2"
                                disabled="@(isLoading || results.Page <= 1)"
                                @onclick="() => LoadAsync(results.Page - 1)">Previous</button>
                        <span class="me-2">Page @results.Page of @Math.Max(1, results.TotalPages)</span>
                        <button class="btn btn-outline-secondary"
                                disabled="@(isLoading || results.Page >= results.TotalPages)"
                                @onclick="() => LoadAsync(results.Page + 1)">Next</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}
