<div class="col-md-6"><div class="form-check mt-4"><InputCheckbox class="form-check-input" Value="Value" ValueChanged="ValueChanged" ValueExpression="ValueExpression" /><label class="form-check-label">@Label</label></div></div>
@code { [Parameter] public string Label { get; set; } = ""; [Parameter] public bool Value { get; set; } [Parameter] public EventCallback<bool> ValueChanged { get; set; } [Parameter] public Expression<Func<bool>>? ValueExpression { get; set; } }
