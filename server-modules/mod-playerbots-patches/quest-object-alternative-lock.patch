@@ -142,2 +142,5 @@ bool OpenLootAction::DoLoot(LootObject& lootObject)
-    // This prevents dungeon chests like Tribunal Chest (Halls of Stone) from being ninja'd by the bots
-    if (go && go->HasFlag(GAMEOBJECT_FLAGS, GO_FLAG_INTERACT_COND))
+    // This prevents protected chests like Tribunal Chest (Halls of Stone)
+    // from being ninja'd by bots, while still allowing flagged quest objects
+    // such as Doom Weed when the bot needs their quest item.
+    if (go && go->HasFlag(GAMEOBJECT_FLAGS, GO_FLAG_INTERACT_COND)
+        && !LootObject::IsNeededQuestObject(bot, go))
@@ -214 +217 @@ bool OpenLootAction::CanOpenLock(LootObject& /*lootObject*/, SpellInfo const* sp
